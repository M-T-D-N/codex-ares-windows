+    for feature in [
+        Feature::StepModelSwitching,
+        Feature::ReasoningEffortOverride,
+    ] {
+        mutable.features.enable(feature).expect("test feature");
+    }
+    Arc::make_mut(
+        &mut mutable
+            .state
+            .get_mut()
+            .session_configuration
+            .original_config_do_not_use,
+    )
+    .features = mutable.features.clone();
+    let mut turn = session
+        .new_turn_with_default_settings("luna-native-test".to_string(), Default::default())
+        .await;
+    update_turn_settings_for_test(
+        Arc::get_mut(&mut turn).expect("unshared turn"),
+        |settings| {
+            settings.model_info = Arc::new(ModelInfo {
+                slug: base_model.to_string(),
+                use_responses_lite: true,
+                used_fallback_model_metadata: false,
+                supported_reasoning_levels: [
+                    ReasoningEffort::Medium,
+                    ReasoningEffort::High,
+                    ReasoningEffort::XHigh,
+                    ReasoningEffort::Max,
+                ]
+                .into_iter()
+                .map(|effort| ReasoningEffortPreset {
+                    effort,
+                    description: String::new(),
+                })
+                .collect(),
+                ..settings.model_info.as_ref().clone()
+            });
+            update_selected_settings_for_test(settings, |selected| {
+                selected.collaboration_mode.settings.model = selection.to_string();
+                selected.collaboration_mode.settings.reasoning_effort =
+                    Some(ReasoningEffort::Medium);
+            });
+        },
+    );
+    let finish = Arc::new(Notify::new());
+    session
+        .spawn_task(
+            Arc::clone(&turn),
+            Vec::new(),
+            HeldStepTask {
+                kind: TaskKind::Compact,
+                finish,
+            },
+        )
+        .await;
+    let mut controller = StepController::new(
+        &turn,
+        &[UserInput::Text {
+            text: "evaluate this task".into(),
+            text_elements: Vec::new(),
+        }],
+    );
+    controller.luna_continuous_mode = true;
+    (session, turn, controller)
+}
