+#[test]
+fn jev_resume_hint_uses_the_controller_launcher() {
+    let thread_id = ThreadId::from_string("123e4567-e89b-12d3-a456-426614174000").unwrap();
+    let info = AppExitInfo {
+        token_usage: TokenUsage::default(),
+        thread_id: Some(thread_id),
+        resume_hint: Some(ResumableThread {
+            thread_id,
+            thread_name: Some("My task".to_string()),
+        }),
+        disconnect_info: None,
+        update_action: None,
+        exit_reason: ExitReason::UserRequested,
+    };
+    insta::assert_snapshot!(info.format_exit_messages_with_program(/*color_enabled*/ false, "codex-jev").join("\n"), @r"
+To continue this session, run:
+  codex-jev resume 123e4567-e89b-12d3-a456-426614174000
+Or run codex-jev resume and select My task.
+");
+}
