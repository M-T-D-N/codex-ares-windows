+#[tokio::test]
+async fn pilot_http_default_policy_429_has_one_classified_terminal_without_retry()
+-> anyhow::Result<()> {
+    let server = MockServer::start().await;
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(ResponseTemplate::new(429).set_body_string("SENTINEL_PRIVATE_HTTP_BODY"))
+        .expect(1)
+        .mount(&server)
+        .await;
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    let client = pilot_http_client(&server, None);
+    let result = pilot_http_dispatch(
+        &client,
+        crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+    )
+    .await;
+    assert!(result.is_err());
+    let rows =
+        assert_one_pilot_http_terminal(&path, "response_failed", Some("transport_http"), Some(429));
+    assert_eq!(
+        rows.iter()
+            .filter(|row| row["type"] == "http_attempt_completed")
+            .count(),
+        1
+    );
+    assert_eq!(server.received_requests().await.unwrap().len(), 1);
+    Ok(())
+}
