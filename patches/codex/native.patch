+fn pilot_http_trace(path: &std::path::Path) -> Vec<serde_json::Value> {
+    std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect()
+}
+
+fn assert_one_pilot_http_terminal(
+    path: &std::path::Path,
+    kind: &str,
+    class: Option<&str>,
+    status: Option<u16>,
+) -> Vec<serde_json::Value> {
+    let rows = pilot_http_trace(path);
+    let terminals = rows
+        .iter()
+        .filter(|row| row.get("errorClass").is_some())
+        .collect::<Vec<_>>();
+    assert_eq!(terminals.len(), 1, "{rows:?}");
+    let terminal = terminals[0];
+    assert_eq!(terminal["type"], kind);
+    assert_eq!(terminal["errorClass"], json!(class));
+    assert_eq!(terminal["httpStatus"], json!(status));
+    assert_eq!(terminal["transport"], "responses_http");
+    assert!(terminal["elapsedMs"].is_u64());
+    assert_eq!(terminal["requestId"], rows[0]["requestId"]);
+    assert_eq!(terminal["requestOrdinal"], 1);
+    assert_eq!(terminal["threadId"], "thread");
+    assert_eq!(terminal["turnId"], "turn");
+    assert_eq!(terminal["step"], 1);
+    assert!(
+        !std::fs::read_to_string(path)
+            .unwrap()
+            .contains("SENTINEL_PRIVATE_HTTP_BODY")
+    );
+    rows
+}
