+#[tokio::test]
+async fn pilot_http_dispatch_cancellation_wins_over_pending_429_and_late_retry_response()
+-> anyhow::Result<()> {
+    for cancel_retry in [false, true] {
+        let server = MockServer::start().await;
+        let calls = Arc::new(AtomicUsize::new(0));
+        let responder_calls = Arc::clone(&calls);
+        Mock::given(method("POST"))
+            .and(path("/v1/responses"))
+            .respond_with(move |_: &wiremock::Request| {
+                let first = responder_calls.fetch_add(1, Ordering::SeqCst) == 0;
+                if first {
+                    let response =
+                        ResponseTemplate::new(429).set_body_string("SENTINEL_PRIVATE_HTTP_BODY");
+                    if cancel_retry {
+                        response
+                    } else {
+                        response.set_delay(Duration::from_millis(200))
+                    }
+                } else {
+                    pilot_completed_sse().set_delay(Duration::from_millis(200))
+                }
+            })
+            .mount(&server)
+            .await;
+        let dir = TempDir::new()?;
+        let path = dir.path().join("pilot.jsonl");
+        let client = pilot_http_client(&server, Some(1));
+        let mut dispatch = Box::pin(pilot_http_dispatch(
+            &client,
+            crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+        ));
+        let expected_calls = if cancel_retry { 2 } else { 1 };
+        tokio::select! {
+            _ = &mut dispatch => panic!("dispatch should still await the delayed response"),
+            result = tokio::time::timeout(Duration::from_secs(5), async {
+                while calls.load(Ordering::SeqCst) < expected_calls { tokio::time::sleep(Duration::from_millis(1)).await; }
+            }) => { result?; }
+        }
+        drop(dispatch);
+        // Wait beyond the mock's late response; no callback may create a second terminal.
+        tokio::time::sleep(Duration::from_millis(250)).await;
+        let rows = assert_one_pilot_http_terminal(
+            &path,
+            "response_cancelled",
+            Some("dispatch_future_dropped"),
+            if cancel_retry { Some(429) } else { None },
+        );
+        assert_eq!(rows.last().unwrap()["stage"], "http_before_stream");
+        assert_eq!(calls.load(Ordering::SeqCst), expected_calls);
+    }
+    Ok(())
+}
