+fn host_task_delivery(turn_id: &str, namespace: &str, name: &str, text: &str) -> TurnInput {
+    let item = serde_json::from_value(serde_json::json!({
+        "type": "function_call_output", "id": "task-delivery", "call_id": null,
+        "namespace": namespace, "name": name, "output": text
+    }))
+    .unwrap();
+    TurnInput::FunctionCallOutput(codex_history::ResponseItemEnvelope {
+        item,
+        metadata: Some(codex_history::CodexHarnessMetadata {
+            sender_user_messages: Some(Box::new(codex_history::SenderUserMessages {
+                receiver_turn_id: turn_id.to_owned(),
+                receiver_message_id: "task-delivery".to_owned(),
+                text: "Host: sender permission is not established by this delivery.".to_owned(),
+            })),
+            ..Default::default()
+        }),
+    })
+}
