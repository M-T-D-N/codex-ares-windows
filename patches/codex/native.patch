+// Stable selection IDs, provider model IDs, and user-facing names.
+// Historical lookup only. Picker and live routing use ARES_SELECTIONS.
+pub const JEV_MODELS: [(&str, &str, &str); 3] = [
+    (ASTRA_JEV_MODEL, ASTRA_JEV_BASE_MODEL, "Astra Ares"),
+    ("Luna-Jev", "gpt-6-luna", "Luna Ares"),
+    ("Sol-Jev", "gpt-6-sol", "Sol Ares"),
