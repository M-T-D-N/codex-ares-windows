+++ b/codex-rs/thread-store/src/local/thread_history_projection_reader.rs
@@ -0,0 +1,100 @@
+//! Retained recorder reader. Test synchronization is local to one store and thread.
+
+use std::fs::File;
+use std::io::{self, Read, Seek, SeekFrom};
+use std::sync::Arc;
+use tokio::sync::OwnedMutexGuard;
+
+pub(in crate::local) struct RetainedProjectionReader {
+    // Close the duplicated handle before releasing the shared cursor's writer ownership.
+    file: File,
+    _writer_guard: Arc<OwnedMutexGuard<()>>,
+    #[cfg(test)]
+    pause: Option<Arc<ProjectionReadPause>>,
+}
+
+impl RetainedProjectionReader {
+    pub(in crate::local) fn new(
+        file: File,
+        writer_guard: Arc<OwnedMutexGuard<()>>,
+        #[cfg(test)] pause: Option<Arc<ProjectionReadPause>>,
+    ) -> Self {
+        Self {
+            file,
+            _writer_guard: writer_guard,
+            #[cfg(test)]
+            pause,
+        }
+    }
+}
+
+impl Read for RetainedProjectionReader {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        #[cfg(test)]
+        if let Some(pause) = &self.pause {
+            pause.before_read()?;
+        }
+        self.file.read(buffer)
+    }
+}
+
+impl Seek for RetainedProjectionReader {
+    fn seek(&mut self, position: SeekFrom) -> io::Result<u64> {
+        self.file.seek(position)
+    }
+}
+
+#[cfg(test)]
+pub(in crate::local) struct ProjectionReadPause {
+    pub(in crate::local) thread_id: codex_protocol::ThreadId,
+    pub(in crate::local) entered: tokio::sync::Notify,
+    armed: std::sync::atomic::AtomicBool,
+    released: std::sync::Mutex<bool>,
+    wake: std::sync::Condvar,
+}
+
+#[cfg(test)]
+impl ProjectionReadPause {
+    pub(in crate::local) fn new(thread_id: codex_protocol::ThreadId) -> Self {
+        Self {
+            thread_id,
+            entered: tokio::sync::Notify::new(),
+            armed: std::sync::atomic::AtomicBool::new(false),
+            released: std::sync::Mutex::new(false),
+            wake: std::sync::Condvar::new(),
+        }
+    }
+
+    pub(in crate::local) fn arm(&self) {
+        self.armed.store(true, std::sync::atomic::Ordering::SeqCst);
+    }
+
+    pub(in crate::local) fn release(&self) {
+        *self.released.lock().expect("projection pause state") = true;
+        self.wake.notify_all();
+    }
+
+    fn before_read(&self) -> io::Result<()> {
+        if !self.armed.swap(false, std::sync::atomic::Ordering::SeqCst) {
+            return Ok(());
+        }
+        self.entered.notify_one();
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+        let mut released = self.released.lock().expect("projection pause state");
+        while !*released {
+            let remaining = deadline.saturating_duration_since(std::time::Instant::now());
+            if remaining.is_zero() {
+                return Err(io::Error::new(
+                    io::ErrorKind::TimedOut,
+                    "projection test pause expired",
+                ));
+            }
+            released = self
+                .wake
+                .wait_timeout(released, remaining)
+                .expect("projection pause wait")
+                .0;
+        }
+        Ok(())
+    }
+}
