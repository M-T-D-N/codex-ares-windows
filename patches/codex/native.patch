+#[cfg(windows)]
+#[tokio::test]
+async fn luna_invalid_epoch_disconnects_then_reconnects_with_same_owner_and_next_step() {
+    let (session, turn, mut controller) = luna_fixture().await;
+    let mut server = attached_bridge(&mut controller).await;
+    let first_epoch = controller.connection_epoch.expect("first epoch");
+    let first = tokio::spawn(async move {
+        let checkpoint = read_bridge_frame(&mut server).await;
+        let mut reply = decision_for(&checkpoint, ReasoningEffort::Max);
+        reply["connectionEpoch"] = serde_json::json!(uuid::Uuid::new_v4());
+        write_bridge_frame(&mut server, reply).await;
+        checkpoint
+    });
+    let fallback = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("invalid epoch degrades")
+        .expect("supported fallback");
+    let first_checkpoint = first.await.expect("first bridge task");
+    assert_eq!(fallback.effort, ReasoningEffort::High);
+    assert!(controller.connection.is_none());
+    controller.retry_after = None; // deterministic half-open after the transport cooldown
+
+    let mut server = attached_bridge(&mut controller).await;
+    let second_epoch = controller.connection_epoch.expect("second epoch");
+    let second = tokio::spawn(async move {
+        let checkpoint = read_bridge_frame(&mut server).await;
+        write_bridge_frame(
+            &mut server,
+            decision_for(&checkpoint, ReasoningEffort::Medium),
+        )
+        .await;
+        checkpoint
+    });
+    let fresh = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("fresh judgment")
+        .expect("decision published");
+    let second_checkpoint = second.await.expect("second bridge task");
+    assert_ne!(first_epoch, second_epoch);
+    assert_eq!(
+        first_checkpoint["adviceBasis"]["ownerId"],
+        second_checkpoint["adviceBasis"]["ownerId"]
+    );
+    assert_eq!(first_checkpoint["step"], 1);
+    assert_eq!(second_checkpoint["step"], 2);
+    assert_eq!(fresh.effort, ReasoningEffort::Medium);
+    assert_eq!(controller.failure_streak, 0);
+
+    // The owner may end after a valid checkpoint but before native publication.
+    let mut server = attached_bridge(&mut controller).await;
+    let (seen_checkpoint, checkpoint_seen) = tokio::sync::oneshot::channel();
+    let (release_reply, reply_released) = tokio::sync::oneshot::channel::<()>();
+    let final_bridge = tokio::spawn(async move {
+        let checkpoint = read_bridge_frame(&mut server).await;
+        seen_checkpoint.send(()).expect("checkpoint observed");
+        reply_released.await.expect("release reply");
+        write_bridge_frame(&mut server, decision_for(&checkpoint, ReasoningEffort::Max)).await;
+    });
+    let evaluation_session = Arc::clone(&session);
+    let evaluation_turn = Arc::clone(&turn);
+    let evaluation = tokio::spawn(async move {
+        controller
+            .before_sampling_luna(&evaluation_session, &evaluation_turn)
+            .await
+            .is_err()
+    });
+    checkpoint_seen.await.expect("checkpoint reached bridge");
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+    release_reply.send(()).expect("release bridge reply");
+    assert!(evaluation.await.expect("native evaluation task"));
+    final_bridge.await.expect("final bridge task");
+}
