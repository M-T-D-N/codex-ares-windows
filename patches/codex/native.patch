+#[serial_test::serial]
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn pilot_astra_assistant_only_steps_dispatch_high_xhigh_high() -> anyhow::Result<()> {
+    use std::ffi::OsStr;
+    use std::ffi::OsString;
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+    use tokio::net::TcpListener;
+    use tokio::net::TcpStream;
+
+    // Windows-only, one nextest process: restore every opt-in variable on exit.
+    struct EnvGuard {
+        key: &'static str,
+        previous: Option<OsString>,
+    }
+    impl EnvGuard {
+        fn set(key: &'static str, value: &OsStr) -> Self {
+            let previous = std::env::var_os(key);
+            unsafe { std::env::set_var(key, value) };
+            Self { key, previous }
+        }
+    }
+    impl Drop for EnvGuard {
+        fn drop(&mut self) {
+            unsafe {
+                match &self.previous {
+                    Some(value) => std::env::set_var(self.key, value),
+                    None => std::env::remove_var(self.key),
+                }
+            }
+        }
+    }
+    async fn read_frame(stream: &mut TcpStream, max: usize) -> anyhow::Result<Value> {
+        let length = stream.read_u32().await? as usize;
+        anyhow::ensure!(length > 0 && length <= max, "invalid sidecar frame length");
+        let mut bytes = vec![0; length];
+        stream.read_exact(&mut bytes).await?;
+        Ok(serde_json::from_slice(&bytes)?)
+    }
+    async fn write_frame(stream: &mut TcpStream, value: &Value) -> anyhow::Result<()> {
+        let bytes = serde_json::to_vec(value)?;
+        stream.write_u32(bytes.len() as u32).await?;
+        stream.write_all(&bytes).await?;
+        Ok(())
+    }
+
+    skip_if_no_network!(Ok(()));
+    let listener = TcpListener::bind(("127.0.0.1", 0)).await?;
+    let endpoint = listener.local_addr()?.to_string();
+    let token = "A".repeat(43);
+    let marker = format!("[ARES-PILOT:{}]", uuid::Uuid::new_v4());
+    let trace_dir = tempfile::tempdir()?;
+    let trace_path = trace_dir.path().join("pilot.jsonl");
+    let _endpoint = EnvGuard::set("CODEX_STEP_CONTROLLER_TCP", OsStr::new(&endpoint));
+    let _token = EnvGuard::set("CODEX_STEP_CONTROLLER_TOKEN", OsStr::new(&token));
+    let _marker = EnvGuard::set("CODEX_STEP_CONTROLLER_PILOT_MARKER", OsStr::new(&marker));
+    let _trace = EnvGuard::set("CODEX_STEP_CONTROLLER_TRACE_PATH", trace_path.as_os_str());
+    let sidecar_token = token.clone();
+    let sidecar = tokio_util::task::AbortOnDropHandle::new(tokio::spawn(async move {
+        let (mut stream, _) = listener.accept().await?;
+        let auth = read_frame(&mut stream, 4_096).await?;
+        anyhow::ensure!(
+            auth.as_object().is_some_and(|o| o.len() == 2)
+                && auth["type"] == "authenticate"
+                && auth["token"] == sidecar_token,
+            "invalid authentication preface"
+        );
+        write_frame(&mut stream, &serde_json::json!({"type":"authenticated"})).await?;
+        let efforts = ["high", "xhigh", "high"];
+        let prior = ["high", "high", "xhigh"];
+        let mut identity: Option<(String, String)> = None;
+        for (index, effort) in efforts.iter().enumerate() {
+            let step = index as u64 + 1;
+            let checkpoint = read_frame(&mut stream, 2_000_000).await?;
+            anyhow::ensure!(
+                checkpoint["type"] == "checkpoint"
+                    && checkpoint["protocol"] == 3
+                    && checkpoint["step"] == step
+                    && checkpoint["model"] == "gpt-6-astra"
+                    && checkpoint["currentEffort"] == prior[index],
+                "unexpected checkpoint scalar fields"
+            );
+            anyhow::ensure!(
+                checkpoint["supportedEfforts"]
+                    .as_array()
+                    .is_some_and(|levels| levels
+                        .iter()
+                        .any(|level| level.as_str() == Some(*effort))),
+                "unsupported selected effort"
+            );
+            let thread_id = checkpoint["threadId"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("missing thread ID"))?
+                .to_owned();
+            let turn_id = checkpoint["turnId"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("missing turn ID"))?
+                .to_owned();
+            if let Some(previous) = &identity {
+                anyhow::ensure!(
+                    previous == &(thread_id.clone(), turn_id.clone()),
+                    "turn changed"
+                );
+            } else {
+                identity = Some((thread_id.clone(), turn_id.clone()));
+            }
+            write_frame(
+                &mut stream,
+                &serde_json::json!({"protocol":3,"type":"decision",
+                "threadId":thread_id,"turnId":turn_id,"step":step,"effort":effort,
+                "leaseSteps":1,"evaluatorMs":0}),
+            )
+            .await?;
+            let receipt = read_frame(&mut stream, 4_096).await?;
+            anyhow::ensure!(
+                receipt["type"] == "applied"
+                    && receipt["protocol"] == 3
+                    && receipt["threadId"] == thread_id
+                    && receipt["turnId"] == turn_id
+                    && receipt["step"] == step
+                    && receipt["effort"] == *effort
+                    && receipt["confirmation"] == "native_step_context_captured",
+                "missing native capture receipt"
+            );
+            write_frame(
+                &mut stream,
+                &serde_json::json!({"protocol":3,"type":"recorded","step":step}),
+            )
+            .await?;
+        }
+        Ok::<_, anyhow::Error>(identity.expect("three checkpoints"))
+    }));
+    let server = responses::start_mock_server().await;
+    let response_ids = ["pilot-1", "pilot-2", "pilot-3"];
+    let sequence = response_ids
+        .iter()
+        .enumerate()
+        .map(|(index, id)| {
+            let mut completion = responses::ev_completed(id);
+            if index < 2 {
+                completion["response"]["end_turn"] = serde_json::json!(false);
+            }
+            responses::sse(vec![
+                responses::ev_response_created(id),
