+
+fn build_configuration_update_request(
+    prompt: &Prompt,
+    enabled: bool,
+    supported: bool,
+    openai: bool,
+) -> codex_protocol::error::Result<super::ResponsesApiRequest> {
+    let mut client = test_model_client(SessionSource::Cli);
+    let state = Arc::get_mut(&mut client.state).unwrap();
+    state.reasoning_effort_override_enabled = enabled;
+    if openai {
+        state.provider = create_model_provider(
+            ModelProviderInfo::create_openai_provider(Some("https://api.openai.com/v1".into())),
+            None,
+        );
+    }
+    let mut model = test_model_info();
+    model.supports_reasoning_effort_updates = supported;
+    let metadata = test_responses_metadata_for_client(
+        &client,
+        None,
+        "window".into(),
+        None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    let request = client.build_responses_request(
+        prompt,
+        &model,
+        Some(ReasoningEffort::Medium),
+        codex_protocol::config_types::ReasoningSummary::None,
+        None,
+        &metadata,
+        true,
+    )?;
+    assert_eq!(client.state.reasoning_effort_override_enabled, enabled);
+    assert_eq!(model.supports_reasoning_effort_updates, supported);
+    assert_eq!(
+        request.reasoning.as_ref().unwrap().effort,
+        Some(ReasoningEffort::Medium)
+    );
+    Ok(request)
+}
