+#[tokio::test]
+async fn luna_disconnect_falls_back_to_supported_high_and_manual_edit_wins() {
+    let (session, turn, mut controller) = luna_fixture().await;
+    let mut server = attached_bridge(&mut controller).await;
+    let bridge = tokio::spawn(async move {
+        let checkpoint = read_bridge_frame(&mut server).await;
+        assert_eq!(checkpoint["protocol"], 4);
+        assert_eq!(checkpoint["project"]["rootUser"], true);
+        drop(server);
+    });
+    let applied = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("transport loss is evaluator availability")
+        .expect("supported High fallback");
+    bridge.await.expect("bridge task");
+    assert_eq!(applied.effort, ReasoningEffort::High);
+    assert!(!applied.from_bridge);
+    assert!(controller.connection.is_none());
+    assert_eq!(controller.failure_streak, 1);
+    assert!(controller.retry_after.is_some());
+    assert_eq!(controller.sequence, 1);
+    assert!(controller.take_capture_fresh());
+
+    controller.retry_after = None;
+    controller.exchange_timeout = Duration::from_millis(20);
+    let mut server = attached_bridge(&mut controller).await;
+    let (release, held) = tokio::sync::oneshot::channel::<()>();
+    let watchdog_bridge = tokio::spawn(async move {
+        read_bridge_frame(&mut server).await;
+        let _ = held.await; // keep the TCP stream open past the native watchdog
+    });
+    let watchdog_fallback = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("watchdog expiration is evaluator availability")
+        .expect("supported High fallback");
+    assert_eq!(watchdog_fallback.effort, ReasoningEffort::High);
+    assert_eq!(controller.failure_streak, 2);
+    assert_eq!(controller.sequence, 2);
+    let _ = release.send(());
+    watchdog_bridge.await.expect("watchdog bridge task");
+
+    let changed = session
+        .apply_turn_settings(
+            &turn.sub_id,
+            TurnSettingsUpdate {
+                effort: Some(Some(ReasoningEffort::High)),
+                ..Default::default()
+            },
+        )
+        .await;
+    assert!(matches!(changed, TurnSettingsUpdateOutcome::Applied));
+    assert!(
+        controller
+            .before_sampling_luna(&session, &turn)
+            .await
+            .expect("manual owner is safe")
+            .is_none()
+    );
+    assert_eq!(controller.sequence, 2);
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+    assert!(
+        controller
+            .before_sampling_luna(&session, &turn)
+            .await
+            .is_err()
+    );
+}
