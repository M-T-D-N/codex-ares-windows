diff --git a/codex-rs/core/src/tools/handlers/ares_request_effort.rs b/codex-rs/core/src/tools/handlers/ares_request_effort.rs
new file mode 100644
index 0000000..ff2019e
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/ares_request_effort.rs
@@ -0,0 +1,93 @@
+//! The bound Main's one-shot request for its next sampling generation.
+
+use std::collections::BTreeMap;
+
+use crate::function_tool::FunctionCallError;
+use crate::tools::context::FunctionToolOutput;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::context::boxed_tool_output;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_tools::JsonSchema;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+
+pub(crate) const TOOL_NAME: &str = "ares_request_effort";
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Arguments {
+    effort: ReasoningEffort,
+    reason: String,
+}
+
+pub(crate) struct AresRequestEffortHandler;
+
+impl ToolExecutor<ToolInvocation> for AresRequestEffortHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::plain(TOOL_NAME)
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Function(ResponsesApiTool {
+            name: TOOL_NAME.to_string(),
+            description: "Queue a supported reasoning effort for this same Main's immediately next generation. Use only when your current task needs a different effort; give a short public reason. This does not change the model, permissions, user settings, or any generation already started. Call separately from other tools; do not request user approval solely for this allowed effort change.".to_string(),
+            strict: false,
+            defer_loading: None,
+            parameters: JsonSchema::object(
+                BTreeMap::from([
+                    (
+                        "effort".to_string(),
+                        JsonSchema::string(Some("One of medium, high, xhigh, max, subject to the current Astra catalog.".to_string())),
+                    ),
+                    (
+                        "reason".to_string(),
+                        JsonSchema::string(Some("Brief public reason, at most 300 characters. Do not provide hidden reasoning.".to_string())),
+                    ),
+                ]),
+                Some(vec!["effort".to_string(), "reason".to_string()]),
+                Some(false.into()),
+            ),
+            output_schema: None,
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "ares_request_effort requires function arguments".to_string(),
+                ));
+            };
+            let Arguments { effort, reason } =
+                crate::tools::handlers::parse_arguments::<Arguments>(arguments)?;
+            invocation
+                .session
+                .queue_jev_main_effort(
+                    invocation.turn.as_ref(),
+                    effort,
+                    reason,
+                    invocation.call_id.clone(),
+                )
+                .await
+                .map_err(FunctionCallError::RespondToModel)?;
+            Ok(boxed_tool_output(FunctionToolOutput::from_text(
+                "queued_for_next_generation".to_string(),
+                Some(true),
+            )))
+        })
+    }
+}
+
+impl CoreToolRuntime for AresRequestEffortHandler {
+    fn is_builtin_control_tool(&self) -> bool {
+        true
+    }
+}
diff --git a/codex-rs/core/src/tools/handlers/mcp_restart.rs b/codex-rs/core/src/tools/handlers/mcp_restart.rs
new file mode 100644
index 0000000..7ad7893
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/mcp_restart.rs
@@ -0,0 +1,290 @@
+use crate::function_tool::FunctionCallError;
+use crate::session::session::Session;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_tools::JsonSchema;
+use codex_tools::JsonToolOutput;
+use codex_tools::ResponsesApiNamespace;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RestartArguments {}
+
+/// Native control path: remains callable when no MCP tool has loaded.
+pub struct McpRestartHandler;
+
+pub(crate) async fn restart_current_thread(
+    session: &Arc<Session>,
+) -> Result<Value, FunctionCallError> {
+    session.services.mcp_runtime.reconnect_on_next_refresh();
+    session.request_mcp_runtime_refresh();
+    session.refresh_mcp_if_dirty().await;
+    let config = session
+        .services
+        .mcp_runtime
+        .current_config()
+        .ok_or_else(|| {
+            FunctionCallError::RespondToModel(
+                "MCP refresh did not publish a configuration".to_string(),
+            )
+        })?;
+    let servers = codex_mcp::configured_mcp_servers(&config);
+    for name in servers.keys() {
+        session
+            .services
+            .mcp_runtime
+            .wait_for_server_startup(name)
+            .await;
+    }
+    let statuses = session
+        .services
+        .mcp_runtime
+        .connection_statuses(&config)
+        .await;
+    // Inspect a live binding, never a cached discovery-only catalog.
+    let binding = session
+        .services
+        .mcp_runtime
+        .current_binding()
+        .await
+        .ok_or_else(|| {
+            FunctionCallError::RespondToModel(
+                "MCP refresh did not publish a live binding".to_string(),
+            )
+        })?;
+    let mut results = BTreeMap::new();
+    let mut startup_succeeded = true;
+    for (name, status) in statuses {
+        startup_succeeded &= matches!(
+            status,
+            codex_protocol::mcp::McpServerConnectionStatus::Connected
+                | codex_protocol::mcp::McpServerConnectionStatus::Disabled
+        );
+        let tool_count = binding
+            .tools()
+            .iter()
+            .filter(|t| t.server_name == name)
+            .count();
+        results.insert(name, json!({"status": status, "tool_count": tool_count}));
+    }
+    Ok(json!({"scope": "current_thread", "servers": results,
+        "configuration_reloaded_from_disk": false, "startup_succeeded": startup_succeeded,
+        "verification": "MCP startup and live catalog only; call the required tool next"}))
+}
+
+impl ToolExecutor<ToolInvocation> for McpRestartHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::namespaced("mcp_control", "restart")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "mcp_control".to_string(),
+            description: "Recover this Codex thread's MCP connections without restarting Codex or the browser.".to_string(),
+            tools: vec![ResponsesApiNamespaceTool::Function(ResponsesApiTool {
+                name: "restart".to_string(),
+                description: "Explicitly reconnect the configured MCP clients of the current thread. Available even when MCP tools are missing. Keeps approved configuration and disabled servers, other threads, browser windows and tabs unchanged. Does not replay actions or reload configuration from disk. Never run in parallel with tool calls. Returns startup statuses, not website verification; follow with an actual required MCP tool call.".to_string(),
+                strict: false,
+                defer_loading: None,
+                parameters: JsonSchema::object(BTreeMap::new(), None, Some(false.into())),
+                output_schema: None,
+            })],
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "Unsupported MCP restart payload".to_string(),
+                ));
+            };
+            serde_json::from_str::<RestartArguments>(arguments).map_err(|e| {
+                FunctionCallError::RespondToModel(format!("Invalid MCP restart arguments: {e}"))
+            })?;
+            let result = tokio::select! {
+                _ = invocation.cancellation_token.cancelled() => {
+                    return Err(FunctionCallError::RespondToModel("MCP reconnect interrupted; inspect connection state before retry".to_string()));
+                }
+                result = tokio::time::timeout(Duration::from_secs(60), restart_current_thread(&invocation.session)) => {
+                    result.map_err(|_| FunctionCallError::RespondToModel("MCP reconnect exceeded 60 seconds; refresh may have partially completed. Inspect server status before retry".to_string()))??
+                }
+            };
+            Ok(Box::new(JsonToolOutput::with_success(
+                result.clone(),
+                result["startup_succeeded"].as_bool(),
+            )) as Box<dyn codex_tools::ToolOutput>)
+        })
+    }
+}
+
+impl CoreToolRuntime for McpRestartHandler {
+    fn is_builtin_control_tool(&self) -> bool {
+        true
+    }
+}
