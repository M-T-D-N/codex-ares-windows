diff --git a/codex-rs/core/src/session/jev_main.rs b/codex-rs/core/src/session/jev_main.rs
new file mode 100644
index 0000000000000000000000000000000000000000..efc0e6eace866e2b6c36bc20cac0bb085db282a7
--- /dev/null
+++ b/codex-rs/core/src/session/jev_main.rs
@@ -0,0 +1,188 @@
+//! Exact, host-owned opt-in for the Jev-to-current-Main route.
+
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+
+use codex_protocol::ThreadId;
+use codex_protocol::openai_models::AresRoute;
+use codex_protocol::openai_models::AresSelection;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_protocol::openai_models::ares_selection;
+use codex_protocol::protocol::SessionSource;
+
+use super::session::Session;
+use super::step_settings::ResolvedStepSettings;
+use super::turn_context::TurnContext;
+
+// Public packaging: opt-out is user supplied; no developer conversation is embedded.
+
+pub(crate) fn eligible_ares_root(
+    parent: Option<ThreadId>,
+    source: &SessionSource,
+    evaluator_process: bool,
+) -> bool {
+    parent.is_none()
+        && !source.is_non_root_agent()
+        && !evaluator_process
+        && matches!(
+            source,
+            SessionSource::Cli | SessionSource::VSCode | SessionSource::Exec | SessionSource::Mcp
+        )
+}
+
+pub(crate) struct JevMainControl {
+    pub(crate) thread_id: String,
+    pub(crate) owner_id: uuid::Uuid,
+    pub(crate) selection: AresSelection,
+    pending: Mutex<Option<QueuedMainEffort>>,
+    last_step: AtomicU64,
+}
+
+pub(crate) struct QueuedMainEffort {
+    pub(crate) selection: AresSelection,
+    pub(crate) effort: ReasoningEffort,
+    pub(crate) reason: String,
+    pub(crate) call_id: String,
+    pub(crate) accepted_input_revision: u64,
+    pub(crate) settings_revision: u64,
+    pub(crate) window_id: uuid::Uuid,
+    pub(crate) settings: Arc<ResolvedStepSettings>,
+}
+
+impl JevMainControl {
+    pub(crate) fn for_new_turn(
+        thread_id: ThreadId,
+        parent_thread_id: Option<ThreadId>,
+        session_source: &SessionSource,
+        selection: &str,
+        adaptive_enabled: bool,
+        advice_mode: Option<&str>,
+        evaluator_process: bool,
+    ) -> Option<Self> {
+        let thread_id = thread_id.to_string();
+        let selection = ares_selection(selection)?;
+        let eligible = adaptive_enabled
+            && advice_mode == Some("luna-continuous-1")
+            && std::env::var("CODEX_ARES_EXCLUDED_THREAD").ok().as_deref()
+                != Some(thread_id.as_str())
+            && selection.route == AresRoute::JevMain
+            && eligible_ares_root(parent_thread_id, session_source, evaluator_process);
+        if !eligible {
+            return None;
+        }
+        Some(Self {
+            thread_id,
+            owner_id: uuid::Uuid::now_v7(),
+            selection,
+            pending: Mutex::new(None),
+            last_step: AtomicU64::new(0),
+        })
+    }
+
+    pub(crate) fn selection_is_current(&self, settings: &ResolvedStepSettings) -> bool {
+        settings.selected_collaboration_mode().model() == self.selection.alias
+            && settings.model_info.slug == self.selection.base_model
+            && settings.model_info.origin != codex_protocol::openai_models::ModelOrigin::Synthetic
+            && settings.model_info.use_responses_lite
+            && settings
+                .model_info
+                .supported_reasoning_levels
+                .iter()
+                .any(|preset| {
+                    matches!(
+                        &preset.effort,
+                        ReasoningEffort::Medium
+                            | ReasoningEffort::High
+                            | ReasoningEffort::XHigh
+                            | ReasoningEffort::Max
+                    )
+                })
+    }
+
+    pub(crate) fn take_pending(&self) -> Option<QueuedMainEffort> {
+        self.pending.lock().ok()?.take()
+    }
+
+    pub(crate) fn set_step(&self, step: u64) {
+        self.last_step.store(step, Ordering::Release);
+    }
+}
+
+impl Session {
+    pub(crate) async fn queue_jev_main_effort(
+        &self,
+        turn: &TurnContext,
+        effort: ReasoningEffort,
+        reason: String,
+        call_id: String,
+    ) -> Result<(), String> {
+        let control = turn
+            .extension_data
+            .get::<JevMainControl>()
+            .ok_or("This turn is not bound to the Jev Main route")?;
+        if control.thread_id != self.thread_id().to_string() {
+            return Err("Jev Main turn ownership changed".to_string());
+        }
+        if !matches!(
+            effort,
+            ReasoningEffort::Medium
+                | ReasoningEffort::High
+                | ReasoningEffort::XHigh
+                | ReasoningEffort::Max
+        ) {
+            return Err("Unsupported effort for this control tool".to_string());
+        }
+        let reason = reason.trim();
+        if reason.is_empty() || reason.chars().count() > 300 || reason.chars().any(char::is_control)
+        {
+            return Err("Reason must be 1–300 public characters without controls".to_string());
+        }
+        let snapshot = self
+            .snapshot_step_decision(turn, "", "")
+            .await
+            .ok_or("The active turn changed before the effort request")?;
+        if snapshot.guard.external_settings_revision != 0 {
+            return Err("Manual settings own this turn".to_string());
+        }
+        let settings = &snapshot.guard.settings;
+        if !control.selection_is_current(settings)
+            || !settings
+                .model_info
+                .supported_reasoning_levels
+                .iter()
+                .any(|preset| preset.effort == effort)
+        {
+            return Err("Current Jev Main model settings do not support that effort".to_string());
+        }
+        let mut pending = control
+            .pending
+            .lock()
+            .map_err(|_| "Effort request state is unavailable")?;
+        if pending.is_some() {
+            return Err("An effort request is already queued for the next generation".to_string());
+        }
+        *pending = Some(QueuedMainEffort {
+            selection: control.selection,
+            effort: effort.clone(),
+            reason: reason.to_string(),
+            call_id: call_id.clone(),
+            accepted_input_revision: snapshot.guard.accepted_input_revision,
+            settings_revision: snapshot.guard.external_settings_revision,
+            window_id: snapshot.guard.window_ids.window_id,
+            settings: Arc::clone(settings),
+        });
+        let next_step = control.last_step.load(Ordering::Acquire) + 1;
+        crate::pilot_trace::PilotGeneration::record_stage_with_details(
+            control.thread_id.clone(),
+            turn.sub_id.clone(),
+            next_step,
+            Some(effort.to_string()),
+            "native_main_request_queued",
+            Some(&format!("callId={call_id}; reason={reason}")),
+            None,
+        );
+        Ok(())
+    }
+}
