+// Saved Jev/Main selections resolve to their original plain models. Keep them
+// outside JEV_MODELS, which also enables the older evaluator bridge.
+const RETIRED_JEV_MAIN_MODELS: [(&str, &str, &str); 2] = [
+    (
+        ASTRA_JEV_MAIN_MODEL,
+        ASTRA_JEV_BASE_MODEL,
+        ASTRA_JEV_BASE_MODEL,
+    ),
+    (SOL_JEV_MAIN_MODEL, "gpt-6-sol", "gpt-6-sol"),
+];
+
+pub fn jev_base_model(selection: &str) -> Option<&'static str> {
+    ares_selection(selection)
+        .map(|entry| entry.base_model)
+        .or_else(|| {
+            JEV_MODELS
+                .iter()
+                .chain(RETIRED_JEV_MAIN_MODELS.iter())
+                .find_map(|(alias, base, _)| (*alias == selection).then_some(*base))
+        })
+}
+
+pub fn jev_display_name(selection: &str) -> Option<&'static str> {
+    ares_selection(selection)
+        .map(|entry| entry.display_name)
+        .or_else(|| {
+            JEV_MODELS
+                .iter()
+                .chain(RETIRED_JEV_MAIN_MODELS.iter())
+                .find_map(|(alias, _, name)| (*alias == selection).then_some(*name))
+        })
+}
