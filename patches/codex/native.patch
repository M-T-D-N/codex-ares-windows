+async fn ares_selection_dispatches_its_own_base_model(
+    selection: &str,
+    base_model: &str,
+) -> anyhow::Result<()> {
+    let server = responses::start_mock_server().await;
+    let mock = responses::mount_sse_once(
+        &server,
+        responses::sse(vec![responses::ev_completed("ares-dispatch")]),
+    )
+    .await;
+    let selection = selection.to_owned();
+    let test = test_codex()
+        .with_model_info_override(base_model, |model| {
+            model.use_responses_lite = true;
+            model.comp_hash = None;
+            model.supports_reasoning_effort_updates = true;
+        })
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(move |config| {
+            config.model = Some(selection);
+            config.model_reasoning_effort = Some(ReasoningEffort::XHigh);
+            config.model_provider.supports_websockets = false;
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_text_turn("Keep the selected base model.")
+        .await?;
+    let request = mock.single_request();
+    assert_eq!(request.body_json()["model"], base_model);
+    assert_eq!(request.body_json()["reasoning"]["effort"], "xhigh");
+    test.codex.shutdown_and_wait().await?;
+    Ok(())
+}
 
