+                            text: "steered while evaluator waits".to_string(),
+                            text_elements: Vec::new(),
+                        }],
+                        client_id: None,
+                        metadata: Default::default(),
+                    }],
+                )
+                .await;
+            assert_eq!(turn_state.lock().await.accepted_input_revision, before + 1);
+            Arc::clone(&original)
+        }
+        EvaluatorChangeWhileAwaiting::SameValueManualEffort => {
+            assert_eq!(original.reasoning_effort(), Some(&ReasoningEffort::Low));
+            assert_eq!(
+                session
+                    .apply_turn_settings(
+                        &turn.sub_id,
+                        TurnSettingsUpdate {
+                            effort: Some(Some(ReasoningEffort::Low)),
+                            ..Default::default()
+                        }
+                    )
+                    .await,
+                TurnSettingsUpdateOutcome::Applied
+            );
+            let manual = turn.next_step_settings.load_full();
+            assert!(!Arc::ptr_eq(&manual, &original));
+            assert_eq!(manual.reasoning_effort(), Some(&ReasoningEffort::Low));
+            manual
+        }
+        EvaluatorChangeWhileAwaiting::Compaction => {
+            session.advance_auto_compact_window().await;
+            Arc::clone(&original)
+        }
+    };
+    release_tx.send(()).expect("deliver evaluator reply");
+    assert_eq!(
+        decision.await.expect("decision task"),
+        TurnSettingsUpdateOutcome::TargetUnavailable
+    );
+    assert!(Arc::ptr_eq(&turn.next_step_settings.load_full(), &expected));
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
