+//! Availability boundary for opt-in, continuously evaluated Ares turns.
+//! Legacy Jev and critic-assisted exchanges remain in the parent module.
+
+use super::*;
+use crate::context::ContextualUserFragment;
+use crate::context::JevMainReviewNotice;
+use codex_protocol::models::ResponseItem;
+
+impl StepController {
+    pub(in crate::session) fn record_initial_turn_input(
+        &mut self,
+        input: &[TurnInput],
+        turn_id: &str,
+    ) {
+        if !self.luna_continuous_mode
+            || input.iter().any(
+                |item| matches!(item, TurnInput::UserInput { content, .. } if !content.is_empty()),
+            )
+        {
+            return;
+        }
+        // Only native ResponseItem goal steering is eligible, never arbitrary tool output
+        // or text that merely mentions a goal. Keep the complete accepted task verbatim.
+        if let Some(text) = input.iter().find_map(|item| {
+            let TurnInput::ResponseItem(envelope) = item else {
+                return None;
+            };
+            let ResponseItem::Message { role, content, .. } = &envelope.item else {
+                return None;
+            };
+            if role != "user" || content.len() != 1 {
+                return None;
+            }
+            let codex_protocol::models::ContentItem::InputText { text } = &content[0] else {
+                return None;
+            };
+            let trimmed = text.trim();
+            (crate::context::InternalModelContextFragment::matches_text(trimmed)
+                && (trimmed.starts_with("<codex_internal_context source=\"goal\">")
+                    || trimmed.starts_with("<goal_context>")))
+            .then_some(text)
+        }) {
+            if self.original_prompt.trim().is_empty() {
+                self.original_prompt.clone_from(text);
+                self.original_task_source = "native_goal_continuation";
+            }
+            self.latest_prompt.clone_from(text);
+            self.admitted_input = AdmittedInput {
+                source: "native_goal_continuation",
+                text: String::new(),
+                truncated: false,
+            };
+            return;
+        }
+        // Only host-admitted task deliveries can supply task evidence. The metadata
+        // cannot cross the TurnInput serialization boundary; quoted XML and ordinary
+        // tool results cannot establish it. It does not grant sender permissions.
+        let mut deliveries = input.iter().filter_map(|item| {
+            let TurnInput::FunctionCallOutput(envelope) = item else {
+                return None;
+            };
+            let ResponseItem::FunctionCallOutput {
+                id: Some(id),
+                call_id: None,
+                name: Some(name),
+                namespace: Some(namespace),
+                output,
+                ..
+            } = &envelope.item
+            else {
+                return None;
+            };
+            if !matches!(
+                (namespace.as_str(), name.as_str()),
+                ("codex_app" | "codex_tui", "send_message_to_thread")
+                    | ("cloud_threads", "send_message")
+            ) {
+                return None;
+            }
+            let sender = envelope.metadata.as_ref()?.sender_user_messages.as_ref()?;
+            if sender.receiver_turn_id != turn_id || sender.receiver_message_id != id.to_string() {
+                return None;
+            }
+            // Structured output conversion is lossy; retain only a complete text body.
+            let text = output.text_content()?;
+            (!text.trim().is_empty()).then_some(text)
+        });
+        if let Some(first) = deliveries.next() {
+            if self.original_prompt.trim().is_empty() {
+                self.original_prompt = first.to_owned();
+                self.original_task_source = "native_task_delivery";
+            }
+            self.latest_prompt = deliveries.last().unwrap_or(first).to_owned();
+            self.input_revision += 1;
+            self.admitted_input = AdmittedInput {
+                source: "native_task_delivery",
+                // The complete delivery is already present in the task context.
+                text: String::new(),
+                truncated: false,
+            };
+            return;
+        }
+        if !matches!(self.admitted_input.source, "none" | "function_call_output") {
+            return;
+        }
+        let text = input.iter().find_map(|item| {
+            let TurnInput::FunctionCallOutput(envelope) = item else {
+                return None;
+            };
+            let ResponseItem::FunctionCallOutput { output, .. } = &envelope.item else {
+                return None;
+            };
+            output.body.to_text()
+        });
+        if let Some(text) = text {
+            let mut characters = text.chars();
+            let preview = characters.by_ref().take(16_000).collect::<String>();
+            self.admitted_input = AdmittedInput {
+                source: "function_call_output",
+                text: preview,
+                truncated: characters.next().is_some(),
+            };
+        }
+    }
+
+    fn trace_luna(
+        &self,
+        thread_id: &str,
+        turn_id: &str,
+        effort: Option<&ReasoningEffort>,
+        stage: &str,
+    ) {
+        crate::pilot_trace::PilotGeneration::record_stage_with_details(
+            thread_id.to_owned(),
+            turn_id.to_owned(),
+            self.sequence,
+            effort.map(ToString::to_string),
+            stage,
+            None,
+            self.connection_epoch,
+        );
+    }
+
+    fn note_luna_failure(
+        &mut self,
+        thread_id: &str,
+        turn_id: &str,
+        reason: &str,
+        disconnect: bool,
+    ) {
+        let epoch = self.connection_epoch;
+        if disconnect {
+            self.connection = None;
+            self.connection_epoch = None;
+        }
+        self.failure_streak = self.failure_streak.saturating_add(1).min(3);
+        let cooldown_seconds = 30_u64 << (self.failure_streak - 1);
+        self.retry_after = Some(Instant::now() + Duration::from_secs(cooldown_seconds));
+        tracing::warn!(
+            thread_id,
+            turn_id,
+            step = self.sequence,
+            connection_epoch = ?epoch,
+            reason,
+            cooldown_seconds,
+            "Luna evaluator unavailable; native fallback will preserve the turn"
+        );
+        crate::pilot_trace::PilotGeneration::record_stage_with_details(
+            thread_id.to_owned(),
+            turn_id.to_owned(),
+            self.sequence,
+            None,
+            "native_evaluator_unavailable",
+            Some(reason),
+            epoch,
+        );
+    }
+
+    fn note_luna_success(&mut self) {
+        self.failure_streak = 0;
+        self.retry_after = None;
+    }
+
+    async fn connect_luna(&mut self) -> Result<()> {
+        if self.connection.is_some() {
+            return Ok(());
+        }
+        #[cfg(unix)]
+        let connection = {
+            let socket = std::env::var_os("CODEX_STEP_CONTROLLER_SOCKET")
+                .ok_or_else(|| failure("Luna bridge endpoint is missing"))?;
+            tokio::time::timeout(Duration::from_secs(5), UnixStream::connect(socket))
+                .await
+                .map_err(|_| failure("connection timeout"))?
+                .map_err(|error| failure(error.to_string()))?
+        };
+        #[cfg(windows)]
+        let connection = Self::connect_windows().await?;
+        self.connection = Some(connection);
+        self.connection_epoch = Some(uuid::Uuid::new_v4());
+        Ok(())
+    }
+
+    async fn fallback_luna(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+        reason: &str,
+    ) -> Result<Option<AppliedSettings>> {
+        let thread_id = session.thread_id().to_string();
+        let Some(snapshot) = session
+            .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+            .await
+        else {
+            self.trace_luna(
+                &thread_id,
+                &turn.sub_id,
+                None,
+                "native_fallback_owner_unavailable",
+            );
+            return Err(failure("active turn changed before native fallback"));
+        };
+        if snapshot.guard.external_settings_revision != 0 {
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            self.trace_luna(&thread_id, &turn.sub_id, None, "native_manual_owner");
+            return Ok(None);
+        }
+        let current = Arc::clone(&snapshot.guard.settings);
+        let Some(base_model) =
+            self.selected_base_model(current.selected_collaboration_mode().model())
+        else {
+            drop(
+                turn.extension_data
+                    .get::<crate::session::jev_main::JevMainControl>()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            return Ok(None);
+        };
+        let model = &current.model_info;
+        if model.slug != base_model
+            || model.used_fallback_model_metadata
+            || !model.use_responses_lite
+        {
+            self.trace_luna(
+                &thread_id,
+                &turn.sub_id,
+                None,
+                "native_adaptive_disabled_catalog",
+            );
+            return Ok(None);
+        }
+        let supported = |effort: &ReasoningEffort| {
+            model
+                .supported_reasoning_levels
+                .iter()
+                .any(|preset| preset.effort == *effort)
+        };
+        let effort = self
+            .last_effort
+            .as_ref()
+            .filter(|effort| {
+                matches!(effort, ReasoningEffort::XHigh | ReasoningEffort::Max)
+                    && current.reasoning_effort() == Some(*effort)
+                    && supported(effort)
+            })
+            .cloned()
+            .or_else(|| supported(&ReasoningEffort::High).then_some(ReasoningEffort::High));
+        let Some(effort) = effort else {
+            tracing::warn!(
+                thread_id,
+                turn_id = turn.sub_id,
+                reason,
+                "Luna fallback has no supported High or retained strong effort; adaptive effort disabled"
+            );
+            self.trace_luna(
+                &thread_id,
+                &turn.sub_id,
+                None,
+                "native_adaptive_disabled_no_high",
+            );
+            return Ok(None);
+        };
+        match session
+            .apply_step_decision(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    effort: Some(Some(effort.clone())),
+                    ..Default::default()
+                },
+                snapshot.guard,
+            )
+            .await
+        {
+            TurnSettingsUpdateOutcome::Applied => {
+                self.trace_luna(
+                    &thread_id,
+                    &turn.sub_id,
+                    Some(&effort),
+                    "native_fallback_published",
+                );
+                Ok(Some(AppliedSettings {
+                    model: model.slug.clone(),
+                    previous_effort: current.reasoning_effort().cloned(),
+                    effort,
+                    lease_steps: 1,
+                    evaluator_ms: 0,
+                    from_bridge: false,
+                    main_request_call_id: None,
+                }))
+            }
+            TurnSettingsUpdateOutcome::Rejected { reason } => {
+                tracing::warn!(
+                    thread_id,
+                    turn_id = turn.sub_id,
+                    reason,
+                    "native fallback publication rejected"
+                );
+                self.trace_luna(&thread_id, &turn.sub_id, None, "native_fallback_rejected");
+                Ok(None)
+            }
+            TurnSettingsUpdateOutcome::TargetUnavailable => {
+                self.trace_luna(&thread_id, &turn.sub_id, None, "native_fallback_stale");
+                self.ensure_luna_turn_available(session, turn).await?;
+                Ok(None)
+            }
+        }
+    }
+
+    pub(super) async fn before_sampling_luna(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+    ) -> Result<Option<AppliedSettings>> {
+        self.trace_sequence = None;
+        self.capture_fresh = false;
+        let jev_control = self
+            .jev_main_mode
+            .then(|| {
+                turn.extension_data
+                    .get::<crate::session::jev_main::JevMainControl>()
+            })
+            .flatten();
+        let initial = turn.next_step_settings.load_full();
+        let selection_matches = self.ares_selection.is_some_and(|selection| {
+            ares_selection(initial.selected_collaboration_mode().model()) == Some(selection)
+                && self.jev_main_mode == (selection.route == AresRoute::JevMain)
+        });
+        let composer_prediction = turn.turn_metadata_state.is_composer_prediction();
+        if selection_matches && composer_prediction {
+            // Step zero records admission, not an evaluated model generation.
+            crate::pilot_trace::PilotGeneration::record_stage(
+                session.thread_id().to_string(),
+                turn.sub_id.clone(),
+                0,
+                None,
+                "native_composer_prediction_skipped",
+            );
+        }
+        if !selection_matches
+            || composer_prediction
+            || self
+                .selected_base_model(initial.selected_collaboration_mode().model())
+                .is_none()
+            || !crate::session::jev_main::eligible_ares_root(
+                turn.parent_thread_id,
+                &turn.session_source,
+                std::env::var("CODEX_LUNA_EVALUATOR").ok().as_deref() == Some("1"),
+            )
+        {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            return Ok(None);
+        }
+        if !session.enabled(Feature::StepModelSwitching)
+            || !session.enabled(Feature::ReasoningEffortOverride)
+        {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            return Ok(None);
+        }
+        let Some(snapshot) = session
+            .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+            .await
+        else {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            return Err(failure("active turn changed before Luna evaluation"));
+        };
+        self.capture_fresh = true;
+        if self.jev_main_mode
+            && !jev_control.as_ref().is_some_and(|control| {
+                control.thread_id == session.thread_id().to_string()
+                    && Some(control.selection) == self.ares_selection
+                    && control.selection_is_current(&snapshot.guard.settings)
+            })
+        {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            return Ok(None);
+        }
+        if snapshot.guard.external_settings_revision != 0 {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            return Ok(None);
+        }
+        let current = Arc::clone(&snapshot.guard.settings);
+        let Some(base_model) =
+            self.selected_base_model(current.selected_collaboration_mode().model())
+        else {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.connection = None;
+            self.connection_epoch = None;
+            self.last_effort = None;
+            return Ok(None);
+        };
+        let model = &current.model_info;
+        if model.slug != base_model
+            || model.used_fallback_model_metadata
+            || !model.use_responses_lite
+            || model.supported_reasoning_levels.is_empty()
+        {
+            drop(
+                jev_control
+                    .as_ref()
+                    .and_then(|control| control.take_pending()),
+            );
+            self.trace_luna(
+                &session.thread_id().to_string(),
+                &turn.sub_id,
+                None,
+                "native_adaptive_disabled_catalog",
+            );
+            return Ok(None);
+        }
+        self.sequence += 1;
+        self.trace_sequence = Some(self.sequence);
+        if let Some(control) = &jev_control {
+            control.set_step(self.sequence);
+        }
+        let thread_id = session.thread_id().to_string();
+        let turn_id = turn.sub_id.clone();
+        if let Some(request) = jev_control.and_then(|control| control.take_pending()) {
+            let still_valid = Some(request.selection) == self.ares_selection
+                && request.accepted_input_revision == snapshot.guard.accepted_input_revision
+                && request.settings_revision == snapshot.guard.external_settings_revision
+                && request.window_id == snapshot.guard.window_ids.window_id
+                && Arc::ptr_eq(&request.settings, &snapshot.guard.settings)
+                && model
+                    .supported_reasoning_levels
+                    .iter()
+                    .any(|preset| preset.effort == request.effort);
+            if still_valid {
+                self.trace_luna(
+                    &thread_id,
+                    &turn_id,
+                    Some(&request.effort),
+                    "native_jev_skipped_main_request",
+                );
+                let outcome = session
+                    .apply_step_decision(
+                        &turn.sub_id,
+                        TurnSettingsUpdate {
+                            effort: Some(Some(request.effort.clone())),
+                            ..Default::default()
+                        },
+                        snapshot.guard,
+                    )
+                    .await;
+                return match outcome {
+                    TurnSettingsUpdateOutcome::Applied => {
+                        crate::pilot_trace::PilotGeneration::record_stage_with_details(
+                            thread_id,
+                            turn_id,
+                            self.sequence,
+                            Some(request.effort.to_string()),
+                            "native_main_request_applied",
+                            Some(&format!(
+                                "callId={}; reason={}",
+                                request.call_id, request.reason
+                            )),
+                            self.connection_epoch,
+                        );
+                        Ok(Some(AppliedSettings {
+                            model: model.slug.clone(),
+                            previous_effort: current.reasoning_effort().cloned(),
+                            effort: request.effort,
+                            lease_steps: 1,
+                            evaluator_ms: 0,
+                            from_bridge: false,
+                            main_request_call_id: Some(request.call_id),
+                        }))
+                    }
+                    TurnSettingsUpdateOutcome::Rejected { reason } => {
+                        tracing::warn!(thread_id, turn_id, reason, "Main effort request rejected");
+                        self.trace_luna(&thread_id, &turn_id, None, "native_main_request_rejected");
+                        Ok(None)
+                    }
+                    TurnSettingsUpdateOutcome::TargetUnavailable => {
+                        self.trace_luna(&thread_id, &turn_id, None, "native_main_request_stale");
+                        self.ensure_luna_turn_available(session, turn).await?;
+                        Ok(None)
+                    }
+                };
+            }
+            self.trace_luna(&thread_id, &turn_id, None, "native_main_request_stale");
+        }
+        self.trace_luna(
+            &thread_id,
+            &turn_id,
+            current.reasoning_effort(),
+            "native_checkpoint",
+        );
+        let basis = (
+            snapshot.guard.accepted_input_revision,
+            snapshot.guard.external_settings_revision,
+            snapshot.guard.window_ids.window_id,
+        );
+        if self
+            .retry_after
+            .is_some_and(|deadline| Instant::now() < deadline)
+        {
+            self.trace_luna(&thread_id, &turn_id, None, "native_evaluator_cooldown");
+            return self
+                .fallback_luna(session, turn, "evaluator cooldown")
+                .await;
+        }
+        if let Err(error) = self.connect_luna().await {
+            self.note_luna_failure(&thread_id, &turn_id, &error.to_string(), true);
+            return self.fallback_luna(session, turn, "bridge connection").await;
+        }
+        let supported_efforts = model
+            .supported_reasoning_levels
+            .iter()
+            .map(|preset| preset.effort.clone())
+            .collect::<Vec<_>>();
+        let primary_environment = snapshot.environments.primary();
+        let project = ProjectScope {
+            #[allow(deprecated)]
+            cwd: primary_environment
+                .and_then(|environment| environment.cwd().to_abs_path().ok())
+                .map(|cwd| cwd.as_path().to_string_lossy().into_owned())
+                .unwrap_or_else(|| turn.cwd.as_path().to_string_lossy().into_owned()),
+            workspace_roots: primary_environment
+                .map(|environment| {
+                    environment
+                        .workspace_roots()
+                        .iter()
+                        .filter_map(|root| root.to_abs_path().ok())
+                        .map(|root| root.as_path().to_string_lossy().into_owned())
+                        .collect()
+                })
+                .unwrap_or_default(),
+            session_source: turn.session_source.to_string(),
+            root_user: true,
+        };
+        let checkpoint = Checkpoint {
+            protocol: 4,
+            r#type: "checkpoint",
+            thread_id: thread_id.clone(),
+            turn_id: turn_id.clone(),
+            step: self.sequence,
+            model: model.slug.clone(),
+            selection_alias: self.ares_selection.map(|selected| selected.alias),
+            route: self.ares_selection.map(|selected| selected.route.as_str()),
+            supported_efforts: supported_efforts.clone(),
+            current_effort: current.reasoning_effort().cloned(),
+            input_revision: self.input_revision,
+            failed_tool_count: self.failures.0.load(Ordering::Acquire),
+            context: snapshot.context.with_task_sources(
+                self.original_task_source,
+                match self.admitted_input.source {
+                    "native_goal_continuation" => "native_goal_continuation",
+                    "native_task_delivery" => "native_task_delivery",
+                    _ => "native_user_input",
+                },
+            ),
+            advice_basis: AdviceBasis {
+                owner_id: self.owner_id,
+                accepted_input_revision: basis.0,
+                settings_revision: basis.1,
+                first_window_id: snapshot.guard.window_ids.first_window_id,
+                previous_window_id: snapshot.guard.window_ids.previous_window_id,
+                window_id: basis.2,
+            },
+            connection_epoch: self.connection_epoch,
+            project: Some(project),
+            admitted_input: Some(self.admitted_input.clone()),
+        };
+        let reply = match self.exchange(&checkpoint).await {
+            Ok(reply) => reply,
+            Err(error) => {
+                self.note_luna_failure(&thread_id, &turn_id, &error.to_string(), true);
+                return self.fallback_luna(session, turn, "decision exchange").await;
+            }
+        };
+        let (effort, evaluator_ms, review) = match reply {
+            Reply::Decision {
+                protocol: 4,
+                thread_id: reply_thread,
+                turn_id: reply_turn,
+                step,
+                effort,
+                lease_steps: 1,
+                evaluator_ms,
+                connection_epoch,
+            } if reply_thread == thread_id
+                && reply_turn == turn_id
+                && step == self.sequence
+                && connection_epoch == self.connection_epoch
+                && supported_efforts.contains(&effort)
+                && matches!(
+                    effort,
+                    ReasoningEffort::Medium
+                        | ReasoningEffort::High
+                        | ReasoningEffort::XHigh
+                        | ReasoningEffort::Max
+                ) =>
+            {
+                (effort, evaluator_ms, None)
+            }
+            Reply::Review {
+                protocol: 4,
+                thread_id: reply_thread,
+                turn_id: reply_turn,
+                step,
+                connection_epoch,
+                reason,
+                episode_id,
+            } if self.jev_main_mode
+                && reply_thread == thread_id
+                && reply_turn == turn_id
+                && step == self.sequence
+                && Some(connection_epoch) == self.connection_epoch
+                && matches!(reason.as_str(), "semantic_defer" | "evidence_gap")
+                && (1..=128).contains(&episode_id.len())
+                && episode_id
+                    .bytes()
+                    .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_') =>
+            {
+                let retained = current.reasoning_effort().filter(|effort| {
+                    matches!(effort, ReasoningEffort::XHigh | ReasoningEffort::Max)
+                        && supported_efforts.contains(effort)
+                });
+                let effort = retained.cloned().or_else(|| {
+                    supported_efforts
+                        .contains(&ReasoningEffort::High)
+                        .then_some(ReasoningEffort::High)
+                });
+                let Some(effort) = effort else {
+                    self.trace_luna(&thread_id, &turn_id, None, "native_review_no_high");
+                    return self
+                        .fallback_luna(session, turn, "review High unsupported")
+                        .await;
+                };
+                let reason = if reason == "semantic_defer" {
+                    "semantic_defer"
+                } else {
+                    "evidence_gap"
+                };
+                (effort, 0, Some((reason, episode_id)))
+            }
+            Reply::Degraded {
+                protocol: 4,
+                thread_id: reply_thread,
+                turn_id: reply_turn,
+                step,
+                connection_epoch,
+                reason,
+            } if reply_thread == thread_id
+                && reply_turn == turn_id
+                && step == self.sequence
+                && Some(connection_epoch) == self.connection_epoch =>
+            {
+                // This is a healthy transport response. The evaluator owns its
+                // per-target cooldown and unchanged-snapshot suppression.
+                self.note_luna_success();
+                self.trace_luna(&thread_id, &turn_id, None, "native_evaluator_degraded");
+                return self.fallback_luna(session, turn, &reason).await;
+            }
+            _ => {
+                self.note_luna_failure(&thread_id, &turn_id, "mismatched decision frame", true);
+                return self
+                    .fallback_luna(session, turn, "mismatched decision frame")
+                    .await;
+            }
+        };
+        self.note_luna_success();
+        self.trace_luna(
+            &thread_id,
+            &turn_id,
+            Some(&effort),
+            if review.is_some() {
+                "native_review_selected"
+            } else {
+                "native_selected"
+            },
+        );
+        match session
+            .apply_step_decision(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    effort: Some(Some(effort.clone())),
+                    ..Default::default()
+                },
+                snapshot.guard,
+            )
+            .await
+        {
+            TurnSettingsUpdateOutcome::Applied => {
+                self.trace_luna(&thread_id, &turn_id, Some(&effort), "native_published");
+                if let Some((reason, episode_id)) = review
+                    && self.last_review_episode.as_ref() != Some(&episode_id)
+                {
+                    let still_current = session
+                        .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+                        .await
+                        .is_some_and(|fresh| {
+                            fresh.guard.accepted_input_revision == basis.0
+                                && fresh.guard.external_settings_revision == basis.1
+                                && fresh.guard.window_ids.window_id == basis.2
+                                && self.selected_base_model(
+                                    fresh.guard.settings.selected_collaboration_mode().model(),
+                                ) == Some(model.slug.as_str())
+                                && turn
+                                    .extension_data
+                                    .get::<crate::session::jev_main::JevMainControl>()
+                                    .is_some_and(|control| {
+                                        control.selection_is_current(&fresh.guard.settings)
+                                    })
+                        });
+                    if still_current {
+                        let notice = ContextualUserFragment::into(JevMainReviewNotice::new(reason));
+                        session
+                            .record_conversation_items(turn, model, std::slice::from_ref(&notice))
+                            .await;
+                        self.last_review_episode = Some(episode_id);
+                        self.trace_luna(
+                            &thread_id,
+                            &turn_id,
+                            Some(&effort),
+                            "native_review_recorded",
+                        );
+                    }
+                }
+                Ok(Some(AppliedSettings {
+                    model: model.slug.clone(),
+                    previous_effort: current.reasoning_effort().cloned(),
+                    effort,
+                    lease_steps: 1,
+                    evaluator_ms,
+                    from_bridge: true,
+                    main_request_call_id: None,
+                }))
+            }
+            TurnSettingsUpdateOutcome::Rejected { reason } => {
+                self.connection = None;
+                self.connection_epoch = None;
+                tracing::warn!(
+                    thread_id,
+                    turn_id,
+                    reason,
+                    "Luna advice rejected by native settings guard"
+                );
+                self.trace_luna(
+                    &thread_id,
+                    &turn_id,
+                    None,
+                    "native_adaptive_disabled_rejected",
+                );
+                Ok(None)
+            }
+            TurnSettingsUpdateOutcome::TargetUnavailable => {
+                self.connection = None;
+                self.connection_epoch = None;
+                self.trace_luna(&thread_id, &turn_id, None, "native_decision_stale");
+                self.ensure_luna_turn_available(session, turn).await?;
+                Ok(None)
+            }
+        }
+    }
+
+    pub(super) async fn confirm_luna(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+        step: &StepContext,
+        applied: AppliedSettings,
+    ) -> Result<()> {
+        let thread_id = session.thread_id().to_string();
+        let turn_id = turn.sub_id.clone();
+        if step.settings.reasoning_effort() != Some(&applied.effort)
+            || step.settings.model_info.slug != applied.model
+            || self.selected_base_model(step.settings.selected_collaboration_mode().model())
+                != Some(applied.model.as_str())
+        {
+            let snapshot = session
+                .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+                .await
+                .ok_or_else(|| failure("active turn changed before Luna capture confirmation"))?;
+            if snapshot.guard.external_settings_revision != 0
+                && Arc::ptr_eq(&snapshot.guard.settings, &step.settings)
+            {
+                self.connection = None;
+                self.connection_epoch = None;
+                self.last_effort = None;
+                self.trace_luna(&thread_id, &turn_id, None, "native_manual_capture_owner");
+                return Ok(());
+            }
+            return Err(failure(
+                "selected settings were not captured by the sampling step",
+            ));
+        }
+        let event = ReasoningEffortUpdatedEvent {
+            from_effort: applied
+                .previous_effort
+                .as_ref()
+                .filter(|effort| *effort != &applied.effort)
+                .map(ToString::to_string),
+            to_effort: applied.effort.to_string(),
+            step: self.sequence,
+            lease_steps: applied.lease_steps,
+            evaluator_ms: applied.evaluator_ms,
+        };
+        let should_emit =
+            self.last_effort.is_none() || applied.previous_effort.as_ref() != Some(&applied.effort);
+        self.last_effort = Some(applied.effort.clone());
+        if applied.from_bridge {
+            let receipt = serde_json::json!({
+                "protocol": 4, "type": "applied", "threadId": thread_id,
+                "turnId": turn_id, "step": self.sequence,
+                "connectionEpoch": self.connection_epoch,
+                "effort": applied.effort,
+                "confirmation": "native_step_context_captured"
+            });
+            match self.exchange(&receipt).await {
+                Ok(Reply::Recorded {
+                    protocol: 4,
+                    step,
+                    thread_id: Some(reply_thread),
+                    turn_id: Some(reply_turn),
+                    connection_epoch,
+                }) if step == self.sequence
+                    && reply_thread == thread_id
+                    && reply_turn == turn_id
+                    && connection_epoch == self.connection_epoch =>
+                {
+                    self.trace_luna(
+                        &thread_id,
+                        &turn_id,
+                        Some(&applied.effort),
+                        "native_recorded",
+                    );
+                }
+                Ok(_) => {
+                    self.note_luna_failure(&thread_id, &turn_id, "mismatched recorded frame", true);
+                    self.trace_luna(
+                        &thread_id,
+                        &turn_id,
+                        Some(&applied.effort),
+                        "native_record_ack_missing",
+                    );
+                }
+                Err(error) => {
+                    self.note_luna_failure(&thread_id, &turn_id, &error.to_string(), true);
+                    self.trace_luna(
+                        &thread_id,
+                        &turn_id,
+                        Some(&applied.effort),
+                        "native_record_ack_missing",
+                    );
+                }
+            }
+        } else if let Some(call_id) = &applied.main_request_call_id {
+            self.trace_luna(
+                &thread_id,
+                &turn_id,
+                Some(&applied.effort),
+                "native_main_request_captured",
+            );
+            if self.connection.is_some() && self.connection_epoch.is_some() {
+                let receipt = serde_json::json!({
+                    "protocol": 4, "type": "controlApplied", "threadId": thread_id,
+                    "turnId": turn_id, "step": self.sequence,
+                    "connectionEpoch": self.connection_epoch,
+                    "effort": applied.effort,
+                    "callId": call_id,
+                    "confirmation": "native_step_context_captured"
+                });
+                let recorded =
+                    tokio::time::timeout(Duration::from_secs(2), self.exchange(&receipt)).await;
+                if !matches!(
+                    recorded,
+                    Ok(Ok(Reply::Recorded {
+                        protocol: 4,
+                        step,
+                        thread_id: Some(ref reply_thread),
+                        turn_id: Some(ref reply_turn),
+                        connection_epoch,
+                    })) if step == self.sequence
+                        && reply_thread == &thread_id
+                        && reply_turn == &turn_id
+                        && connection_epoch == self.connection_epoch
+                ) {
+                    self.connection = None;
+                    self.connection_epoch = None;
+                    self.trace_luna(
+                        &thread_id,
+                        &turn_id,
+                        Some(&applied.effort),
+                        "native_main_request_ack_missing",
+                    );
+                }
+            }
+        } else {
+            self.trace_luna(
+                &thread_id,
+                &turn_id,
+                Some(&applied.effort),
+                "native_fallback_captured",
+            );
+        }
+        if should_emit {
+            session
+                .send_event(turn, EventMsg::ReasoningEffortUpdated(event))
+                .await;
+        }
+        Ok(())
+    }
+
+    async fn ensure_luna_turn_available(
+        &self,
+        session: &Session,
+        turn: &TurnContext,
+    ) -> Result<()> {
+        session
+            .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+            .await
+            .ok_or_else(|| failure("active turn changed after Luna decision"))?;
+        Ok(())
+    }
+}
diff --git a/codex-rs/core/src/session/step_controller_tests.rs b/codex-rs/core/src/session/step_controller_tests.rs
