+            "turn_id" => {
+                envelope
+                    .metadata
+                    .as_mut()
+                    .unwrap()
+                    .sender_user_messages
+                    .as_mut()
+                    .unwrap()
+                    .receiver_turn_id = "another-turn".to_owned()
+            }
+            "response_item" => {}
+            _ => {
+                let codex_protocol::models::ResponseItem::FunctionCallOutput {
+                    id,
+                    call_id,
+                    name,
+                    namespace,
+                    output,
+                    ..
+                } = &mut envelope.item
+                else {
+                    unreachable!()
