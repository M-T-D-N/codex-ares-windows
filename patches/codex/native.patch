index 0000000000000000000000000000000000000000..3e40366eab8f2a6e7539a063bda5b62ca475d616
--- /dev/null
+++ b/codex-rs/app-server/src/current_time_request_tests.rs
@@ -0,0 +1,246 @@
+use super::*;
+use codex_app_server_protocol::CurrentTimeReadParams;
+use std::future::Future;
+use std::future::poll_fn;
+use std::task::Poll;
+use tokio::time::Duration;
+use tokio::time::Instant;
+use tokio::time::timeout;
+
+async fn blocked_clock_request(outgoing: Arc<OutgoingMessageSender>) {
+    let _response = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(10),
+        )
+        .await;
+}
+
+#[tokio::test]
+async fn canceled_clock_queue_wait_leaves_no_callback() {
+    let (tx, _rx) = mpsc::channel(1);
+    tx.send(OutgoingEnvelope::Broadcast {
+        message: OutgoingMessage::Request(
+            ServerRequestPayload::CurrentTimeRead(CurrentTimeReadParams {
+                thread_id: "queue-filler".to_string(),
+            })
+            .request_with_id(RequestId::Integer(-1)),
+        ),
+    })
+    .await
+    .unwrap();
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        tx,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let (started, ready) = oneshot::channel();
+    let task_outgoing = outgoing.clone();
+    let task = tokio::spawn(async move {
+        let request = blocked_clock_request(task_outgoing);
+        tokio::pin!(request);
+        poll_fn(|cx| match request.as_mut().poll(cx) {
+            Poll::Pending => Poll::Ready(()),
+            Poll::Ready(_) => panic!("full queue should wait"),
+        })
+        .await;
+        started.send(()).unwrap();
+        request.await
+    });
+    timeout(Duration::from_secs(1), ready)
+        .await
+        .unwrap()
+        .unwrap();
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
+
+fn sender(capacity: usize) -> (Arc<OutgoingMessageSender>, mpsc::Receiver<OutgoingEnvelope>) {
+    let (tx, rx) = mpsc::channel(capacity);
+    (
+        Arc::new(OutgoingMessageSender::new(
+            tx,
+            AnalyticsEventsClient::disabled(),
+        )),
+        rx,
+    )
+}
+
+#[tokio::test]
+async fn clock_queue_wait_obeys_deadline_without_registration() {
+    let (outgoing, mut rx) = sender(1);
+    outgoing
+        .sender
