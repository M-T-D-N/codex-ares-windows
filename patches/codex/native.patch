+fn acl(text: &str) -> (Vec<u32>, u16) {
+    let wide: Vec<u16> = std::ffi::OsStr::new(text)
+        .encode_wide()
+        .chain(Some(0))
+        .collect();
+    let mut descriptor = ptr::null_mut();
+    assert_ne!(
+        unsafe {
+            authorization::ConvertStringSecurityDescriptorToSecurityDescriptorW(
+                wide.as_ptr(),
+                1,
+                &mut descriptor,
+                ptr::null_mut(),
+            )
+        },
+        0
+    );
+    let mut present = 0;
+    let mut dacl = ptr::null_mut();
+    let mut defaulted = 0;
+    assert_ne!(
+        unsafe {
+            security::GetSecurityDescriptorDacl(descriptor, &mut present, &mut dacl, &mut defaulted)
+        },
+        0
+    );
+    assert!(!dacl.is_null());
+    let mut control = 0;
+    let mut revision = 0;
+    assert_ne!(
+        unsafe { security::GetSecurityDescriptorControl(descriptor, &mut control, &mut revision) },
+        0
+    );
+    let length = usize::from(unsafe { (*dacl).AclSize });
+    let mut result = vec![0u32; length.div_ceil(4)];
+    unsafe { ptr::copy_nonoverlapping(dacl.cast::<u8>(), result.as_mut_ptr().cast(), length) };
+    unsafe { LocalFree(descriptor) };
+    (result, control)
+}
