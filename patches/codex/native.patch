+        assert_eq!(jev_base_model(alias), Some(base_model));
+        assert!(
+            JevMainControl::for_new_turn(
+                thread_id,
+                /*parent_thread_id*/ None,
+                &SessionSource::Exec,
+                alias,
+                /*adaptive_enabled*/ true,
+                Some("luna-continuous-1"),
+                /*evaluator_process*/ false,
+            )
+            .is_none()
+        );
+    }
+}
+
+#[tokio::test]
+async fn retired_main_aliases_keep_manual_effort_without_a_checkpoint() {
+    for (alias, base_model) in [
+        (ASTRA_JEV_MAIN_MODEL, "gpt-6-astra"),
+        (SOL_JEV_MAIN_MODEL, "gpt-6-sol"),
+    ] {
+        let (session, turn, mut controller) = luna_fixture_with_model(alias, base_model).await;
+        assert!(controller.ares_selection.is_none());
+        assert_eq!(controller.selected_base_model(alias), None);
+        assert!(
+            turn.extension_data
+                .get::<crate::session::jev_main::JevMainControl>()
+                .is_none()
+        );
+        assert_eq!(
+            turn.next_step_settings.load().reasoning_effort(),
+            Some(&ReasoningEffort::Medium)
+        );
+        assert!(
+            controller
+                .before_sampling_luna(&session, &turn)
+                .await
+                .expect("retired route bypasses evaluator")
+                .is_none()
+        );
+        assert!(controller.connection.is_none());
+        assert_eq!(controller.sequence, 0);
+        assert_eq!(
+            turn.next_step_settings.load().reasoning_effort(),
+            Some(&ReasoningEffort::Medium)
