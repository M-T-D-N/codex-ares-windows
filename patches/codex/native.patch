+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct AresSelection {
+    pub alias: &'static str,
+    pub base_model: &'static str,
+    pub display_name: &'static str,
+    pub route: AresRoute,
+}
+
+pub const ARES_SELECTIONS: [AresSelection; 4] = [
+    AresSelection {
+        alias: ASTRA_JEV_MODEL,
+        base_model: ASTRA_JEV_BASE_MODEL,
+        display_name: "Astra Ares",
+        route: AresRoute::LunaContinuous,
+    },
+    AresSelection {
+        alias: "Sol-Jev",
+        base_model: "gpt-6-sol",
+        display_name: "Sol Ares",
+        route: AresRoute::LunaContinuous,
+    },
+    AresSelection {
+        alias: "Sol 6.1-Ares",
+        base_model: "gpt-6.1-sol",
+        display_name: "Sol 6.1-Ares",
+        route: AresRoute::LunaContinuous,
+    },
+    AresSelection {
+        alias: "Terra 6.1-Ares",
+        base_model: "gpt-6.1-terra",
+        display_name: "Terra 6.1-Ares",
+        route: AresRoute::LunaContinuous,
+    },
+];
+
+pub fn ares_selection(selection: &str) -> Option<AresSelection> {
+    // Preserve saved selections while exposing a readable ID to Desktop onboarding.
+    let selection = match selection {
+        "Sol61-Ares" => "Sol 6.1-Ares",
+        other => other,
+    };
+    ARES_SELECTIONS
+        .iter()
+        .copied()
+        .find(|entry| entry.alias == selection)
+}
+// Stable selection IDs, provider model IDs, and user-facing names.
+// Historical lookup only. Picker and live routing use ARES_SELECTIONS.
+pub const JEV_MODELS: [(&str, &str, &str); 3] = [
+    (ASTRA_JEV_MODEL, ASTRA_JEV_BASE_MODEL, "Astra Ares"),
+    ("Luna-Jev", "gpt-6-luna", "Luna Ares"),
+    ("Sol-Jev", "gpt-6-sol", "Sol Ares"),
+];
+
+// Saved Jev/Main selections resolve to their original plain models. Keep them
+// outside JEV_MODELS, which also enables the older evaluator bridge.
+const RETIRED_JEV_MAIN_MODELS: [(&str, &str, &str); 2] = [
+    (
+        ASTRA_JEV_MAIN_MODEL,
+        ASTRA_JEV_BASE_MODEL,
+        ASTRA_JEV_BASE_MODEL,
+    ),
+    (SOL_JEV_MAIN_MODEL, "gpt-6-sol", "gpt-6-sol"),
+];
+
+pub fn jev_base_model(selection: &str) -> Option<&'static str> {
+    ares_selection(selection)
+        .map(|entry| entry.base_model)
+        .or_else(|| {
+            JEV_MODELS
+                .iter()
+                .chain(RETIRED_JEV_MAIN_MODELS.iter())
+                .find_map(|(alias, base, _)| (*alias == selection).then_some(*base))
+        })
+}
+
+pub fn jev_display_name(selection: &str) -> Option<&'static str> {
+    ares_selection(selection)
+        .map(|entry| entry.display_name)
+        .or_else(|| {
+            JEV_MODELS
+                .iter()
+                .chain(RETIRED_JEV_MAIN_MODELS.iter())
+                .find_map(|(alias, _, name)| (*alias == selection).then_some(*name))
+        })
+}
 
