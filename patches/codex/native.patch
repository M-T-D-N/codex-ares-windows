+#[cfg(windows)]
+async fn attached_bridge(controller: &mut StepController) -> TcpStream {
+    let listener = TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0))
+        .await
+        .expect("loopback listener");
+    let client = TcpStream::connect(listener.local_addr().expect("listener address"))
+        .await
+        .expect("loopback client");
+    let (server, _) = listener.accept().await.expect("accepted connection");
+    controller.connection = Some(client);
+    controller.connection_epoch = Some(uuid::Uuid::new_v4());
+    server
+}
