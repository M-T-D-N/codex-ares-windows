+#[tokio::test]
+async fn luna_native_task_delivery_preserves_original_and_user_goal_priority() {
+    let (session, turn, _) = luna_fixture().await;
+    for (namespace, name) in [
+        ("codex_app", "send_message_to_thread"),
+        ("codex_tui", "send_message_to_thread"),
+        ("cloud_threads", "send_message"),
+    ] {
+        let mut controller = StepController::new(&turn, &[]);
+        controller.luna_continuous_mode = true;
+        let first = host_task_delivery(&turn.sub_id, namespace, name, "original accepted task");
+        controller.record_initial_turn_input(&[first], &turn.sub_id);
+        let second =
+            host_task_delivery(&turn.sub_id, namespace, name, "latest accepted refinement");
+        controller.record_initial_turn_input(&[second], &turn.sub_id);
+        assert_eq!(controller.original_prompt, "original accepted task");
+        assert_eq!(controller.latest_prompt, "latest accepted refinement");
+        assert_eq!(controller.admitted_input.source, "native_task_delivery");
+    }
+    let mut human = StepController::new(
+        &turn,
+        &[UserInput::Text {
+            text: "original human task".to_owned(),
+            text_elements: vec![],
+        }],
+    );
+    human.luna_continuous_mode = true;
+    // A later accepted host delivery refines latest without replacing the human original.
+    human.record_initial_turn_input(
+        &[host_task_delivery(
+            &turn.sub_id,
+            "codex_app",
+            "send_message_to_thread",
+            "later delivery",
+        )],
+        &turn.sub_id,
+    );
+    assert_eq!(human.original_prompt, "original human task");
+    assert_eq!(human.latest_prompt, "later delivery");
+    assert_eq!(human.original_task_source, "native_user_input");
+    assert_eq!(human.admitted_input.source, "native_task_delivery");
+    let correction = vec![UserInput::Text {
+        text: "current human correction".to_owned(),
+        text_elements: vec![],
+    }];
+    human.accept_user_input(&correction);
+    // Within one accepted batch, real user input takes priority over deliveries.
+    human.record_initial_turn_input(
+        &[
+            TurnInput::UserInput {
+                content: correction,
+                client_id: None,
+                metadata: Default::default(),
+            },
+            host_task_delivery(
+                &turn.sub_id,
+                "codex_app",
+                "send_message_to_thread",
+                "same-batch delivery",
+            ),
+        ],
+        &turn.sub_id,
+    );
+    assert_eq!(human.original_prompt, "original human task");
+    assert_eq!(human.latest_prompt, "current human correction");
+    assert_eq!(human.original_task_source, "native_user_input");
+    assert_eq!(human.admitted_input.source, "user_text");
+    let goal = "<codex_internal_context source=\"goal\">current objective</codex_internal_context>";
+    let pending = serde_json::from_value::<TurnInput>(serde_json::json!({
+        "ResponseItem": {"type":"message","role":"user","content":[{"type":"input_text","text":goal}]}
+    })).unwrap();
+    let mut controller = StepController::new(&turn, &[]);
+    controller.luna_continuous_mode = true;
+    controller.record_initial_turn_input(&[pending], &turn.sub_id);
+    controller.record_initial_turn_input(
+        &[host_task_delivery(
+            &turn.sub_id,
+            "codex_app",
+            "send_message_to_thread",
+            "goal refinement",
+        )],
+        &turn.sub_id,
+    );
+    assert_eq!(controller.original_prompt, goal);
+    assert_eq!(controller.latest_prompt, "goal refinement");
+    assert_eq!(controller.original_task_source, "native_goal_continuation");
+    assert_eq!(controller.admitted_input.source, "native_task_delivery");
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
