+        assert_eq!(completed[0]["requestId"], prepared[0]["requestId"]);
+        assert_eq!(completed[0]["responseId"], response_ids[index]);
+        assert_eq!(completed[0]["usage"]["total_tokens"], 0);
+        if index < 2 {
+            assert_eq!(completed[0]["endTurn"], false);
+        }
+    }
+    Ok(())
