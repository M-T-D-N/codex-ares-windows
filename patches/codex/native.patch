+#[tokio::test]
+async fn pilot_http_configured_429_retry_telemetry_does_not_preempt_success() -> anyhow::Result<()>
+{
+    let server = MockServer::start().await;
+    let calls = Arc::new(AtomicUsize::new(0));
+    let responder_calls = Arc::clone(&calls);
+    Mock::given(method("POST"))
+        .and(path("/v1/responses"))
+        .respond_with(move |_: &wiremock::Request| {
+            if responder_calls.fetch_add(1, Ordering::SeqCst) == 0 {
+                ResponseTemplate::new(429).set_body_string("SENTINEL_PRIVATE_HTTP_BODY")
+            } else {
+                pilot_completed_sse()
+            }
+        })
+        .expect(2)
+        .mount(&server)
+        .await;
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    let client = pilot_http_client(&server, Some(1));
+    let mut stream = pilot_http_dispatch(
+        &client,
+        crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+    )
+    .await?;
+    let mut completed = false;
+    while let Some(event) = stream.next().await {
+        if matches!(event?, ResponseEvent::Completed { .. }) {
+            completed = true;
+        }
+    }
+    drop(stream);
+    assert!(completed);
+    let rows = assert_one_pilot_http_terminal(&path, "response_completed", None, Some(200));
+    let attempts = rows
+        .iter()
+        .filter(|row| row["type"] == "http_attempt_completed")
+        .collect::<Vec<_>>();
+    assert_eq!(attempts.len(), 2);
+    assert_eq!(attempts[0]["status"], 429);
+    assert_eq!(attempts[1]["status"], 200);
+    assert_eq!(calls.load(Ordering::SeqCst), 2);
+    Ok(())
+}
