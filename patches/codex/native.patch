diff --git a/codex-rs/app-server/src/current_time_request.rs b/codex-rs/app-server/src/current_time_request.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ae9ab805295039eaff91fae2daa8b914c3c7fe66
--- /dev/null
+++ b/codex-rs/app-server/src/current_time_request.rs
@@ -0,0 +1,110 @@
+use std::sync::Arc;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use codex_app_server_protocol::CurrentTimeReadParams;
+use codex_app_server_protocol::RequestId;
+use codex_app_server_protocol::ServerRequestPayload;
+use codex_protocol::ThreadId;
+use tokio::runtime::Handle;
+use tokio::sync::oneshot;
+use tokio::time::Instant;
+use tokio::time::timeout_at;
+
+use super::ClientRequestResult;
+use super::ConnectionId;
+use super::OutgoingEnvelope;
+use super::OutgoingMessage;
+use super::OutgoingMessageSender;
+use super::PENDING_SERVER_REQUESTS;
+use super::PendingCallbackEntry;
+use super::now_unix_timestamp_ms;
+
+pub(crate) struct PendingClockRequest {
+    id: RequestId,
+    outgoing: Arc<OutgoingMessageSender>,
+    runtime: Handle,
+    pub(crate) response: oneshot::Receiver<ClientRequestResult>,
+}
+
+impl Drop for PendingClockRequest {
+    fn drop(&mut self) {
+        if let Ok(mut callbacks) = self.outgoing.request_id_to_callback.try_lock() {
+            if callbacks.remove(&self.id).is_some() {
+                self.outgoing
+                    .analytics_events_client
+                    .track_server_request_aborted(now_unix_timestamp_ms(), self.id.clone());
+            }
+        } else {
+            // Drop cannot extend the deadline or hold up turn cancellation.
+            let outgoing = self.outgoing.clone();
+            let id = self.id.clone();
+            self.runtime.spawn(async move {
+                outgoing.cancel_request(&id).await;
+                tracing::debug!(request_id = ?id, "current-time callback cleanup completed");
+            });
+        }
+    }
+}
+
+impl OutgoingMessageSender {
+    pub(crate) async fn send_current_time_request(
+        self: &Arc<Self>,
+        connection_id: ConnectionId,
+        thread_id: ThreadId,
+        deadline: Instant,
+    ) -> Result<PendingClockRequest> {
+        ensure!(
+            Instant::now() < deadline,
+            "current-time send deadline expired"
+        );
+        // Reserve before registration so cancellation behind a full queue
+        // cannot orphan a callback.
+        let permit = timeout_at(deadline, self.sender.reserve())
+            .await
+            .context("current-time request timed out waiting for the outgoing queue")?
+            .context("current-time outgoing queue is closed")?;
+        let mut callbacks = timeout_at(deadline, self.request_id_to_callback.lock())
+            .await
+            .context("current-time request timed out waiting for callback registration")?;
+        ensure!(
+            Instant::now() < deadline,
+            "current-time send deadline expired"
+        );
+        let id = self.next_request_id();
+        let request = ServerRequestPayload::CurrentTimeRead(CurrentTimeReadParams {
+            thread_id: thread_id.to_string(),
+        })
+        .request_with_id(id.clone());
+        let (callback, response) = oneshot::channel();
+        let pending = PendingClockRequest {
+            id: id.clone(),
+            outgoing: self.clone(),
+            runtime: Handle::current(),
+            response,
+        };
+        callbacks.insert(
+            id,
+            PendingCallbackEntry {
+                verification_owner: None,
+                verification_auth_revision: None,
+                verification_identity: None,
+                callback,
+                thread_id: None,
+                request: request.clone(),
+                _diagnostics_guard: PENDING_SERVER_REQUESTS.track(),
+            },
+        );
+        drop(callbacks);
+        // No await separates registration, enqueue and returning its owner.
+        permit.send(OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::Request(request.clone()),
+            write_complete_tx: None,
+        });
+        self.analytics_events_client
+            .track_server_request(connection_id.0, request);
+        Ok(pending)
+    }
+}
diff --git a/codex-rs/app-server/src/current_time_request_tests.rs b/codex-rs/app-server/src/current_time_request_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..3e40366eab8f2a6e7539a063bda5b62ca475d616
--- /dev/null
+++ b/codex-rs/app-server/src/current_time_request_tests.rs
@@ -0,0 +1,246 @@
+use super::*;
+use codex_app_server_protocol::CurrentTimeReadParams;
+use std::future::Future;
+use std::future::poll_fn;
+use std::task::Poll;
+use tokio::time::Duration;
+use tokio::time::Instant;
+use tokio::time::timeout;
+
+async fn blocked_clock_request(outgoing: Arc<OutgoingMessageSender>) {
+    let _response = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(10),
+        )
+        .await;
+}
+
+#[tokio::test]
+async fn canceled_clock_queue_wait_leaves_no_callback() {
+    let (tx, _rx) = mpsc::channel(1);
+    tx.send(OutgoingEnvelope::Broadcast {
+        message: OutgoingMessage::Request(
+            ServerRequestPayload::CurrentTimeRead(CurrentTimeReadParams {
+                thread_id: "queue-filler".to_string(),
+            })
+            .request_with_id(RequestId::Integer(-1)),
+        ),
+    })
+    .await
+    .unwrap();
+    let outgoing = Arc::new(OutgoingMessageSender::new(
+        tx,
+        AnalyticsEventsClient::disabled(),
+    ));
+    let (started, ready) = oneshot::channel();
+    let task_outgoing = outgoing.clone();
+    let task = tokio::spawn(async move {
+        let request = blocked_clock_request(task_outgoing);
+        tokio::pin!(request);
+        poll_fn(|cx| match request.as_mut().poll(cx) {
+            Poll::Pending => Poll::Ready(()),
+            Poll::Ready(_) => panic!("full queue should wait"),
+        })
+        .await;
+        started.send(()).unwrap();
+        request.await
+    });
+    timeout(Duration::from_secs(1), ready)
+        .await
+        .unwrap()
+        .unwrap();
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
+
+fn sender(capacity: usize) -> (Arc<OutgoingMessageSender>, mpsc::Receiver<OutgoingEnvelope>) {
+    let (tx, rx) = mpsc::channel(capacity);
+    (
+        Arc::new(OutgoingMessageSender::new(
+            tx,
+            AnalyticsEventsClient::disabled(),
+        )),
+        rx,
+    )
+}
+
+#[tokio::test]
+async fn clock_queue_wait_obeys_deadline_without_registration() {
+    let (outgoing, mut rx) = sender(1);
+    outgoing
+        .sender
+        .send(OutgoingEnvelope::Broadcast {
+            message: OutgoingMessage::Request(
+                ServerRequestPayload::CurrentTimeRead(CurrentTimeReadParams {
+                    thread_id: "queue-filler".to_string(),
+                })
+                .request_with_id(RequestId::Integer(-1)),
+            ),
+        })
+        .await
+        .unwrap();
+    let result = timeout(
+        Duration::from_secs(1),
+        outgoing.send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_millis(20),
+        ),
+    )
+    .await
+    .unwrap();
+    assert!(result.is_err());
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+    assert!(rx.recv().await.is_some());
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn clock_registration_wait_obeys_deadline_and_releases_queue_permit() {
+    let (outgoing, mut rx) = sender(1);
+    let callbacks = outgoing.request_id_to_callback.lock().await;
+    let result = timeout(
+        Duration::from_secs(1),
+        outgoing.send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_millis(20),
+        ),
+    )
+    .await
+    .unwrap();
+    assert!(result.is_err());
+    assert!(callbacks.is_empty());
+    drop(callbacks);
+    assert_eq!(outgoing.sender.capacity(), 1);
+    assert!(rx.try_recv().is_err());
+}
+
+#[tokio::test]
+async fn dropped_clock_response_owner_removes_only_its_callback() {
+    let (outgoing, mut rx) = sender(2);
+    let thread_id = ThreadId::new();
+    let first = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            thread_id,
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    let second = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            thread_id,
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    assert!(rx.recv().await.is_some());
+    drop(first);
+    assert_eq!(outgoing.request_id_to_callback.lock().await.len(), 1);
+    drop(second);
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
+
+#[tokio::test]
+async fn clock_response_timeout_removes_callback() {
+    let (outgoing, _rx) = sender(1);
+    let mut pending = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    assert!(
+        timeout(Duration::from_millis(20), &mut pending.response)
+            .await
+            .is_err()
+    );
+    drop(pending);
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
+
+#[tokio::test]
+async fn clock_cleanup_does_not_block_on_callback_lock() {
+    let (outgoing, _rx) = sender(1);
+    let pending = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    let callbacks = outgoing.request_id_to_callback.lock().await;
+    drop(pending);
+    assert_eq!(callbacks.len(), 1);
+    drop(callbacks);
+    timeout(Duration::from_secs(1), async {
+        while !outgoing.request_id_to_callback.lock().await.is_empty() {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .unwrap();
+}
+
+#[tokio::test]
+async fn clock_closed_queue_and_expired_deadline_do_not_register() {
+    let (outgoing, rx) = sender(1);
+    drop(rx);
+    assert!(
+        outgoing
+            .send_current_time_request(
+                ConnectionId(7),
+                ThreadId::new(),
+                Instant::now() + Duration::from_secs(1)
+            )
+            .await
+            .is_err()
+    );
+    assert!(
+        outgoing
+            .send_current_time_request(
+                ConnectionId(7),
+                ThreadId::new(),
+                Instant::now() - Duration::from_secs(1)
+            )
+            .await
+            .is_err()
+    );
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
+
+#[tokio::test]
+async fn clock_successful_response_uses_existing_callback_delivery() {
+    let (outgoing, mut rx) = sender(1);
+    let mut pending = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    let Some(OutgoingEnvelope::ToConnection {
+        connection_id,
+        message: OutgoingMessage::Request(request),
+        ..
+    }) = rx.recv().await
+    else {
+        panic!("expected current-time request")
+    };
+    let value = serde_json::json!({"currentTimeAt": 1790970000});
+    outgoing
+        .notify_client_response(connection_id, request.id().clone(), value.clone())
+        .await;
+    assert_eq!((&mut pending.response).await.unwrap().unwrap(), value);
+    drop(pending);
+    assert!(outgoing.request_id_to_callback.lock().await.is_empty());
+}
