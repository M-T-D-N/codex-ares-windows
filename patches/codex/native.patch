+#[cfg(windows)]
+async fn read_bridge_frame(stream: &mut TcpStream) -> serde_json::Value {
+    let length = stream.read_u32().await.expect("frame length") as usize;
+    let mut bytes = vec![0; length];
+    stream.read_exact(&mut bytes).await.expect("frame body");
+    serde_json::from_slice(&bytes).expect("JSON frame")
+}
+
+#[cfg(windows)]
+async fn write_bridge_frame(stream: &mut TcpStream, frame: serde_json::Value) {
+    let bytes = serde_json::to_vec(&frame).expect("JSON reply");
+    stream
+        .write_u32(bytes.len() as u32)
+        .await
+        .expect("write length");
+    stream.write_all(&bytes).await.expect("write reply");
+}
