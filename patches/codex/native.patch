+use super::*;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::SessionSource;
+
+fn recorded_for(frame: &serde_json::Value) -> serde_json::Value {
+    serde_json::json!({
+        "protocol": 4, "type": "recorded",
+        "threadId": frame["threadId"], "turnId": frame["turnId"],
+        "step": frame["step"], "connectionEpoch": frame["connectionEpoch"]
+    })
+}
+
+async fn jev_main_fixture_for(
+    alias: &str,
+    base: &str,
+) -> (Arc<Session>, Arc<TurnContext>, StepController) {
+    let (session, turn, mut controller) = luna_fixture_with_model(alias, base).await;
+    let control = crate::session::jev_main::JevMainControl::for_new_turn(
+        session.thread_id(),
+        turn.parent_thread_id,
+        &turn.session_source,
+        alias,
+        /*adaptive_enabled*/ true,
+        Some("luna-continuous-1"),
+        /*evaluator_process*/ false,
+    )
+    .expect("explicit Jev Main root selection");
+    controller.owner_id = control.owner_id;
+    controller.jev_main_mode = true;
+    turn.extension_data.insert(control);
+    (session, turn, controller)
+}
+
+async fn jev_main_fixture() -> (Arc<Session>, Arc<TurnContext>, StepController) {
+    jev_main_fixture_for(
+        codex_protocol::openai_models::ASTRA_JEV_MAIN_MODEL,
+        "gpt-6-astra",
+    )
+    .await
+}
+
+async fn confirm_test_capture(
+    session: &Session,
+    turn: &Arc<TurnContext>,
+    controller: &mut StepController,
+    applied: AppliedSettings,
+) {
+    let mut captured = StepContext::for_test(Arc::clone(turn));
+    Arc::get_mut(&mut captured)
+        .expect("unique test capture")
+        .settings = turn.current_settings.load_full();
+    controller
+        .confirm_luna(session, turn.as_ref(), &captured, applied)
+        .await
+        .expect("native capture confirmation");
+}
+
+async fn review_notice_count(session: &Session) -> usize {
+    let history = session.clone_history().await;
+    let items = crate::session::tests::raw_history_items(&history);
+    items
+        .iter()
+        .filter(|item| match item {
+            ResponseItem::Message { role, content, .. } if role == "user" => {
+                content.iter().any(|part| {
+                    matches!(part,
+                ContentItem::InputText { text } if text.contains("<jev_main_review>"))
+                })
+            }
+            _ => false,
+        })
+        .count()
+}
+
+#[tokio::test]
+async fn jev_review_then_main_request_skips_one_checkpoint_and_fresh_jev_resumes() {
+    let (session, turn, mut controller) = jev_main_fixture().await;
+    let mut server = attached_bridge(&mut controller).await;
+    let bridge = tokio::spawn(async move {
+        let first = read_bridge_frame(&mut server).await;
+        assert_eq!(first["type"], "checkpoint");
+        assert_eq!(first["step"], 1);
+        write_bridge_frame(
+            &mut server,
+            serde_json::json!({
+                "protocol": 4, "type": "review",
+                "threadId": first["threadId"], "turnId": first["turnId"],
+                "step": first["step"], "connectionEpoch": first["connectionEpoch"],
+                "reason": "semantic_defer", "episodeId": "episode-1"
+            }),
+        )
+        .await;
+        let reviewed = read_bridge_frame(&mut server).await;
+        assert_eq!(reviewed["type"], "applied");
+        assert_eq!(reviewed["effort"], "high");
+        write_bridge_frame(&mut server, recorded_for(&reviewed)).await;
+        // A checkpoint here would overwrite Main's queued next-generation choice.
+        let main = read_bridge_frame(&mut server).await;
+        assert_eq!(main["type"], "controlApplied");
+        assert_eq!(main["step"], 2);
+        assert_eq!(main["effort"], "xhigh");
+        assert_eq!(main["callId"], "call-1");
+        assert_eq!(main["confirmation"], "native_step_context_captured");
+        write_bridge_frame(&mut server, recorded_for(&main)).await;
+        let fresh = read_bridge_frame(&mut server).await;
+        assert_eq!(fresh["type"], "checkpoint");
+        assert_eq!(fresh["step"], 3);
+        assert_eq!(fresh["currentEffort"], "xhigh");
+        write_bridge_frame(&mut server, decision_for(&fresh, ReasoningEffort::Medium)).await;
+        let capture = read_bridge_frame(&mut server).await;
+        assert_eq!(capture["type"], "applied");
+        assert_eq!(capture["step"], 3);
+        write_bridge_frame(&mut server, recorded_for(&capture)).await;
+    });
+    let review = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("Review reply")
+        .expect("Review selects supported High");
+    assert_eq!(review.effort, ReasoningEffort::High);
+    assert!(controller.take_capture_fresh());
+    assert_eq!(review_notice_count(&session).await, 1);
+    confirm_test_capture(&session, &turn, &mut controller, review).await;
+    session
+        .queue_jev_main_effort(
+            &turn,
+            ReasoningEffort::XHigh,
+            "Need a deeper check of this boundary".to_string(),
+            "call-1".to_string(),
+        )
+        .await
+        .expect("one queued request");
+    assert!(
+        session
+            .queue_jev_main_effort(
+                &turn,
+                ReasoningEffort::Max,
+                "Duplicate request".to_string(),
+                "call-2".to_string()
+            )
+            .await
+            .is_err()
+    );
+    let queued = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("queued boundary")
+        .expect("queued effort applied");
+    assert_eq!(queued.effort, ReasoningEffort::XHigh);
+    assert!(!queued.from_bridge);
+    assert_eq!(queued.main_request_call_id.as_deref(), Some("call-1"));
+    assert!(controller.take_capture_fresh());
+    confirm_test_capture(&session, &turn, &mut controller, queued).await;
+    let fresh = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("fresh Jev boundary")
+        .expect("fresh Jev decision");
+    assert!(fresh.from_bridge);
+    assert_eq!(fresh.effort, ReasoningEffort::Medium);
+    assert_eq!(controller.sequence, 3);
+    assert_eq!(review_notice_count(&session).await, 1);
+    confirm_test_capture(&session, &turn, &mut controller, fresh).await;
+    bridge.await.expect("bridge exchange");
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
