+fn assistant_step(id: &str, end_turn: bool) -> Vec<Value> {
+    let mut completed = responses::ev_completed(id);
+    completed["response"]["end_turn"] = json!(end_turn);
+    vec![
+        responses::ev_response_created(id),
+        responses::ev_assistant_message(&format!("message-{id}"), "Synthetic continuation"),
+        completed,
+    ]
+}
+
+fn configuration_efforts(body: &Value) -> Vec<Value> {
+    body["input"]
+        .as_array()
+        .expect("request input")
+        .iter()
+        .filter(|item| item["type"] == "configuration_update")
+        .map(|item| item["reasoning"]["effort"].clone())
+        .collect()
+}
