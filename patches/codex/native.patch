--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/mcp_restart.rs
@@ -0,0 +1,291 @@
+use crate::function_tool::FunctionCallError;
+use crate::session::session::Session;
+use crate::tools::context::ToolInvocation;
+use crate::tools::context::ToolPayload;
+use crate::tools::registry::CoreToolRuntime;
+use crate::tools::registry::ToolExecutor;
+use codex_tools::JsonSchema;
+use codex_tools::JsonToolOutput;
+use codex_tools::ResponsesApiNamespace;
+use codex_tools::ResponsesApiNamespaceTool;
+use codex_tools::ResponsesApiTool;
+use codex_tools::ToolName;
+use codex_tools::ToolSpec;
+use serde::Deserialize;
+use serde_json::Value;
+use serde_json::json;
+use std::collections::BTreeMap;
+use std::sync::Arc;
+use std::time::Duration;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RestartArguments {}
+
+/// Native control path: remains callable when no MCP tool has loaded.
+pub struct McpRestartHandler;
+
+pub(crate) async fn restart_current_thread(
+    session: &Arc<Session>,
+) -> Result<Value, FunctionCallError> {
+    session.services.mcp_runtime.reconnect_on_next_refresh();
+    session.request_mcp_runtime_refresh();
+    session.refresh_mcp_if_dirty().await;
+    let config = session
+        .services
+        .mcp_runtime
+        .current_config()
+        .ok_or_else(|| {
+            FunctionCallError::RespondToModel(
+                "MCP refresh did not publish a configuration".to_string(),
+            )
+        })?;
+    let servers = codex_mcp::configured_mcp_servers(&config);
+    for name in servers.keys() {
+        session
+            .services
+            .mcp_runtime
+            .wait_for_server_startup(name)
+            .await;
+    }
+    let statuses = session
+        .services
+        .mcp_runtime
+        .connection_statuses(&config)
+        .await;
+    // Inspect a live binding, never a cached discovery-only catalog.
+    let binding = session
+        .services
+        .mcp_runtime
+        .current_binding()
+        .await
+        .ok_or_else(|| {
+            FunctionCallError::RespondToModel(
+                "MCP refresh did not publish a live binding".to_string(),
+            )
+        })?;
+    let mut results = BTreeMap::new();
+    let mut startup_succeeded = true;
+    for (name, status) in statuses {
+        startup_succeeded &= matches!(
+            status,
+            codex_protocol::mcp::McpServerConnectionStatus::Connected
+                | codex_protocol::mcp::McpServerConnectionStatus::Disabled
+        );
+        let tool_count = binding
+            .tools()
+            .iter()
+            .filter(|t| t.server_name == name)
+            .count();
+        results.insert(name, json!({"status": status, "tool_count": tool_count}));
+    }
+    Ok(json!({"scope": "current_thread", "servers": results,
+        "configuration_reloaded_from_disk": false, "startup_succeeded": startup_succeeded,
+        "verification": "MCP startup and live catalog only; call the required tool next"}))
+}
+
+impl ToolExecutor<ToolInvocation> for McpRestartHandler {
+    fn tool_name(&self) -> ToolName {
+        ToolName::namespaced("mcp_control", "restart")
+    }
+
+    fn spec(&self) -> ToolSpec {
+        ToolSpec::Namespace(ResponsesApiNamespace {
+            name: "mcp_control".to_string(),
+            description: "Recover this Codex thread's MCP connections without restarting Codex or the browser.".to_string(),
+            tools: vec![ResponsesApiNamespaceTool::Function(ResponsesApiTool {
+                name: "restart".to_string(),
+                description: "Explicitly reconnect the configured MCP clients of the current thread. Available even when MCP tools are missing. Keeps approved configuration and disabled servers, other threads, browser windows and tabs unchanged. Does not replay actions or reload configuration from disk. Never run in parallel with tool calls. Returns startup statuses, not website verification; follow with an actual required MCP tool call.".to_string(),
+                strict: false,
+                defer_loading: None,
+                parameters: JsonSchema::object(BTreeMap::new(), None, Some(false.into())),
+                output_schema: None,
+            })],
+        })
+    }
+
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where
+        ToolInvocation: 'a,
+    {
+        Box::pin(async move {
+            let ToolPayload::Function { arguments } = &invocation.payload else {
+                return Err(FunctionCallError::RespondToModel(
+                    "Unsupported MCP restart payload".to_string(),
+                ));
+            };
+            serde_json::from_str::<RestartArguments>(arguments).map_err(|e| {
+                FunctionCallError::RespondToModel(format!("Invalid MCP restart arguments: {e}"))
+            })?;
+            let result = tokio::select! {
+                _ = invocation.cancellation_token.cancelled() => {
+                    return Err(FunctionCallError::RespondToModel("MCP reconnect interrupted; inspect connection state before retry".to_string()));
+                }
+                result = tokio::time::timeout(Duration::from_secs(60), restart_current_thread(&invocation.session)) => {
+                    result.map_err(|_| FunctionCallError::RespondToModel("MCP reconnect exceeded 60 seconds; refresh may have partially completed. Inspect server status before retry".to_string()))??
+                }
+            };
+            Ok(Box::new(JsonToolOutput::with_success(
+                result.clone(),
+                result["startup_succeeded"].as_bool(),
+            )) as Box<dyn codex_tools::ToolOutput>)
+        })
+    }
+}
+
+impl CoreToolRuntime for McpRestartHandler {
+    fn is_builtin_control_tool(&self) -> bool {
+        true
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio_util::sync::CancellationToken;
+
+    #[test]
+    fn restart_rejects_unknown_targets_and_arbitrary_methods() {
+        assert!(serde_json::from_str::<RestartArguments>("{}").is_ok());
+        assert!(serde_json::from_str::<RestartArguments>(r#"{"method":"process/kill"}"#).is_err());
+        assert!(serde_json::from_str::<RestartArguments>(r#"{"threadId":"other"}"#).is_err());
+    }
+
+    #[tokio::test]
+    async fn restart_publishes_a_new_binding_without_replacing_the_turn() {
+        let (session, turn) = crate::session::tests::make_session_and_context().await;
+        let session = Arc::new(session);
+        let turn = Arc::new(turn);
+        let old = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let result = restart_current_thread(&session).await.unwrap();
+        assert_eq!(result["scope"], "current_thread");
+        assert_eq!(result["configuration_reloaded_from_disk"], false);
+        let next = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        assert!(Arc::ptr_eq(&old.turn, &next.turn));
+        assert!(!Arc::ptr_eq(&old.mcp, &next.mcp));
+    }
+    #[tokio::test]
+    #[ignore = "Requires explicit Workspace Neo stdio fixture paths; launches no browser"]
+    async fn restart_real_neo_stdio_preserves_other_thread_and_calls_new_client() {
+        use crate::tools::context::ToolCallSource;
+        use crate::turn_diff_tracker::TurnDiffTracker;
+        use codex_login::CodexAuth;
+        use tokio::sync::Mutex;
+        let python =
+            std::env::var("ARES_RECONNECT_TEST_PYTHON").expect("approved Python fixture path");
+        let bridge =
+            std::env::var("ARES_RECONNECT_TEST_BRIDGE").expect("approved Neo fixture path");
+        let create = || {
+            let python = python.clone();
+            let bridge = bridge.clone();
+            crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                CodexAuth::from_api_key("synthetic-reconnect-fixture"),
+                Vec::new(),
+                move |config| {
+                    config.mcp_servers.set(serde_json::from_value(json!({
+                        "browseros-neo": {"command": python, "args": ["-B", "-X", "utf8", bridge, "--client", "codex"], "startup_timeout_sec": 20.0}
+                    })).unwrap()).unwrap();
+                },
+            )
+        };
+        let (session, turn, _events) = create().await;
+        let (other, other_turn, _other_events) = create().await;
+        let old = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let other_step = other
+            .capture_step_context(Arc::clone(&other_turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let before = session
+            .services
+            .mcp_runtime
+            .current_binding_for_call("browseros-neo")
+            .await
+            .unwrap();
+        let other_before = other
+            .services
+            .mcp_runtime
+            .current_binding_for_call("browseros-neo")
+            .await
+            .unwrap();
+        assert!(
+            before
+                .tool_info("browseros-neo", "workspace_cleanup")
+                .is_some()
+        );
+        let output = McpRestartHandler
+            .handle(ToolInvocation {
+                session: Arc::clone(&session),
+                turn: Arc::clone(&turn),
+                step_context: Arc::clone(&old),
+                environments: Default::default(),
+                cancellation_token: CancellationToken::new(),
+                tracker: Arc::new(Mutex::new(TurnDiffTracker::new())),
+                call_id: "native-reconnect-fixture".to_string(),
+                tool_name: McpRestartHandler.tool_name(),
+                source: ToolCallSource::Direct,
+                payload: ToolPayload::Function {
+                    arguments: "{}".to_string(),
+                },
+            })
+            .await
+            .unwrap();
+        let result = output.code_mode_result(&ToolPayload::Function {
+            arguments: "{}".to_string(),
+        });
+        assert_eq!(result["servers"]["browseros-neo"]["status"], "connected");
+        assert!(
+            result["servers"]["browseros-neo"]["tool_count"]
+                .as_u64()
+                .unwrap()
+                >= 20
+        );
+        let after = session
+            .services
+            .mcp_runtime
+            .current_binding_for_call("browseros-neo")
+            .await
+            .unwrap();
+        assert!(!Arc::ptr_eq(&before, &after));
+        let other_after = other
+            .services
+            .mcp_runtime
+            .current_binding_for_call("browseros-neo")
+            .await
+            .unwrap();
+        assert!(Arc::ptr_eq(&other_before, &other_after));
+        let task_id = session.thread_id.to_string();
+        let call = after
+            .prepare_call("browseros-neo", "workspace_cleanup")
+            .unwrap();
+        let bound = call
+            .call(
+                Some(json!({"action":"begin", "task_id":task_id})),
+                None,
+                Some(Duration::from_secs(10)),
+            )
+            .await
+            .unwrap();
+        assert_ne!(bound.is_error, Some(true));
+        let checked = call
+            .call(
+                Some(json!({"action":"check", "task_id":task_id})),
+                None,
+                Some(Duration::from_secs(10)),
+            )
+            .await
+            .unwrap();
+        assert_ne!(checked.is_error, Some(true));
+        println!("RECONNECT_FIXTURE_TASK_ID={task_id}");
+        println!("RECONNECT_FIXTURE_RESULT={result}");
+        drop(other_step);
+    }
+}
