+        Self { reason }
+    }
+}
+
+impl ContextualUserFragment for JevMainReviewNotice {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("jev_main.review_notice".to_owned())
+    }
+
+    fn role(&self) -> &'static str {
+        "user"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
+        ("<jev_main_review>", "</jev_main_review>")
+    }
+
+    fn body(&self) -> ContentItem {
+        ContentItem::InputText {
+            text: format!(
+                "No adaptive effort recommendation was adopted for this generation ({reason}). Continue the current task in this turn. If your next generation needs a different supported effort, call ares_request_effort with a short public reason as a separate tool call. That request only queues the next generation. Existing permission and tool approvals still apply; do not pause solely for an allowed effort change.",
+                reason = self.reason
+            ),
+        }
+    }
+}
