+use super::*;
+
+#[cfg(windows)]
+#[path = "jev_main_tests.rs"]
+mod jev_main_tests;
+#[cfg(windows)]
+use crate::session::tests::HeldStepTask;
+use crate::session::tests::make_session_and_context;
+use crate::session::tests::update_selected_settings_for_test;
+use crate::session::tests::update_turn_settings_for_test;
+#[cfg(windows)]
+use crate::state::TaskKind;
+use codex_protocol::openai_models::ASTRA_JEV_MODEL;
+use codex_protocol::openai_models::ModelInfo;
+#[cfg(windows)]
+use codex_protocol::openai_models::ReasoningEffortPreset;
+#[cfg(windows)]
+use codex_protocol::protocol::ThreadSource;
+#[cfg(windows)]
+use codex_protocol::protocol::TurnAbortReason;
+#[cfg(windows)]
+use tokio::net::TcpListener;
+#[cfg(windows)]
+use tokio::sync::Notify;
+
+#[tokio::test]
+async fn ordinary_astra_prompt_bypasses_bridge_without_any_connection() {
+    let (session, mut turn) = make_session_and_context().await;
+    update_turn_settings_for_test(&mut turn, |settings| {
+        settings.model_info = Arc::new(ModelInfo {
+            slug: ASTRA_JEV_BASE_MODEL.to_string(),
+            ..settings.model_info.as_ref().clone()
+        });
+        update_selected_settings_for_test(settings, |selected| {
+            selected.collaboration_mode.settings.model = ASTRA_JEV_BASE_MODEL.to_string();
+        });
+    });
+    let mut controller = StepController::new(
+        &turn,
+        &[UserInput::Text {
+            text: String::new(),
+            text_elements: Vec::new(),
+        }],
+    );
+    assert!(
+        controller
+            .before_sampling(&session, &turn)
+            .await
+            .unwrap()
