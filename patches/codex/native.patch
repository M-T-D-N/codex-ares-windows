+        message: "PRIVATE fixture content must not enter trace".to_owned(),
+    });
+    assert_eq!(result, ("invalid_audio_input", None));
+}
diff --git a/codex-rs/core/src/session/decision_context.rs b/codex-rs/core/src/session/decision_context.rs
new file mode 100644
index 0000000000000000000000000000000000000000..88e211b8fd5c97ffbc587782d3c6a34f3f849886
--- /dev/null
+++ b/codex-rs/core/src/session/decision_context.rs
@@ -0,0 +1,309 @@
+//! Text visible to a supervisor: user input, published commentary/summaries, and
+//! paired recent tools. Opaque reasoning and media never enter this projection.
+
+use std::collections::HashMap;
+
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use serde::Serialize;
+
+use crate::context_manager::is_user_turn_boundary;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct DecisionContext {
+    schema: &'static str,
+    scope: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    task_source: Option<TaskSource>,
+    original_turn_prompt: String,
+    latest_user_prompt: String,
+    // Retained text match only, not a stable accepted-input identity. Compaction
+    // can preserve an older identical prompt; the evaluator must not infer authority.
+    latest_user_prompt_text_match_history_index: Option<usize>,
+    prior_user_prompts: Vec<String>,
+    public_notes: Vec<PublicNote>,
+    recent_tool_calls: Vec<ToolExchange>,
+    omitted_older_tool_calls: usize,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct TaskSource {
+    original_task: &'static str,
+    latest_user_prompt: &'static str,
+}
+impl DecisionContext {
+    pub(super) fn with_task_sources(
+        mut self,
+        original: &'static str,
+        latest: &'static str,
+    ) -> Self {
+        self.task_source = Some(TaskSource {
+            original_task: original,
+            latest_user_prompt: latest,
+        });
+        self
+    }
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct PublicNote {
+    history_index: usize,
+    kind: &'static str,
+    phase: Option<MessagePhase>,
+    text: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ToolExchange {
+    history_index: usize,
+    call_id: String,
+    name: String,
+    namespace: Option<String>,
+    input: String,
+    outputs: Vec<ToolResult>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ToolResult {
+    history_index: usize,
+    text: Option<String>,
+    success: Option<bool>,
+    native_token_limit: Option<usize>,
+}
+
+pub(super) fn decision_context(
+    items: &[ResponseItemEnvelope],
+    original_turn_prompt: &str,
+    latest_user_prompt: &str,
+) -> DecisionContext {
+    let mut calls = Vec::new();
+    let mut public_notes = Vec::new();
+    let mut prior_user_prompts = Vec::new();
+    let mut latest_user_prompt_text_match_history_index = None;
+    for (index, envelope) in items.iter().enumerate() {
+        match &envelope.item {
+            ResponseItem::Message {
+                role,
+                content,
+                phase,
+                ..
+            } if role == "assistant" || role == "user" => {
+                let text = content
+                    .iter()
+                    .filter_map(|part| match part {
+                        ContentItem::InputText { text } | ContentItem::OutputText { text, .. } => {
+                            Some(text.as_str())
+                        }
+                        ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => None,
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                if role == "user" && is_user_turn_boundary(&envelope.item) {
+                    // A newer nonmatching user boundary invalidates an older match.
+                    latest_user_prompt_text_match_history_index =
+                        (!text.is_empty() && text == latest_user_prompt).then_some(index);
+                }
+                if role == "assistant" && !text.is_empty() {
+                    public_notes.push(PublicNote {
+                        history_index: index,
+                        kind: "assistant_message",
+                        phase: phase.clone(),
+                        text,
+                    });
+                } else if role == "user"
+                    && is_user_turn_boundary(&envelope.item)
+                    && text != latest_user_prompt
+                    && text != original_turn_prompt
+                    && !text.is_empty()
+                {
+                    prior_user_prompts.push(text);
+                }
+            }
+            ResponseItem::Reasoning { summary, .. } => {
+                let text = summary
+                    .iter()
+                    .map(|part| match part {
+                        ReasoningItemReasoningSummary::SummaryText { text } => text.as_str(),
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                if !text.is_empty() {
+                    public_notes.push(PublicNote {
+                        history_index: index,
+                        kind: "reasoning_summary",
+                        phase: None,
+                        text,
+                    });
+                }
+            }
+            ResponseItem::FunctionCall { .. } | ResponseItem::CustomToolCall { .. } => {
+                calls.push(index)
+            }
+            _ => {}
+        }
+    }
+    let omitted_older_tool_calls = calls.len().saturating_sub(6);
+    let mut recent_tool_calls = calls
+        .into_iter()
+        .skip(omitted_older_tool_calls)
+        .map(|index| {
+            let (call_id, name, namespace, input) = match &items[index].item {
+                ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    arguments,
+                    ..
+                } => (call_id, name, namespace, arguments),
+                ResponseItem::CustomToolCall {
+                    call_id,
+                    name,
+                    namespace,
+                    input,
+                    ..
+                } => (call_id, name, namespace, input),
+                _ => unreachable!("selected a non-tool history item"),
+            };
+            ToolExchange {
+                history_index: index,
+                call_id: call_id.clone(),
+                name: name.clone(),
+                namespace: namespace.clone(),
+                input: input.clone(),
+                outputs: Vec::new(),
+            }
+        })
+        .collect::<Vec<_>>();
+    let positions = recent_tool_calls
+        .iter()
+        .enumerate()
+        .map(|(index, call)| (call.call_id.clone(), index))
+        .collect::<HashMap<_, _>>();
+    for (index, envelope) in items.iter().enumerate() {
+        let (call_id, output) = match &envelope.item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput {
+                call_id, output, ..
+            } => (call_id, output),
+            _ => continue,
+        };
+        if let Some(&position) = positions.get(call_id) {
+            recent_tool_calls[position].outputs.push(ToolResult {
+                history_index: index,
+                text: output.body.to_text(),
+                success: output.success,
+                native_token_limit: envelope
+                    .metadata
+                    .as_ref()
+                    .and_then(|metadata| metadata.history_truncation_token_limit),
+            });
+        }
+    }
+    DecisionContext {
+        schema: "CODEX_STEP_CONTROLLER_CONTEXT_V3",
+        scope: "native_retained_history",
+        task_source: None,
+        original_turn_prompt: original_turn_prompt.to_owned(),
+        latest_user_prompt: latest_user_prompt.to_owned(),
+        latest_user_prompt_text_match_history_index,
+        prior_user_prompts,
+        public_notes,
+        recent_tool_calls,
+        omitted_older_tool_calls,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn message(role: &str, text: &str) -> ResponseItemEnvelope {
+        ResponseItem::Message {
+            encrypted_content: None,
+            status: None,
+            id: None,
+            role: role.to_owned(),
+            content: vec![ContentItem::InputText {
+                text: text.to_owned(),
+            }],
+            internal_chat_message_metadata_passthrough: None,
+            phase: None,
+        }
+        .into()
+    }
+
+    #[test]
+    fn retained_match_partitions_notes_without_changing_current_requests() {
+        let items = vec![
+            message("assistant", "proposal"),
+            message("user", "승인"),
+            message("assistant", "implementation verified"),
+        ];
+        let context = decision_context(&items, "original exact task", "승인");
+        assert_eq!(context.latest_user_prompt_text_match_history_index, Some(1));
+        assert_eq!(context.original_turn_prompt, "original exact task");
+        assert_eq!(context.latest_user_prompt, "승인");
+        assert_eq!(context.public_notes[0].history_index, 0);
+        assert_eq!(context.public_notes[1].history_index, 2);
+    }
+
+    #[test]
+    fn last_true_user_boundary_wins_and_nonmatching_boundary_invalidates_old_match() {
+        let mut items = vec![
+            message("user", "승인"),
+            message("assistant", "new proposal"),
+            message("user", "승인"),
+        ];
+        assert_eq!(
+            decision_context(&items, "task", "승인").latest_user_prompt_text_match_history_index,
+            Some(2)
+        );
+        items.push(message("user", "different correction"));
+        assert_eq!(
+            decision_context(&items, "task", "승인").latest_user_prompt_text_match_history_index,
+            None
+        );
+    }
+
+    #[test]
+    fn absent_current_input_and_goal_continuation_do_not_invent_a_boundary() {
+        let items = vec![
+            message("user", "old task"),
+            message("assistant", "old progress"),
+        ];
+        let goal = "<goal_context>Continue exact goal</goal_context>";
+        let context = decision_context(&items, goal, goal);
+        assert_eq!(context.latest_user_prompt_text_match_history_index, None);
+        assert_eq!(context.original_turn_prompt, goal);
+        assert_eq!(context.latest_user_prompt, goal);
+        assert!(
+            serde_json::to_value(context).unwrap()["latestUserPromptTextMatchHistoryIndex"]
+                .is_null()
+        );
+    }
+
+    #[test]
+    fn compacted_identical_old_input_is_only_a_text_match_not_input_identity() {
+        let items = vec![
+            message("user", "승인"),
+            message("assistant", "older proposal"),
+        ];
+        let value = serde_json::to_value(decision_context(&items, "task", "승인")).unwrap();
+        // No stable accepted-input ID exists in this projection. Name that limitation
+        // explicitly instead of claiming the retained match proves the current event.
+        assert_eq!(value["latestUserPromptTextMatchHistoryIndex"], 0);
+        assert!(value.get("latestUserPromptHistoryIndex").is_none());
+    }
+}
