+        .expect(1)
+        .mount(&server)
+        .await;
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    let client = pilot_http_client(&server, None);
+    let mut stream = pilot_http_dispatch(
+        &client,
+        crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+    )
+    .await?;
+    let mut failed = false;
+    while let Some(event) = stream.next().await {
+        failed |= event.is_err();
+    }
+    drop(stream);
+    assert!(failed);
+    // Upstream maps EOF to Stream and this provider failed event to Retryable.
+    let rows = assert_one_pilot_http_terminal(
+        &path,
+        "response_failed",
+        Some(if failed_event { "retryable" } else { "stream" }),
+        Some(200),
+    );
+    assert_eq!(rows.last().unwrap()["stage"], "stream");
+    Ok(())
+}
