+            host_task_delivery(&turn.sub_id, "codex_app", "send_message_to_thread", text);
+        let TurnInput::FunctionCallOutput(envelope) = &mut item else {
+            unreachable!()
+        };
+        match invalid {
+            "no_metadata" => envelope.metadata = None,
+            "message_id" => {
+                envelope
+                    .metadata
+                    .as_mut()
+                    .unwrap()
+                    .sender_user_messages
+                    .as_mut()
+                    .unwrap()
+                    .receiver_message_id = "another-delivery".to_owned()
+            }
+            "turn_id" => {
+                envelope
+                    .metadata
+                    .as_mut()
+                    .unwrap()
+                    .sender_user_messages
+                    .as_mut()
+                    .unwrap()
+                    .receiver_turn_id = "another-turn".to_owned()
+            }
+            "response_item" => {}
+            _ => {
+                let codex_protocol::models::ResponseItem::FunctionCallOutput {
+                    id,
+                    call_id,
+                    name,
+                    namespace,
+                    output,
+                    ..
+                } = &mut envelope.item
+                else {
+                    unreachable!()
+                };
+                match invalid {
+                    "namespace" => *namespace = Some("untrusted_tool".to_owned()),
+                    "name" => *name = Some("read_file".to_owned()),
