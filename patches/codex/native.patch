+#[cfg(windows)]
+async fn attached_bridge(controller: &mut StepController) -> TcpStream {
+    let listener = TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0))
+        .await
+        .expect("loopback listener");
+    let client = TcpStream::connect(listener.local_addr().expect("listener address"))
+        .await
+        .expect("loopback client");
+    let (server, _) = listener.accept().await.expect("accepted connection");
+    controller.connection = Some(client);
+    controller.connection_epoch = Some(uuid::Uuid::new_v4());
+    server
+}
+
+#[cfg(windows)]
+async fn read_bridge_frame(stream: &mut TcpStream) -> serde_json::Value {
+    let length = stream.read_u32().await.expect("frame length") as usize;
+    let mut bytes = vec![0; length];
+    stream.read_exact(&mut bytes).await.expect("frame body");
+    serde_json::from_slice(&bytes).expect("JSON frame")
+}
+
+#[cfg(windows)]
+async fn write_bridge_frame(stream: &mut TcpStream, frame: serde_json::Value) {
+    let bytes = serde_json::to_vec(&frame).expect("JSON reply");
+    stream
+        .write_u32(bytes.len() as u32)
+        .await
+        .expect("write length");
+    stream.write_all(&bytes).await.expect("write reply");
+}
+
+#[cfg(windows)]
+fn decision_for(checkpoint: &serde_json::Value, effort: ReasoningEffort) -> serde_json::Value {
+    serde_json::json!({
+        "protocol": 4, "type": "decision", "threadId": checkpoint["threadId"],
+        "turnId": checkpoint["turnId"], "step": checkpoint["step"],
+        "connectionEpoch": checkpoint["connectionEpoch"],
+        "effort": effort, "leaseSteps": 1, "evaluatorMs": 3
+    })
+}
