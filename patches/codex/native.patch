+//! Bounded host notice for a Jev decision deferred to the current Main.
+
+use super::ContextualUserFragment;
+use codex_protocol::models::ContentItemKind;
+
+pub(crate) struct JevMainReviewNotice {
+    reason: &'static str,
+}
+
+impl JevMainReviewNotice {
+    pub(crate) fn new(reason: &'static str) -> Self {
+        Self { reason }
+    }
+}
+
+impl ContextualUserFragment for JevMainReviewNotice {
+    fn content_kind(&self) -> ContentItemKind {
+        ContentItemKind("jev_main.review_notice".to_owned())
+    }
+
+    fn role(&self) -> &'static str {
+        "user"
+    }
+
+    fn markers(&self) -> (&'static str, &'static str) {
+        Self::type_markers()
+    }
+
+    fn type_markers() -> (&'static str, &'static str) {
