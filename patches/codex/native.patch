+#[cfg(windows)]
+#[test_case::test_case("manual"; "manual effort changed during bridge await")]
+#[test_case::test_case("cancel"; "task cancelled during bridge await")]
+#[test_case::test_case("replace"; "same turn context reused during bridge await")]
+#[tokio::test]
+async fn luna_late_bridge_reply_cannot_publish_after_owner_change(change: &str) {
+    let (session, turn, mut controller) = luna_fixture().await;
+    let mut server = attached_bridge(&mut controller).await;
+    let decision_session = Arc::clone(&session);
+    let decision_turn = Arc::clone(&turn);
+    let pending = tokio::spawn(async move {
+        let result = controller
+            .before_sampling_luna(&decision_session, &decision_turn)
+            .await;
+        (controller, result)
+    });
+    // Reading the real frame proves snapshot capture happened before the change.
+    let checkpoint = tokio::time::timeout(Duration::from_secs(2), read_bridge_frame(&mut server))
+        .await
+        .expect("checkpoint sent before owner change");
+    match change {
+        "manual" => {
+            assert!(matches!(
+                session
+                    .apply_turn_settings(
+                        &turn.sub_id,
+                        TurnSettingsUpdate {
+                            effort: Some(Some(ReasoningEffort::High)),
+                            ..Default::default()
+                        },
+                    )
+                    .await,
+                TurnSettingsUpdateOutcome::Applied
+            ));
+        }
+        "cancel" => session.abort_all_tasks(TurnAbortReason::Replaced).await,
+        "replace" => {
+            session
+                .spawn_task(
+                    Arc::clone(&turn),
+                    Vec::new(),
+                    HeldStepTask {
+                        kind: TaskKind::Compact,
+                        finish: Arc::new(Notify::new()),
+                    },
+                )
+                .await;
+        }
+        _ => panic!("unrecognized test case"),
+    }
+    let expected = turn.next_step_settings.load_full();
+    write_bridge_frame(&mut server, decision_for(&checkpoint, ReasoningEffort::Max)).await;
+    let (controller, result) = tokio::time::timeout(Duration::from_secs(2), pending)
+        .await
+        .expect("late reply finishes without waiting for another request")
+        .expect("decision task");
+    if change == "cancel" {
+        assert!(
+            result.is_err(),
+            "cancelled task must stop the sampling path"
+        );
+    } else {
+        assert!(
+            matches!(result, Ok(None)),
+            "stale recommendation must be rejected"
+        );
+    }
+    assert!(Arc::ptr_eq(&turn.next_step_settings.load_full(), &expected));
+    assert!(
+        controller.connection.is_none(),
+        "stale bridge must be detached"
+    );
+    assert!(
+        controller.last_effort.is_none(),
+        "no captured-effort confirmation"
+    );
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
