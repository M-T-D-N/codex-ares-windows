+    assert_eq!(manual.guard.accepted_input_revision, input_revision);
+    assert_eq!(manual.guard.window_ids, windows);
+    session.advance_auto_compact_window().await;
+    let compacted = session
+        .snapshot_step_decision(turn.as_ref(), "original", "latest")
+        .await
+        .expect("compacted basis");
+    assert_ne!(compacted.guard.window_ids, windows);
+    assert_eq!(compacted.guard.external_settings_revision, 3);
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
