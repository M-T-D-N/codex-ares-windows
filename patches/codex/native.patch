+    );
+    let automatic = session
+        .snapshot_step_decision(turn.as_ref(), "original", "latest")
+        .await
+        .expect("automatic basis");
+    assert_eq!(automatic.guard.external_settings_revision, 0);
+    assert_eq!(automatic.guard.accepted_input_revision, input_revision);
+    assert_eq!(automatic.guard.window_ids, windows);
