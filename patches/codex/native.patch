+            create_mock_responses_server_repeating_assistant("Synthetic RPC complete").await;
+        Self::with_provider(alias, base, provider, ProviderMode::UnsupportedHttp).await
+    }
+    async fn with_provider(
+        alias: &str,
+        base: &str,
+        provider: MockServer,
+        mode: ProviderMode<'_>,
+    ) -> Result<Self> {
+        let home = TempDir::new()?;
