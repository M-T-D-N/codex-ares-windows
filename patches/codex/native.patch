+    drop(permission_guard);
+    let decision = match response {
+        Ok(Ok(value)) => match serde_json::from_value::<FileChangeRequestApprovalResponse>(value) {
+            Ok(response) => map_file_change_approval_decision(response.decision),
+            Err(err) => {
