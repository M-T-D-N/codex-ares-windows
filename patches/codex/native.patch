+            .with_model(alias)
+            // Use the Ares launch default and upstream effort-update default, not fixture flags.
+            .with_root_config("model_reasoning_effort = \"medium\"");
+        let supported_updates = !matches!(mode, ProviderMode::UnsupportedHttp);
+        let config = match mode {
+            ProviderMode::UnsupportedHttp => config,
+            ProviderMode::SupportedHttp => config
+                .with_provider_name("OpenAI")
+                .with_provider_config("supports_websockets = false"),
+            ProviderMode::SupportedWebsocket(url) => config
+                .with_provider_name("OpenAI")
+                .with_provider_base_url(url)
+                .with_provider_config("supports_websockets = true"),
+        };
+        config.write(home.path())?;
+        let mut model = model_info_from_slug(base);
+        model.use_responses_lite = true;
+        model.supports_reasoning_effort_updates = supported_updates;
+        model.context_window = Some(272_000);
+        model.effective_context_window_percent = 95;
+        model.supported_reasoning_levels = [
+            ReasoningEffort::Medium,
+            ReasoningEffort::High,
+            ReasoningEffort::XHigh,
+            ReasoningEffort::Max,
+        ]
+        .into_iter()
+        .map(|effort| ReasoningEffortPreset {
