+            codex_app_server_protocol::ReasoningEffortUpdatedNotification {
+                thread_id: "thread-1".to_string(),
+                turn_id: "turn-1".to_string(),
+                from_effort: Some("low".to_string()),
+                to_effort: "high".to_string(),
+                step: 3,
+                lease_steps: 2,
+                evaluator_ms: 321,
+            },
+        ),
+        /*replay_kind*/ None,
+    );
+    assert_eq!(
+        chat.current_reasoning_effort(),
+        Some(ReasoningEffortConfig::High)
+    );
+    let cells = drain_insert_history(&mut rx);
+    assert_eq!(cells.len(), 1);
+    insta::assert_snapshot!(lines_to_single_string(&cells[0]), @r"
+Ares  LOW → HIGH  ✓ APPLIED
+     Step 3 · next 2 generation(s) · 321 ms
+");
+}
diff --git a/codex-rs/tui/src/chatwidget/tests/popups_and_settings.rs b/codex-rs/tui/src/chatwidget/tests/popups_and_settings.rs
index d64fecc..99142c1 100644
--- a/codex-rs/tui/src/chatwidget/tests/popups_and_settings.rs
+++ b/codex-rs/tui/src/chatwidget/tests/popups_and_settings.rs
@@ -4418,3 +4418,40 @@ async fn account_change_dismisses_the_previous_app_directory_snapshot() {
         format!("Before account change:\n{before}\n\nAfter account change:\n{after}")
     );
 }
+
+#[tokio::test]
+async fn jev_model_picker_selects_automatic_effort_without_fixed_effort_popup() {
+    for entry in codex_protocol::openai_models::ARES_SELECTIONS {
+        let alias = entry.alias;
+        let name = entry.display_name;
+        let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.5")).await;
+        let mut preset = get_available_model(&chat, "gpt-5.5");
+        preset.id = alias.to_string();
+        preset.model = preset.id.clone();
+        preset.display_name = name.to_string();
+        preset.description = "Ares with automatic effort from Luna High".to_string();
+        preset.is_default = false;
+        chat.open_model_popup_with_presets(vec![preset]);
+        let popup = render_bottom_popup(&chat, 90);
+        if alias == codex_protocol::openai_models::ASTRA_JEV_MODEL {
+            assert_chatwidget_snapshot!("jev_model_selection", popup);
+        }
+        assert!(popup.contains(name));
+        chat.handle_key_event(KeyEvent::from(KeyCode::Enter));
+        while let Ok(event) = rx.try_recv() {
+            if let AppEvent::OpenReasoningPopup { model } = event {
+                chat.open_reasoning_popup(model);
+                break;
+            }
+        }
+        let mut selection = None;
+        while let Ok(event) = rx.try_recv() {
+            if let AppEvent::PersistModelSelection { model, effort } = event {
+                selection = Some((model, effort));
+            }
+        }
+        assert_eq!(selection, Some((alias.to_string(), None)));
+        assert!(!render_bottom_popup(&chat, 90).contains("Select Reasoning"));
+        assert_eq!(crate::model_catalog::model_display_name(alias), name);
+    }
+}
