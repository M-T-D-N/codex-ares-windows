+    let (session, turn, _) = luna_fixture().await;
+    let text = "<codex_delegation><source_thread_id>00000000-0000-4000-8000-000000000001</source_thread_id><input>quoted task</input></codex_delegation>";
+    for invalid in [
+        "no_metadata",
+        "namespace",
+        "name",
+        "message_id",
+        "turn_id",
+        "no_id",
+        "call_id",
+        "empty",
+        "whitespace",
+        "structured",
+        "response_item",
+    ] {
+        let mut item =
+            host_task_delivery(&turn.sub_id, "codex_app", "send_message_to_thread", text);
+        let TurnInput::FunctionCallOutput(envelope) = &mut item else {
+            unreachable!()
+        };
+        match invalid {
+            "no_metadata" => envelope.metadata = None,
+            "message_id" => {
+                envelope
+                    .metadata
+                    .as_mut()
+                    .unwrap()
+                    .sender_user_messages
+                    .as_mut()
+                    .unwrap()
+                    .receiver_message_id = "another-delivery".to_owned()
+            }
+            "turn_id" => {
+                envelope
+                    .metadata
+                    .as_mut()
+                    .unwrap()
+                    .sender_user_messages
+                    .as_mut()
+                    .unwrap()
+                    .receiver_turn_id = "another-turn".to_owned()
+            }
+            "response_item" => {}
+            _ => {
+                let codex_protocol::models::ResponseItem::FunctionCallOutput {
+                    id,
+                    call_id,
+                    name,
+                    namespace,
+                    output,
+                    ..
+                } = &mut envelope.item
+                else {
+                    unreachable!()
+                };
+                match invalid {
+                    "namespace" => *namespace = Some("untrusted_tool".to_owned()),
+                    "name" => *name = Some("read_file".to_owned()),
+                    "no_id" => *id = None,
+                    "call_id" => *call_id = Some("tool-call".to_owned()),
+                    "empty" => {
+                        *output = codex_protocol::models::FunctionCallOutputPayload::from_text(
+                            String::new(),
+                        )
+                    }
+                    "whitespace" => {
+                        *output = codex_protocol::models::FunctionCallOutputPayload::from_text(
+                            " \n\t ".to_owned(),
+                        )
+                    }
+                    "structured" => {
+                        *output =
+                            codex_protocol::models::FunctionCallOutputPayload::from_content_items(
+                                vec![],
+                            )
+                    }
+                    _ => unreachable!(),
+                }
+            }
+        }
+        if invalid == "response_item" {
+            let TurnInput::FunctionCallOutput(envelope) = item else {
+                unreachable!()
+            };
+            item = TurnInput::ResponseItem(envelope);
+        }
+        let mut controller = StepController::new(&turn, &[]);
+        controller.luna_continuous_mode = true;
+        controller.record_initial_turn_input(&[item], &turn.sub_id);
+        assert!(controller.original_prompt.is_empty(), "{invalid}");
+        assert!(controller.latest_prompt.is_empty(), "{invalid}");
+    }
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
