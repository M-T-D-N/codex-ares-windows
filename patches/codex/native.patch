+/// Local adaptive-effort selection. Requests still use the underlying model.
+pub const ASTRA_JEV_MODEL: &str = "Astra-Jev";
+pub const ASTRA_JEV_BASE_MODEL: &str = "gpt-6-astra";
+pub const ASTRA_JEV_MAIN_MODEL: &str = "Astra-Jev-Main";
