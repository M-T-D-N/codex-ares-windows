+#[tokio::test]
+async fn pilot_http_stream_consumer_cancellation_precedes_late_completed_event()
+-> anyhow::Result<()> {
+    use tokio::io::AsyncReadExt;
+    use tokio::io::AsyncWriteExt;
+
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await?;
+    let address = listener.local_addr()?;
+    let (release_completed, completion_released) = tokio::sync::oneshot::channel::<()>();
+    let server = tokio_util::task::AbortOnDropHandle::new(tokio::spawn(async move {
+        let (mut socket, _) = listener.accept().await?;
+        let mut request = Vec::new();
+        let mut buffer = [0_u8; 4096];
+        let header_end = loop {
+            let count = socket.read(&mut buffer).await?;
+            anyhow::ensure!(count != 0, "request ended before its headers");
+            request.extend_from_slice(&buffer[..count]);
+            if let Some(position) = request.windows(4).position(|part| part == b"\r\n\r\n") {
+                break position + 4;
+            }
+            anyhow::ensure!(
+                request.len() <= 64 * 1024,
+                "fixture request headers exceed bound"
+            );
+        };
+        let headers = std::str::from_utf8(&request[..header_end])?;
+        let content_length = headers
+            .lines()
+            .filter_map(|line| line.split_once(':'))
+            .find(|(name, _)| name.eq_ignore_ascii_case("content-length"))
+            .map(|(_, value)| value.trim().parse::<usize>())
+            .transpose()?
+            .unwrap_or(0);
+        anyhow::ensure!(
+            content_length <= 1024 * 1024,
+            "fixture request body exceeds bound"
+        );
+        while request.len() < header_end + content_length {
+            let count = socket.read(&mut buffer).await?;
+            anyhow::ensure!(count != 0, "request ended before its body");
+            request.extend_from_slice(&buffer[..count]);
+        }
+        socket.write_all(b"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n").await?;
+        let created =
+            "data: {\"type\":\"response.created\",\"response\":{\"id\":\"pilot-response\"}}\n\n";
+        socket
+            .write_all(format!("{:x}\r\n{created}\r\n", created.len()).as_bytes())
+            .await?;
+        socket.flush().await?;
+        // The client must observe Created and drop its consumer before this event is released.
+        if completion_released.await.is_ok() {
+            let completed = "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"pilot-response\"}}\n\n";
+            // Cancellation may already have closed the socket. Either late-write result is valid.
+            let _ = socket
+                .write_all(format!("{:x}\r\n{completed}\r\n0\r\n\r\n", completed.len()).as_bytes())
+                .await;
+            let _ = socket.shutdown().await;
+        }
+        anyhow::Ok(())
+    }));
+    let mut info =
+        create_oss_provider_with_base_url(&format!("http://{address}/v1"), WireApi::Responses);
+    info.supports_websockets = false;
+    info.request_max_retries = Some(0);
+    let mut client = test_model_client(SessionSource::Cli);
+    Arc::get_mut(&mut client.state).unwrap().provider = create_model_provider(info, None);
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    let mut stream = tokio::time::timeout(
+        Duration::from_secs(5),
+        pilot_http_dispatch(
+            &client,
+            crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+        ),
+    )
+    .await??;
+    // The API emits its default RateLimits snapshot before reading response.created.
+    let created_response_id = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let event = stream
+                .next()
+                .await
+                .expect("server should deliver Created before cancellation")?;
+            match event {
+                ResponseEvent::Created { response_id } => return anyhow::Ok(response_id),
+                ResponseEvent::RateLimits(_) => {}
+                _ => anyhow::bail!("unexpected event before the controlled Created admission"),
+            }
+        }
+    })
+    .await??;
+    assert_eq!(created_response_id.as_deref(), Some("pilot-response"));
+    drop(stream);
+    tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            let observed = std::fs::read_to_string(&path).unwrap_or_default();
+            if observed
+                .lines()
+                .filter_map(|line| serde_json::from_str::<serde_json::Value>(line).ok())
+                .any(|row| row["type"] == "response_cancelled")
+            {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(1)).await;
+        }
+    })
+    .await?;
+    assert_one_pilot_http_terminal(&path, "response_cancelled", Some("cancelled"), Some(200));
+    let terminal_before_late_event = std::fs::read(&path)?;
+    release_completed
+        .send(())
+        .expect("controlled server should still await release");
+    // AbortOnDropHandle also aborts the exact server task on assertion/error/timeout paths.
+    tokio::time::timeout(Duration::from_secs(5), server).await???;
+    assert_one_pilot_http_terminal(&path, "response_cancelled", Some("cancelled"), Some(200));
+    assert_eq!(std::fs::read(&path)?, terminal_before_late_event);
+    Ok(())
+}
