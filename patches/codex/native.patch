+    assert_eq!(roots["codex_home"], json!(canonical_home.to_path_buf()));
+    assert_eq!(roots["sqlite_home"], json!(sqlite.path()));
+    assert_eq!(roots["log_dir"], json!(canonical_home.join("log")));
+    assert_eq!(
+        roots["logs_db_path"],
+        json!(sqlite.path().join("logs_2.sqlite"))
+    );
+    let expected = roots.to_string();
+    let accepted = codex_command(home.path())?
+        .env("CODEX_SQLITE_HOME", sqlite.path())
+        .env("CODEX_ARES_EXPECTED_STORAGE_ROOTS", &expected)
+        .args([
+            "app-server",
+            "--print-startup-config",
+            "--include-storage-roots",
+        ])
+        .output()?;
+    assert!(accepted.status.success());
+    let other = TempDir::new()?;
+    let rejected = codex_command(home.path())?
+        .env("CODEX_SQLITE_HOME", other.path())
+        .env("CODEX_ARES_EXPECTED_STORAGE_ROOTS", expected)
+        .args([
