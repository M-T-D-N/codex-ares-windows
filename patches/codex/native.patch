+#[tokio::test]
+async fn projection_reader_preserves_deferred_creation_and_append_position() -> std::io::Result<()>
+{
+    let home = TempDir::new().expect("temp dir");
+    let config = test_config(home.path());
+    let recorder = RolloutRecorder::new(
+        &config,
+        RolloutRecorderParams::new(
+            ThreadId::new(),
+            /*forked_from_id*/ None,
+            /*parent_thread_id*/ None,
+            SessionSource::Exec,
+            /*thread_source*/ None,
+            "test_originator".to_string(),
+            BaseInstructions::default(),
+            Vec::new(),
+        )
+        .with_history_mode(ThreadHistoryMode::Paginated),
+    )
+    .await?;
+    assert!(recorder.projection_reader().await?.is_none());
+    assert!(!recorder.rollout_path().exists());
+    recorder
+        .record_canonical_items(&[agent_message_item("first")])
+        .await?;
+    recorder.flush().await?;
+    let before = fs::read(recorder.rollout_path())?;
+    let mut reader = recorder
+        .projection_reader()
+        .await?
+        .expect("materialized reader");
+    std::io::Seek::rewind(&mut reader)?;
+    std::io::Read::read_exact(&mut reader, &mut [0; 1])?;
+    recorder
+        .record_canonical_items(&[agent_message_item("second")])
+        .await?;
+    recorder.flush().await?;
+    let after = fs::read(recorder.rollout_path())?;
+    assert!(
+        after.starts_with(&before),
+        "reading the shared cursor must not overwrite history"
+    );
+    let (items, _, parse_errors) =
+        RolloutRecorder::load_rollout_items(recorder.rollout_path()).await?;
+    assert_eq!(parse_errors, 0);
+    let messages = items
+        .into_iter()
+        .filter_map(|item| match item {
+            RolloutItem::EventMsg(EventMsg::AgentMessage(event)) => Some(event.message),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(messages, vec!["first".to_string(), "second".to_string()]);
+    drop(reader);
+    recorder.shutdown().await
+}
