+#[tokio::test]
+async fn ares_rpc_stale_turn_identity_cannot_publish_max() -> Result<()> {
+    let mut f = Fixture::new("Sol 6.1-Ares", "gpt-6.1-sol").await?;
+    let turn = f.start().await?;
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    let mut stale = decision(&cp, "max");
+    stale["turnId"] = json!("different-turn");
+    write_frame(&mut stream, &stale).await?;
+    // Malformed identity uses existing native High fallback, never the stale Max.
+    f.completed(&turn, TurnStatus::Completed).await?;
+    let remaining = f.shutdown().await?;
+    assert_eq!(remaining.len(), 1);
+    assert_eq!(remaining[0].thread_id, f.thread);
+    assert_eq!(remaining[0].turn_id, turn);
+    assert_eq!(remaining[0].to_effort, "high");
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0]["reasoning"]["effort"], "high");
+    Ok(())
+}
