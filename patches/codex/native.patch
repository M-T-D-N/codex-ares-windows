+#[tokio::test]
+async fn pilot_http_connection_refused_has_one_classified_prestream_terminal() -> anyhow::Result<()>
+{
+    let reservation = std::net::TcpListener::bind("127.0.0.1:0")?;
+    let address = reservation.local_addr()?;
+    let endpoint = format!("http://{address}/v1");
+    let mut info = create_oss_provider_with_base_url(&endpoint, WireApi::Responses);
+    info.supports_websockets = false;
+    info.request_max_retries = Some(0);
+    let mut client = test_model_client(SessionSource::Cli);
+    Arc::get_mut(&mut client.state).unwrap().provider = create_model_provider(info, None);
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    // Release the selected port only once setup is ready, then exercise the actual transport.
+    drop(reservation);
+    let result = tokio::time::timeout(
+        Duration::from_secs(5),
+        pilot_http_dispatch(
+            &client,
+            crate::pilot_trace::PilotGeneration::for_test(path.clone()),
+        ),
+    )
+    .await?;
+    assert!(result.is_err());
+    let rows = pilot_http_trace(&path);
+    let terminal = rows
+        .iter()
+        .find(|row| row.get("errorClass").is_some())
+        .unwrap();
+    let class = terminal["errorClass"].as_str().unwrap();
+    assert!(
+        matches!(class, "transport_connection" | "transport_network"),
+        "{class}"
+    );
+    let rows = assert_one_pilot_http_terminal(&path, "response_failed", Some(class), None);
+    assert_eq!(rows.last().unwrap()["stage"], "http_before_stream");
+    let attempts = rows
+        .iter()
+        .filter(|row| row["type"] == "http_attempt_completed")
+        .collect::<Vec<_>>();
+    assert_eq!(
+        attempts.len(),
+        1,
+        "retry budget zero must mean one transport attempt"
+    );
+    assert_eq!(attempts[0]["status"], serde_json::Value::Null);
+    let trace = std::fs::read_to_string(&path)?;
+    assert!(!trace.contains(&address.to_string()));
+    for row in rows {
+        for private_field in ["url", "message", "body", "headers", "error"] {
+            assert!(row.get(private_field).is_none());
+        }
+    }
+    Ok(())
+}
