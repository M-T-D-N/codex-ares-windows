+use super::*;
+use codex_protocol::models::ConfigurationReasoning;
+use codex_protocol::openai_models::ReasoningEffort;
+
+fn context_trace(path: PathBuf) -> ContextPreparationTrace {
+    ContextPreparationTrace::new_with_generation(
+        "thread".into(),
+        "turn".into(),
+        "world_state",
+        Some("thread"),
+        |thread_id, turn_id| {
+            Some(Arc::new(PilotGeneration {
+                path,
+                thread_id,
+                turn_id,
+                step: 0,
+                attempts: AtomicU64::new(0),
+                jev_input_evidence: AtomicBool::new(false),
+            }))
+        },
+    )
+}
+
+#[test]
+fn default_and_unselected_context_diagnostics_never_construct_a_writer() {
+    for selection in [
+        None,
+        Some("other"),
+        Some("*"),
+        Some("thread,other"),
+        Some(" thread"),
+    ] {
+        let mut diagnostic = ContextPreparationTrace::new_with_generation(
+            "thread".into(),
+            "turn".into(),
+            "world_state",
+            selection,
+            |_, _| panic!("disabled diagnostics must not look up or construct a trace writer"),
+        );
+        diagnostic.phase("clock");
+        diagnostic.phase("history");
+        diagnostic.phase_lazy(|| panic!("disabled diagnostics must not format a phase"));
+        assert!(diagnostic.state.is_none());
+        diagnostic.finish();
+    }
+}
+
+#[test]
+fn selected_context_diagnostics_require_an_existing_trace_destination() {
+    let mut diagnostic = ContextPreparationTrace::new_with_generation(
+        "thread".into(),
+        "turn".into(),
+        "world_state",
+        Some("thread"),
+        |_, _| None,
+    );
+    diagnostic.phase("clock");
+    assert!(diagnostic.state.is_none());
+    diagnostic.finish();
+}
+
+#[test]
+fn context_diagnostics_are_scoped_to_one_thread_on_a_shared_destination() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    for thread_id in ["thread", "other-thread", "worker-thread"] {
+        let mut diagnostic = ContextPreparationTrace::new_with_generation(
+            thread_id.into(),
+            "turn".into(),
+            "world_state",
+            Some("thread"),
+            |thread_id, turn_id| {
+                Some(Arc::new(PilotGeneration {
+                    path: path.clone(),
+                    thread_id,
+                    turn_id,
+                    step: 0,
+                    attempts: AtomicU64::new(0),
+                    jev_input_evidence: AtomicBool::new(false),
+                }))
+            },
+        );
+        diagnostic.phase("clock");
+        diagnostic.finish();
+    }
+    let rows = std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(rows.len(), 2);
+    assert!(
+        rows.iter()
+            .all(|row| row["threadId"] == "thread" && row["turnId"] == "turn")
+    );
+    assert_eq!(rows[0]["outcome"], "begin");
+    assert_eq!(rows[1]["outcome"], "complete");
+}
+
+#[test]
+fn context_diagnostics_complete_each_phase_without_duplicate_drop() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let mut diagnostic = context_trace(path.clone());
+    diagnostic.phase("clock");
+    diagnostic.phase_lazy(|| "history".to_owned());
+    diagnostic.finish();
+    let rows = std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    let outcomes = rows
+        .iter()
+        .map(|row| {
+            (
+                row["phase"].as_str().unwrap(),
+                row["outcome"].as_str().unwrap(),
+            )
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(
+        outcomes,
+        [
+            ("clock", "begin"),
+            ("clock", "complete"),
+            ("history", "begin"),
+            ("history", "complete")
+        ]
+    );
+    assert!(
+        rows.iter()
+            .all(|row| row["preparationId"] == rows[0]["preparationId"])
+    );
+    assert!(
+        rows.iter()
+            .all(|row| row["step"] == 0 && row.get("input").is_none())
+    );
+}
+
+#[tokio::test]
+async fn context_diagnostics_preserve_the_canceled_await_boundary() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let diagnostic = context_trace(path.clone());
+    let (started, ready) = tokio::sync::oneshot::channel();
+    let task = tokio::spawn(async move {
+        let mut diagnostic = diagnostic;
+        diagnostic.phase("blocked_await");
+        started.send(()).unwrap();
+        std::future::pending::<()>().await;
+        diagnostic.finish();
+    });
+    ready.await.unwrap();
+    task.abort();
+    assert!(task.await.unwrap_err().is_cancelled());
+    let rows = std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[0]["phase"], "blocked_await");
+    assert_eq!(rows[0]["outcome"], "begin");
+    assert_eq!(rows[1]["phase"], "blocked_await");
+    assert_eq!(rows[1]["outcome"], "abandoned");
+    assert_eq!(rows[0]["preparationId"], rows[1]["preparationId"]);
+}
+
+#[test]
+fn scalar_trace_distinguishes_baseline_updates_and_retry_identity() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let generation = Arc::new(PilotGeneration {
+        path: path.clone(),
+        thread_id: "thread".into(),
+        turn_id: "turn".into(),
+        step: 2,
+        attempts: AtomicU64::new(0),
+        jev_input_evidence: AtomicBool::new(false),
+    });
+    let input = vec![ResponseItem::ConfigurationUpdate {
+        reasoning: ConfigurationReasoning {
+            effort: ReasoningEffort::XHigh,
+        },
+    }];
+    let first = generation.request(
+        "gpt-6-astra",
+        Some("high".into()),
+        &input,
+        None,
+        "responses_http",
+    );
+    first.terminal(json!({"type":"response_failed"}));
+    let second = generation.request(
+        "gpt-6-astra",
+        Some("high".into()),
+        &input,
+        Some("prior-response"),
+        "responses_websocket",
+    );
+    second.emit(json!({"type":"websocket_send_completed","localSendSucceeded":true}));
+    second.terminal(json!({"type":"response_completed","responseId":"response-2"}));
+    second.terminal(json!({"type":"response_failed"}));
+    drop(first);
+    drop(second);
+    let rows = std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(rows.len(), 5);
+    assert_eq!(rows[0]["baselineEffort"], "high");
+    assert_eq!(rows[0]["configurationUpdates"][0]["effort"], "xhigh");
+    assert_eq!(rows[2]["step"], 2);
+    assert_eq!(rows[2]["requestOrdinal"], 2);
+    assert_ne!(rows[0]["requestId"], rows[2]["requestId"]);
+    assert_eq!(rows[2]["requestId"], rows[4]["requestId"]);
+    assert!(
+        rows.iter()
+            .all(|row| row.get("input").is_none() && row.get("instructions").is_none())
+    );
+    assert!(rows.iter().all(|row| row.get("requestInputSha1").is_none()));
+}
+
+#[test]
+fn jev_input_evidence_tracks_actual_notice_without_recording_text() {
+    use crate::context::ContextualUserFragment;
+    use crate::context::JevMainReviewNotice;
+
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let generation = Arc::new(PilotGeneration {
+        path: path.clone(),
+        thread_id: "thread".into(),
+        turn_id: "turn".into(),
+        step: 3,
+        attempts: AtomicU64::new(0),
+        jev_input_evidence: AtomicBool::new(false),
+    });
+    generation.enable_jev_input_evidence();
+    let baseline = Vec::<ResponseItem>::new();
+    let reviewed = vec![ContextualUserFragment::into(JevMainReviewNotice::new(
+        "semantic_defer",
+    ))];
+    let first = generation.request(
+        "gpt-6-astra",
+        Some("high".into()),
+        &baseline,
+        None,
+        "responses_http",
+    );
+    let second = generation.request(
+        "gpt-6-astra",
+        Some("high".into()),
+        &reviewed,
+        None,
+        "responses_websocket",
+    );
+    let rows = std::fs::read_to_string(&path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[0]["reviewNoticeInRequestInput"], false);
+    assert_eq!(rows[1]["reviewNoticeInRequestInput"], true);
+    assert_ne!(rows[0]["requestInputSha1"], rows[1]["requestInputSha1"]);
+    assert_eq!(
+        rows[1]["requestInputSha1"],
+        format!("{:x}", Sha1::digest(serde_json::to_vec(&reviewed).unwrap()))
+    );
+    assert!(rows.iter().all(|row| row.get("input").is_none()));
+    assert!(
+        !std::fs::read_to_string(&path)
+            .unwrap()
+            .contains("Continue the current task")
+    );
+    drop((first, second));
+}
+
+fn scalar_attempt(path: PathBuf, transport: &'static str) -> Arc<PilotAttempt> {
+    Arc::new(PilotGeneration {
+        path,
+        thread_id: "thread".into(),
+        turn_id: "turn".into(),
+        step: 1,
+        attempts: AtomicU64::new(0),
+        jev_input_evidence: AtomicBool::new(false),
+    })
+    .request("gpt-6-astra", None, &[], None, transport)
+}
+
+fn scalar_rows(path: &std::path::Path) -> Vec<Value> {
+    std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect()
+}
+
+#[test]
+fn scalar_stream_failure_records_static_class_status_transport_and_elapsed_without_secrets() {
+    const SECRET: &str = "SENTINEL_SECRET_MUST_NOT_ENTER_PILOT_TRACE";
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let mut headers = http::HeaderMap::new();
+    headers.insert(
+        http::header::AUTHORIZATION,
+        http::HeaderValue::from_static(SECRET),
+    );
+    let cases = [
+        (
+            ApiError::Api {
+                status: StatusCode::BAD_REQUEST,
+                message: SECRET.into(),
+            },
+            "api",
+            Some(400),
+        ),
+        (
+            ApiError::Transport(TransportError::Http {
+                status: StatusCode::SERVICE_UNAVAILABLE,
+                url: Some(SECRET.into()),
+                headers: Some(headers),
+                body: Some(SECRET.into()),
+                retry_after: None,
+            }),
+            "transport_http",
+            Some(503),
+        ),
+        (ApiError::Stream(SECRET.into()), "stream", None),
+        (
+            ApiError::Transport(TransportError::Network(SECRET.into())),
+            "transport_network",
+            None,
+        ),
+        (
+            ApiError::Retryable {
+                message: SECRET.into(),
+                retry_after: None,
+            },
+            "retryable",
+            None,
+        ),
+        (
+            ApiError::Transport(TransportError::Timeout),
+            "transport_timeout",
+            None,
+        ),
+    ];
+    for (error, expected_class, expected_status) in cases {
+        for transport in ["responses_http", "responses_websocket"] {
+            let attempt = scalar_attempt(path.clone(), transport);
+            attempt.failed(&error, "stream", None);
+            drop(attempt);
+            let rows = scalar_rows(&path);
+            let failure = rows.last().unwrap();
+            assert_eq!(failure["type"], "response_failed");
+            assert_eq!(failure["stage"], "stream");
+            assert_eq!(failure["errorClass"], expected_class);
+            assert_eq!(failure["httpStatus"], json!(expected_status));
+            assert_eq!(failure["transport"], transport);
+            assert!(failure["elapsedMs"].is_u64());
+        }
+    }
+    assert_eq!(scalar_rows(&path).len(), 24);
+    let contents = std::fs::read_to_string(&path).unwrap();
+    assert!(!contents.contains(SECRET));
+    assert!(!contents.contains("authorization"));
+    assert!(!contents.contains("request_abandoned"));
+}
+
+#[test]
+fn scalar_failure_and_cancellation_keep_the_first_terminal_through_drop() {
+    let dir = tempfile::tempdir().unwrap();
+    for failure_first in [true, false] {
+        let path = dir.path().join(format!("trace-{failure_first}.jsonl"));
+        let attempt = scalar_attempt(path.clone(), "responses_http");
+        let other_owner = Arc::clone(&attempt);
+        if failure_first {
+            attempt.failed(&ApiError::ContentFilter, "stream", None);
+        }
+        attempt.terminal(json!({"type": "response_cancelled"}));
+        attempt.failed(&ApiError::QuotaExceeded, "stream", None);
+        drop(attempt);
+        drop(other_owner);
+        let rows = scalar_rows(&path);
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[0]["type"], "request_prepared");
+        assert_eq!(rows[0]["requestId"], rows[1]["requestId"]);
+        if failure_first {
+            assert_eq!(rows[1]["type"], "response_failed");
+            assert_eq!(rows[1]["errorClass"], "content_filter");
+        } else {
+            assert_eq!(rows[1]["type"], "response_cancelled");
+        }
+    }
+}
+
+#[test]
+fn scalar_attempt_drop_records_one_abandonment_after_the_last_owner() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let attempt = scalar_attempt(path.clone(), "responses_websocket");
+    let other_owner = Arc::clone(&attempt);
+    drop(attempt);
+    assert_eq!(scalar_rows(&path).len(), 1);
+    drop(other_owner);
+    let rows = scalar_rows(&path);
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[1]["type"], "request_abandoned");
+    assert_eq!(rows[0]["requestId"], rows[1]["requestId"]);
+}
+
+#[test]
+fn scalar_statusless_attempt_clears_prior_status_and_explicit_error_status_wins() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let first = scalar_attempt(path.clone(), "responses_http");
+    first.observe_http_status(Some(StatusCode::TOO_MANY_REQUESTS));
+    first.observe_http_status(None);
+    first.failed(
+        &ApiError::Transport(TransportError::Network("private".into())),
+        "http_before_stream",
+        None,
+    );
+    let second = scalar_attempt(path.clone(), "responses_http");
+    second.observe_http_status(Some(StatusCode::TOO_MANY_REQUESTS));
+    second.failed(
+        &ApiError::Api {
+            status: StatusCode::BAD_GATEWAY,
+            message: "private".into(),
+        },
+        "http_before_stream",
+        None,
+    );
+    drop((first, second));
+    let rows = scalar_rows(&path);
+    assert_eq!(rows[1]["httpStatus"], Value::Null);
+    assert_eq!(rows[1]["errorClass"], "transport_network");
+    assert_eq!(rows[3]["httpStatus"], 502);
+    assert_eq!(rows[3]["errorClass"], "api");
+    assert!(
+        rows.iter()
+            .all(|row| row.to_string().find("private").is_none())
+    );
+}
+
+#[test]
+fn scalar_terminal_common_fields_cover_cancel_eof_drop_and_dispatch_guard() {
+    let dir = tempfile::tempdir().unwrap();
+    for (kind, expected_class) in [
+        ("response_cancelled", "cancelled"),
+        ("response_incomplete", "stream_eof"),
+        ("request_abandoned", "request_abandoned"),
+        ("dispatch", "dispatch_future_dropped"),
+    ] {
+        let path = dir.path().join(format!("{kind}.jsonl"));
+        let attempt = scalar_attempt(path.clone(), "responses_websocket");
+        if kind == "dispatch" {
+            let guard = attempt.dispatch_guard("websocket_before_stream");
+            drop(guard);
+        } else if kind != "request_abandoned" {
+            attempt.terminal(json!({"type":kind}));
+        }
+        drop(attempt);
+        let rows = scalar_rows(&path);
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[1]["errorClass"], expected_class);
+        assert_eq!(rows[1]["transport"], "responses_websocket");
+        assert_eq!(rows[1]["httpStatus"], Value::Null);
+        assert!(rows[1]["elapsedMs"].is_u64());
+    }
+}
