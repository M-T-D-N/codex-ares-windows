+#[test]
+fn cross_process_setup_writer_is_respected() {
+    let (root, bin) = fixture();
+    let before = read(&bin).unwrap();
+    let lock = crate::acquire_sandbox_setup_lock(1000).unwrap();
+    let mut command = std::process::Command::new(std::env::current_exe().unwrap());
+    command
+        .args([
+            "--exact",
+            "provisioning_client::legacy_bin::tests::competing_repair_child",
+            "--ignored",
+            "--nocapture",
+        ])
+        .env("ARES_TEST_BIN_HOME", root.path())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped());
+    let mut child = command.spawn().unwrap();
+    println!(
+        "owned test child pid={} parent={} command={command:?}",
+        child.id(),
+        std::process::id()
+    );
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    while child.try_wait().unwrap().is_none() && std::time::Instant::now() < deadline {
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+    if child.try_wait().unwrap().is_none() {
+        child.kill().unwrap();
+        child.wait().unwrap();
+        panic!("owned test child timed out and was reaped");
+    }
+    let output = child.wait_with_output().unwrap();
+    drop(lock);
+    assert!(
+        output.status.success(),
+        "{}",
+        String::from_utf8_lossy(&output.stderr)
+    );
+    assert!(
+        String::from_utf8_lossy(&output.stdout).contains("REPAIR_REFUSED_WHILE_SETUP_LOCK_HELD")
+    );
+    assert_eq!(read(&bin).unwrap(), before);
+    repair(&bin, &root.path().join(".sandbox-bin")).unwrap();
+}
