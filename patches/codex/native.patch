+fn pilot_app_server_requested() -> anyhow::Result<bool> {
+    let marker = std::env::var_os("CODEX_STEP_CONTROLLER_PILOT_MARKER");
+    let endpoint = std::env::var_os("CODEX_STEP_CONTROLLER_TCP");
+    let token = std::env::var_os("CODEX_STEP_CONTROLLER_TOKEN");
+    if marker.is_none() && endpoint.is_none() && token.is_none() {
+        return Ok(false);
+    }
+    let marker = marker
+        .and_then(|value| value.into_string().ok())
+        .ok_or_else(|| anyhow::anyhow!("pilot marker is missing or invalid"))?;
+    if marker.is_empty()
+        || marker.len() > 128
+        || !marker.bytes().all(|byte| (b'!'..=b'~').contains(&byte))
+    {
+        anyhow::bail!("pilot marker is invalid");
+    }
+    let endpoint = endpoint
+        .and_then(|value| value.into_string().ok())
+        .ok_or_else(|| anyhow::anyhow!("pilot loopback endpoint is missing or invalid"))?;
+    let address = endpoint
+        .parse::<std::net::SocketAddrV4>()
+        .map_err(|_| anyhow::anyhow!("pilot loopback endpoint is invalid"))?;
+    if *address.ip() != std::net::Ipv4Addr::LOCALHOST || address.port() == 0 {
+        anyhow::bail!("pilot loopback endpoint is invalid");
+    }
+    let token = token
+        .and_then(|value| value.into_string().ok())
+        .ok_or_else(|| anyhow::anyhow!("pilot authentication token is missing or invalid"))?;
+    if !(32..=256).contains(&token.len())
+        || !token
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+    {
+        anyhow::bail!("pilot authentication token is invalid");
+    }
+    Ok(true)
+}
