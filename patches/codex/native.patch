-fn prompt_with_stdin_context(prompt: &str, stdin_text: &str) -> String {
-    let mut combined = format!("{prompt}\n\n<stdin>\n{stdin_text}");
-    if !stdin_text.ends_with('\n') {
-        combined.push('\n');
-    }
-    combined.push_str("</stdin>");
-    combined
-}
