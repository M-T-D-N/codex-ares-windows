-            THEN 'Guardian review'
-        ELSE title
-    END,
-    name = CASE
-        WHEN trim(COALESCE(name, '')) != ''
-            THEN name
-        WHEN trim(title) != ''
-            AND trim(title) != trim(COALESCE(first_user_message, ''))
