diff --git a/codex-rs/core/src/config/storage_roots.rs b/codex-rs/core/src/config/storage_roots.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a835e6a83edcc6171486b8fa3bc850a43e8b77a9
--- /dev/null
+++ b/codex-rs/core/src/config/storage_roots.rs
@@ -0,0 +1,116 @@
+//! A launcher may pin storage roots without overriding managed requirements.
+//! Validate final Config values on every load/reload, before storage startup.
+
+use serde::Deserialize;
+use serde::Serialize;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub const EXPECTED_ROOTS_ENV: &str = "CODEX_ARES_EXPECTED_STORAGE_ROOTS";
+
+/// A pinned launcher must validate the configured roots, never a replacement
+/// config that discarded user/project/managed layers after a load error.
+pub fn ensure_default_config_fallback_allowed() -> io::Result<()> {
+    if std::env::var_os(EXPECTED_ROOTS_ENV).is_some() {
+        return Err(io::Error::other(
+            "Ares storage root contract forbids default configuration fallback",
+        ));
+    }
+    Ok(())
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct StorageRoots {
+    pub codex_home: PathBuf,
+    pub sqlite_home: PathBuf,
+    pub log_dir: PathBuf,
+    pub logs_db_path: PathBuf,
+}
+
+impl StorageRoots {
+    pub fn from_paths(home: &Path, sqlite: &codex_state::SqliteConfig, log: &Path) -> Self {
+        Self {
+            codex_home: home.to_path_buf(),
+            sqlite_home: sqlite.home().to_path_buf(),
+            log_dir: log.to_path_buf(),
+            logs_db_path: sqlite.logs_db_path(),
+        }
+    }
+
+    fn matches_contract(&self, expected: &str) -> io::Result<()> {
+        let expected: Self = serde_json::from_str(expected)
+            .map_err(|_| io::Error::other("invalid Ares storage root contract"))?;
+        if [
+            &expected.codex_home,
+            &expected.sqlite_home,
+            &expected.log_dir,
+            &expected.logs_db_path,
+        ]
+        .iter()
+        .any(|path| !path.is_absolute())
+            || self != &expected
+        {
+            // No path/config/auth content in the error or trace.
+            return Err(io::Error::other("Ares storage root contract mismatch"));
+        }
+        Ok(())
+    }
+
+    pub(crate) fn validate_launcher_contract(&self) -> io::Result<()> {
+        match std::env::var(EXPECTED_ROOTS_ENV) {
+            Ok(expected) => self.matches_contract(&expected),
+            Err(std::env::VarError::NotPresent) => Ok(()),
+            Err(_) => Err(io::Error::other(
+                "invalid Ares storage root contract encoding",
+            )),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn roots() -> StorageRoots {
+        let root = std::env::temp_dir();
+        StorageRoots {
+            codex_home: root.clone(),
+            sqlite_home: root.clone(),
+            log_dir: root.join("log"),
+            logs_db_path: root.join("logs_2.sqlite"),
+        }
+    }
+    #[test]
+    fn exact_final_roots_match() {
+        let actual = roots();
+        actual
+            .matches_contract(&serde_json::to_string(&actual).unwrap())
+            .unwrap();
+    }
+    #[test]
+    fn every_changed_root_is_rejected() {
+        let actual = roots();
+        for field in ["codex_home", "sqlite_home", "log_dir", "logs_db_path"] {
+            let mut expected = serde_json::to_value(&actual).unwrap();
+            expected[field] = serde_json::to_value(std::env::temp_dir().join("different")).unwrap();
+            assert!(
+                actual.matches_contract(&expected.to_string()).is_err(),
+                "{field}"
+            );
+        }
+    }
+    #[test]
+    fn unknown_missing_relative_and_invalid_contracts_rejected() {
+        let actual = roots();
+        for invalid in ["", "{}", "null", "[]"] {
+            assert!(actual.matches_contract(invalid).is_err());
+        }
+        let mut expected = serde_json::to_value(&actual).unwrap();
+        expected["other"] = true.into();
+        assert!(actual.matches_contract(&expected.to_string()).is_err());
+        expected.as_object_mut().unwrap().remove("other");
+        expected["codex_home"] = "relative".into();
+        assert!(actual.matches_contract(&expected.to_string()).is_err());
+    }
+}
