+#[tokio::test]
+async fn ares_rpc_supported_manual_effort_preserves_effective_user_setting() -> Result<()> {
+    let provider = create_mock_responses_server_sequence(vec![
+        responses::sse(assistant_step("before-manual", false)),
+        responses::sse(assistant_step("after-manual", true)),
+    ])
+    .await;
+    let mut f = Fixture::with_provider(
+        "Sol 6.1-Ares",
+        "gpt-6.1-sol",
+        provider,
+        ProviderMode::SupportedHttp,
+    )
+    .await?;
+    let turn = f.start().await?;
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    let epoch = cp["connectionEpoch"].clone();
+    assert_step_checkpoint(&cp, &f, &turn, 1, "medium", &epoch);
+    write_frame(&mut stream, &decision(&cp, "high")).await?;
+    confirm(&mut stream, &cp, "high").await?;
+    assert_effort_notification(&mut f, &turn, 1, "medium", "high").await?;
+    let pending = next_checkpoint(&mut stream).await?;
+    assert_step_checkpoint(&pending, &f, &turn, 2, "high", &epoch);
+    let response: TurnSettingsUpdateResponse = f
+        .app
+        .request(|request_id| ClientRequest::TurnSettingsUpdate {
+            request_id,
+            params: TurnSettingsUpdateParams {
+                thread_id: f.thread.clone(),
+                turn_id: turn.clone(),
+                effort: Some(ReasoningEffort::Medium),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(response.status, TurnSettingsUpdateStatus::Applied);
+    write_frame(&mut stream, &decision(&pending, "xhigh")).await?;
+    f.completed(&turn, TurnStatus::Completed).await?;
+    assert!(
+        f.shutdown().await?.is_empty(),
+        "late bridge decision must not publish another effort notification"
+    );
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 2);
+    for request in &requests {
+        assert_eq!(request["model"], "gpt-6.1-sol");
+        assert_eq!(request["reasoning"]["effort"], "high");
+    }
+    assert_eq!(configuration_efforts(&requests[0]), vec![json!("high")]);
+    assert_eq!(
+        configuration_efforts(&requests[1]),
+        vec![json!("high"), json!("medium")]
+    );
+    assert_eq!(
+        configuration_efforts(&requests[1]).last(),
+        Some(&json!("medium")),
+        "effective effort follows the user despite the pinned High baseline"
+    );
+    Ok(())
+}
