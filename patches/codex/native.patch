+        })
+        .collect();
+    let mock = responses::mount_sse_sequence(&server, sequence).await;
+    let test = test_codex()
+        .with_model("gpt-6-astra")
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_config(|config| {
+            config.model_catalog =
+                Some(codex_models_manager::bundled_models_response().expect("bundled catalog"));
+            config.model_reasoning_effort = Some(ReasoningEffort::High);
+            config.model_provider.supports_websockets = false;
+            config.features.enable(Feature::StepModelSwitching).unwrap();
+            config
+                .features
+                .enable(Feature::ReasoningEffortOverride)
+                .unwrap();
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.submit_turn(&format!("{marker}\nContinue without tools."))
+        .await?;
+    let (thread_id, turn_id) = tokio::time::timeout(Duration::from_secs(10), sidecar).await???;
+    let requests = mock.requests();
+    assert_eq!(requests.len(), 3);
+    let efforts = ["high", "xhigh", "high"];
+    for (index, request) in requests.iter().enumerate() {
+        assert_eq!(request.body_json()["model"], "gpt-6-astra");
+        assert_eq!(request.body_json()["reasoning"]["effort"], "high");
+        assert_eq!(
+            effort_updates(request)
+                .iter()
+                .map(|u| u["reasoning"]["effort"].clone())
+                .collect::<Vec<_>>(),
+            efforts[..=index]
+                .iter()
+                .map(|e| Value::from(*e))
+                .collect::<Vec<_>>()
+        );
+    }
+    let trace = std::fs::read_to_string(&trace_path)?;
+    assert!(!trace.contains(&marker) && !trace.contains(&token));
+    let rows = trace
+        .lines()
+        .map(serde_json::from_str::<Value>)
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    assert!(rows.iter().all(|row| row["threadId"] == thread_id
+        && row["turnId"] == turn_id
+        && row.get("input").is_none()
+        && row.get("context").is_none()
+        && row.get("instructions").is_none()));
+    let events = |kind: &str, step: u64| {
+        rows.iter()
+            .filter(|row| row["type"].as_str() == Some(kind) && row["step"].as_u64() == Some(step))
+            .collect::<Vec<_>>()
+    };
+    for (index, effort) in efforts.iter().enumerate() {
+        let step = index as u64 + 1;
+        for stage in ["native_selected", "native_published", "native_captured"] {
+            let stage_rows = events(stage, step);
+            assert_eq!(stage_rows.len(), 1);
+            assert_eq!(stage_rows[0]["effort"], *effort);
+        }
+        let prepared = events("request_prepared", step);
+        let dispatched = events("http_attempt_completed", step);
+        let completed = events("response_completed", step);
+        assert_eq!(
+            (prepared.len(), dispatched.len(), completed.len()),
+            (1, 1, 1)
+        );
+        assert_eq!(prepared[0]["model"], "gpt-6-astra");
+        assert_eq!(prepared[0]["transport"], "responses_http");
+        assert_eq!(prepared[0]["baselineEffort"], "high");
+        assert_eq!(
+            prepared[0]["configurationUpdates"]
+                .as_array()
+                .expect("scalar updates")
+                .iter()
+                .map(|u| u["effort"].clone())
+                .collect::<Vec<_>>(),
+            efforts[..=index]
+                .iter()
+                .map(|e| Value::from(*e))
+                .collect::<Vec<_>>()
+        );
+        assert_eq!(dispatched[0]["requestId"], prepared[0]["requestId"]);
+        assert_eq!(dispatched[0]["status"], 200);
