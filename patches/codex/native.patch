+#[cfg(windows)]
+async fn luna_fixture_with_model_and_source(
+    selection: &str,
+    base_model: &str,
+    thread_source: Option<ThreadSource>,
+) -> (Arc<Session>, Arc<TurnContext>, StepController) {
+    let (session, _) = make_session_and_context().await;
+    let mut session = Arc::new(session);
+    let mutable = Arc::get_mut(&mut session).expect("unshared session");
