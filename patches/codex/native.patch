+            let bridge = bridge.clone();
+            crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                CodexAuth::from_api_key("synthetic-reconnect-fixture"),
+                Vec::new(),
+                move |config| {
+                    config.mcp_servers.set(serde_json::from_value(json!({
