@@ -0,0 +1,364 @@
+//! Owner-authorized compatibility with packaged services predating PR59745.
+//! Never install a service or change a child ACL. Reject unfamiliar root ACLs.
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::ensure;
+use std::io;
+use std::os::windows::fs::OpenOptionsExt;
+use std::os::windows::io::AsRawHandle;
+use std::os::windows::io::FromRawHandle;
+use std::os::windows::io::OwnedHandle;
+use std::path::Path;
+use std::ptr;
+use windows_sys::Win32::Foundation::ERROR_FILE_NOT_FOUND;
+use windows_sys::Win32::Foundation::LocalFree;
+use windows_sys::Win32::Foundation::RtlNtStatusToDosError;
+use windows_sys::Win32::Security as security;
+use windows_sys::Win32::Security::Authorization as authorization;
+use windows_sys::Win32::Storage::FileSystem as fs;
+use windows_sys::Win32::System::Threading::GetCurrentProcess;
+use windows_sys::Win32::System::Threading::OpenProcessToken;
+
+#[link(name = "ntdll")]
+unsafe extern "system" {
+    fn NtSetSecurityObject(
+        handle: windows_sys::Win32::Foundation::HANDLE,
+        information: u32,
+        descriptor: *const security::SECURITY_DESCRIPTOR,
+    ) -> i32;
+}
+
+/// Keep the home and existing bin pinned across the authenticated service call.
+/// An initially missing bin is opened only after the service has created it.
+pub(super) fn around<T>(home: &Path, request: impl FnOnce() -> Result<T>) -> Result<T> {
+    around_with_repair(home, request, repair)
+}
+
+fn around_with_repair<T>(
+    home: &Path,
+    request: impl FnOnce() -> Result<T>,
+    repair: impl Fn(&OwnedHandle, &Path) -> Result<()>,
+) -> Result<T> {
+    let _home = open(home, fs::READ_CONTROL | fs::FILE_TRAVERSE)?;
+    let bin = home.join(".sandbox-bin");
+    let before = open_bin(&bin)?;
+    if let Some(handle) = &before {
+        repair(handle, &bin)?;
+    }
+    let response = request();
+    // Old services can recreate the legacy DACL even on an error path.
+    // Preserve the service error; a failed postcondition cannot become success.
+    let checked = (|| {
+        let after = match before {
+            Some(handle) => Some(handle),
+            None => open_bin(&bin)?,
+        };
+        after.as_ref().map_or(Ok(()), |handle| repair(handle, &bin))
+    })();
+    match (response, checked) {
+        (Ok(value), Ok(())) => Ok(value),
+        (Err(error), Ok(())) => Err(error),
+        (Ok(_), Err(error)) => Err(error).context("legacy bin postcondition failed"),
+        (Err(error), Err(repair)) => {
+            Err(error).context(format!("legacy bin postcondition also failed: {repair:#}"))
+        }
+    }
+}
+
+fn open(path: &Path, access: u32) -> Result<OwnedHandle> {
+    crate::open_directory_no_reparse(
+        path,
+        access,
+        fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE,
+        crate::DirectoryOpenDisposition::OpenExisting,
+    )
+}
+
+fn open_bin(path: &Path) -> Result<Option<OwnedHandle>> {
+    match open(path, fs::READ_CONTROL | fs::WRITE_DAC | fs::FILE_TRAVERSE) {
+        Ok(handle) => Ok(Some(handle)),
+        Err(error)
+            if error
+                .downcast_ref::<io::Error>()
+                .is_some_and(|error| error.raw_os_error() == Some(ERROR_FILE_NOT_FOUND as i32)) =>
+        {
+            Ok(None)
+        }
+        Err(error) => Err(error),
+    }
+}
+
+fn current_sid() -> Result<Vec<u8>> {
+    let mut token = ptr::null_mut();
+    if unsafe { OpenProcessToken(GetCurrentProcess(), security::TOKEN_QUERY, &mut token) } == 0 {
+        return Err(io::Error::last_os_error()).context("query legacy bin caller");
+    }
+    let token = unsafe { OwnedHandle::from_raw_handle(token) };
+    unsafe { crate::get_user_sid_bytes(token.as_raw_handle()) }
+}
+
+fn read(handle: &OwnedHandle) -> Result<(Vec<u32>, u16)> {
+    let mut owner = ptr::null_mut();
+    let mut acl = ptr::null_mut();
+    let mut descriptor = ptr::null_mut();
+    let status = unsafe {
+        authorization::GetSecurityInfo(
+            handle.as_raw_handle(),
+            authorization::SE_FILE_OBJECT,
+            security::OWNER_SECURITY_INFORMATION | security::DACL_SECURITY_INFORMATION,
+            &mut owner,
+            ptr::null_mut(),
+            &mut acl,
+            ptr::null_mut(),
+            &mut descriptor,
+        )
+    };
+    if status != 0 {
+        return Err(io::Error::from_raw_os_error(status as i32)).context("read legacy bin ACL");
+    }
+    let result = (|| {
+        ensure!(
+            !owner.is_null() && !acl.is_null(),
+            "missing legacy bin owner or ACL"
+        );
+        verify_owner(owner, &current_sid()?)?;
+        ensure!(
+            unsafe { security::IsValidAcl(acl) } != 0,
+            "invalid legacy bin ACL"
+        );
+        let mut control = 0;
+        let mut revision = 0;
+        ensure!(
+            unsafe {
+                security::GetSecurityDescriptorControl(descriptor, &mut control, &mut revision)
+            } != 0,
+            "read legacy bin ACL control"
+        );
+        let length = usize::from(unsafe { (*acl).AclSize });
+        let mut copy = vec![0u32; length.div_ceil(4)];
+        unsafe { ptr::copy_nonoverlapping(acl.cast::<u8>(), copy.as_mut_ptr().cast(), length) };
+        Ok((copy, control))
+    })();
+    unsafe { LocalFree(descriptor) };
+    result
+}
+
+fn verify_owner(owner: *mut std::ffi::c_void, user: &[u8]) -> Result<()> {
+    ensure!(
+        !owner.is_null()
+            && unsafe { security::EqualSid(owner, user.as_ptr().cast_mut().cast()) } != 0,
+        "legacy bin owner is not the provisioning caller"
+    );
+    Ok(())
+}
+
+/// The only accepted mutation is SYSTEM Modify -> Modify|WRITE_DAC.
+/// Already-upgraded ACLs are still fully checked. No deny/unknown ACE is edited.
+struct Policy {
+    system: Vec<u8>,
+    admins: Vec<u8>,
+    owner: Vec<u8>,
+    sandbox_group: Vec<u8>,
+}
+
+impl Policy {
+    fn current() -> Result<Self> {
+        Ok(Self {
+            system: crate::resolve_sid("SYSTEM")?,
+            admins: crate::resolve_sid("Administrators")?,
+            owner: current_sid()?,
+            sandbox_group: crate::resolve_sid(crate::SANDBOX_USERS_GROUP)?,
+        })
+    }
+}
+
+fn upgrade(acl: &mut [u32], control: u16, policy: &Policy) -> Result<bool> {
+    ensure!(
+        control & security::SE_DACL_PROTECTED != 0,
+        "expected protected legacy bin ACL"
+    );
+    let dacl = acl.as_mut_ptr().cast::<security::ACL>();
+    let modify =
+        fs::FILE_GENERIC_READ | fs::FILE_GENERIC_WRITE | fs::FILE_GENERIC_EXECUTE | fs::DELETE;
+    ensure!(
+        unsafe { (*dacl).AceCount } == 4,
+        "expected exactly four legacy bin ACEs"
+    );
+    let mut seen = [false; 4];
+    let mut change = None;
+    for index in 0..u32::from(unsafe { (*dacl).AceCount }) {
+        let mut ace = ptr::null_mut();
+        ensure!(
+            unsafe { security::GetAce(dacl, index, &mut ace) } != 0,
+            "read legacy bin ACE"
+        );
+        let header = unsafe { &*ace.cast::<security::ACE_HEADER>() };
+        ensure!(
+            header.AceType == 0 && header.AceSize >= 16,
+            "unsupported legacy bin ACE"
+        );
+        let allow = unsafe { &*ace.cast::<security::ACCESS_ALLOWED_ACE>() };
+        let sid = ptr::addr_of!(allow.SidStart).cast::<u8>();
+        let length = usize::from(header.AceSize)
+            - std::mem::offset_of!(security::ACCESS_ALLOWED_ACE, SidStart);
+        let sid = unsafe { std::slice::from_raw_parts(sid, length) };
+        let index = [
+            &policy.system,
+            &policy.admins,
+            &policy.owner,
+            &policy.sandbox_group,
+        ]
+        .iter()
+        .position(|expected| expected.as_slice() == sid)
+        .context("unexpected legacy bin trustee")?;
+        let expected = match index {
+            0 => modify,
+            1 => modify,
+            2 => modify | fs::WRITE_DAC,
+            3 => fs::FILE_GENERIC_READ | fs::FILE_GENERIC_EXECUTE,
+            _ => unreachable!(),
+        };
+        ensure!(
+            !seen[index]
+                && u32::from(header.AceFlags)
+                    == (security::OBJECT_INHERIT_ACE | security::CONTAINER_INHERIT_ACE)
+                && (allow.Mask == expected
+                    || (index == 0 && allow.Mask == expected | fs::WRITE_DAC)),
+            "unexpected legacy bin permissions or duplicate trustee"
+        );
+        seen[index] = true;
+        if index == 0 && allow.Mask == modify {
+            change = Some(ace.cast::<security::ACCESS_ALLOWED_ACE>());
+        }
+    }
+    ensure!(seen.iter().all(|seen| *seen), "missing legacy bin trustee");
+    if let Some(ace) = change {
+        unsafe { (*ace).Mask |= fs::WRITE_DAC };
+    }
+    Ok(change.is_some())
+}
+
+fn write(handle: &OwnedHandle, acl: &mut [u32], control: u16) -> Result<()> {
+    let mut descriptor: security::SECURITY_DESCRIPTOR = unsafe { std::mem::zeroed() };
+    let raw = (&mut descriptor as *mut security::SECURITY_DESCRIPTOR).cast();
+    let preserved = security::SE_DACL_PROTECTED | security::SE_DACL_AUTO_INHERITED;
+    ensure!(
+        unsafe { security::InitializeSecurityDescriptor(raw, 1) } != 0,
+        "initialize legacy bin descriptor"
+    );
+    ensure!(
+        unsafe {
+            security::SetSecurityDescriptorDacl(
+                raw,
+                1,
+                acl.as_mut_ptr().cast(),
+                i32::from(control & security::SE_DACL_DEFAULTED != 0),
+            )
+        } != 0,
+        "set legacy bin ACL"
+    );
+    ensure!(
+        unsafe { security::SetSecurityDescriptorControl(raw, preserved, control & preserved) } != 0,
+        "preserve legacy bin ACL control"
+    );
+    // Use the official retained-handle setter; initialized/protected child ACLs
+    // are separately pinned and checked, including Windows inheritance flags.
+    let status = unsafe {
+        NtSetSecurityObject(
+            handle.as_raw_handle(),
+            security::DACL_SECURITY_INFORMATION,
+            &descriptor,
+        )
+    };
+    if status < 0 {
+        return Err(io::Error::from_raw_os_error(
+            unsafe { RtlNtStatusToDosError(status) } as i32,
+        ))
+        .context("write legacy bin ACL");
+    }
+    Ok(())
+}
+
+fn repair(handle: &OwnedHandle, path: &Path) -> Result<()> {
+    repair_with_policy(handle, path, &Policy::current()?)
+}
+
+fn repair_with_policy(handle: &OwnedHandle, path: &Path, policy: &Policy) -> Result<()> {
+    repair_with_policy_after_scan(handle, path, policy, || Ok(()))
+}
+
+fn repair_with_policy_after_scan(
+    handle: &OwnedHandle,
+    path: &Path,
+    policy: &Policy,
+    after_scan: impl FnOnce() -> Result<()>,
+) -> Result<()> {
+    let (mut acl, control) = read(handle)?;
+    if upgrade(&mut acl, control, policy)? {
+        // Use the existing setup/uninstall serialization, with its original
+        // SYSTEM/administrator DACL. Never grant the caller mutex access.
+        // A preexisting inaccessible/busy setup lock fails closed before writing.
+        let _setup_lock = crate::setup_mutex::acquire_legacy_bin_setup_lock(5_000)?;
+        let (mut acl, control) = read(handle)?;
+        if !upgrade(&mut acl, control, policy)? {
+            return Ok(());
+        }
+        let children = pin_children(path)?;
+        after_scan()?;
+        write(handle, &mut acl, control)?;
+        let (mut actual, actual_control) = read(handle)?;
+        ensure!(
+            actual == acl && !upgrade(&mut actual, actual_control, policy)?,
+            "verify repaired legacy bin ACL"
+        );
+        for (child, before) in children {
+            ensure!(read(&child)? == before, "legacy bin child ACL changed");
+        }
+    }
+    Ok(())
+}
+
+// Windows can normalize the ACL of a child whose inheritance has never been
+// initialized when its parent changes. Accept only the reviewed initialized or
+// protected state, pin regular children, and verify their ACL bytes afterward.
+fn pin_children(path: &Path) -> Result<Vec<(OwnedHandle, (Vec<u32>, u16))>> {
+    let mut retained = Vec::new();
+    for entry in std::fs::read_dir(path)? {
+        ensure!(retained.len() < 64, "unexpected legacy bin child count");
+        let entry = entry?;
+        ensure!(
+            entry.file_type()?.is_file(),
+            "unexpected legacy bin child type"
+        );
+        let file = std::fs::OpenOptions::new()
+            .access_mode(fs::READ_CONTROL | fs::FILE_READ_DATA)
+            .share_mode(fs::FILE_SHARE_READ | fs::FILE_SHARE_WRITE)
+            .custom_flags(fs::FILE_FLAG_OPEN_REPARSE_POINT)
+            .open(entry.path())?;
+        let mut info: fs::BY_HANDLE_FILE_INFORMATION = unsafe { std::mem::zeroed() };
+        ensure!(
+            unsafe { fs::GetFileInformationByHandle(file.as_raw_handle(), &mut info) } != 0,
+            "read legacy bin child identity"
+        );
+        ensure!(
+            info.dwFileAttributes
+                & (fs::FILE_ATTRIBUTE_REPARSE_POINT | fs::FILE_ATTRIBUTE_DIRECTORY)
+                == 0
+                && info.nNumberOfLinks == 1,
+            "redirected legacy bin child"
+        );
+        let handle: OwnedHandle = file.into();
+        let before = read(&handle)?;
+        ensure!(
+            before.1 & (security::SE_DACL_PROTECTED | security::SE_DACL_AUTO_INHERITED) != 0,
+            "uninitialized legacy bin child inheritance"
+        );
+        retained.push((handle, before));
+    }
+    Ok(retained)
+}
