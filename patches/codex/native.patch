diff --git a/codex-rs/core/src/pilot_trace.rs b/codex-rs/core/src/pilot_trace.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2911bf71c3d30660a9ca027dab2572fe1bcc8239
--- /dev/null
+++ b/codex-rs/core/src/pilot_trace.rs
@@ -0,0 +1,444 @@
+//! Private, opt-in scalar evidence for the Ares same-turn pilot. No prompt bodies.
+use codex_api::ApiError;
+use codex_client::RequestTelemetry;
+use codex_client::TransportError;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use http::StatusCode;
+use serde_json::Value;
+use serde_json::json;
+use sha1::Digest;
+use sha1::Sha1;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::AtomicU64;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+use uuid::Uuid;
+
+static WRITES: Mutex<()> = Mutex::new(());
+
+/// Content-free await boundaries for one explicitly selected diagnostic thread.
+/// The ordinary Ares trace path alone does not enable detailed context phases.
+/// Step zero denotes context preparation, never an evaluated model generation.
+pub(crate) struct ContextPreparationTrace {
+    state: Option<ContextPreparationState>,
+}
+
+struct ContextPreparationState {
+    generation: Arc<PilotGeneration>,
+    preparation_id: Uuid,
+    scope: &'static str,
+    phase: Option<String>,
+    started: Instant,
+}
+
+impl ContextPreparationTrace {
+    pub(crate) fn new(thread_id: String, turn_id: String, scope: &'static str) -> Self {
+        let selected_thread = std::env::var("CODEX_CONTEXT_TRACE_THREAD_ID").ok();
+        Self::new_with_generation(
+            thread_id,
+            turn_id,
+            scope,
+            selected_thread.as_deref(),
+            |thread_id, turn_id| PilotGeneration::new_stage(thread_id, turn_id, 0),
+        )
+    }
+
+    fn new_with_generation(
+        thread_id: String,
+        turn_id: String,
+        scope: &'static str,
+        selected_thread: Option<&str>,
+        generation: impl FnOnce(String, String) -> Option<Arc<PilotGeneration>>,
+    ) -> Self {
+        // Exact matching excludes unrelated threads, including spawned workers.
+        // Return before trace-path lookup, UUID/clock/phase/JSON work or log locking.
+        if selected_thread != Some(thread_id.as_str()) {
+            return Self { state: None };
+        }
+        Self {
+            state: generation(thread_id, turn_id).map(|generation| ContextPreparationState {
+                generation,
+                preparation_id: Uuid::new_v4(),
+                scope,
+                phase: None,
+                started: Instant::now(),
+            }),
+        }
+    }
+
+    pub(crate) fn phase(&mut self, phase: &str) {
+        if let Some(state) = &mut self.state {
+            state.end("complete");
+            state.phase = Some(phase.to_owned());
+            state.started = Instant::now();
+            state.emit("begin");
+        }
+    }
+
+    /// Construct dynamically named phases only when diagnostics are selected.
+    pub(crate) fn phase_lazy(&mut self, phase: impl FnOnce() -> String) {
+        if self.state.is_some() {
+            self.phase(&phase());
+        }
+    }
+
+    pub(crate) fn finish(mut self) {
+        if let Some(state) = &mut self.state {
+            state.end("complete");
+        }
+    }
+}
+
+impl ContextPreparationState {
+    fn end(&mut self, outcome: &str) {
+        if self.phase.is_some() {
+            self.emit(outcome);
+            self.phase = None;
+        }
+    }
+
+    fn emit(&self, outcome: &str) {
+        self.generation
+            .emit(json!({"type":"native_context_phase", "scope":self.scope,
+            "preparationId":self.preparation_id, "phase":self.phase,
+            "outcome":outcome, "elapsedMs":self.started.elapsed().as_millis()}));
+    }
+}
+
+impl Drop for ContextPreparationTrace {
+    fn drop(&mut self) {
+        if let Some(state) = &mut self.state {
+            state.end("abandoned");
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct PilotGeneration {
+    path: PathBuf,
+    thread_id: String,
+    turn_id: String,
+    step: u64,
+    attempts: AtomicU64,
+    jev_input_evidence: AtomicBool,
+}
+
+impl PilotGeneration {
+    #[cfg(test)]
+    pub(crate) fn for_test(path: PathBuf) -> Arc<Self> {
+        Arc::new(Self {
+            path,
+            thread_id: "thread".into(),
+            turn_id: "turn".into(),
+            step: 1,
+            attempts: AtomicU64::new(0),
+            jev_input_evidence: AtomicBool::new(false),
+        })
+    }
+
+    pub(crate) fn record_stage(
+        thread_id: String,
+        turn_id: String,
+        step: u64,
+        effort: Option<String>,
+        stage: &str,
+    ) -> Option<Arc<Self>> {
+        let generation = Self::new_stage(thread_id, turn_id, step)?;
+        generation.emit(json!({"type":stage,"effort":effort}));
+        Some(generation)
+    }
+
+    pub(crate) fn record_stage_with_details(
+        thread_id: String,
+        turn_id: String,
+        step: u64,
+        effort: Option<String>,
+        stage: &str,
+        cause: Option<&str>,
+        connection_epoch: Option<Uuid>,
+    ) -> Option<Arc<Self>> {
+        let generation = Self::new_stage(thread_id, turn_id, step)?;
+        let bounded_cause = cause.map(|value| value.chars().take(200).collect::<String>());
+        generation.emit(json!({"type":stage,"effort":effort,
+            "cause":bounded_cause,"connectionEpoch":connection_epoch}));
+        Some(generation)
+    }
+
+    fn new_stage(thread_id: String, turn_id: String, step: u64) -> Option<Arc<Self>> {
+        let path = PathBuf::from(std::env::var_os("CODEX_STEP_CONTROLLER_TRACE_PATH")?);
+        if !path.is_absolute() {
+            return None;
+        }
+        let generation = Arc::new(Self {
+            path,
+            thread_id,
+            turn_id,
+            step,
+            attempts: AtomicU64::new(0),
+            jev_input_evidence: AtomicBool::new(false),
+        });
+        Some(generation)
+    }
+
+    fn emit(&self, mut event: Value) {
+        let object = event.as_object_mut().expect("pilot events are objects");
+        object.insert("threadId".into(), json!(self.thread_id));
+        object.insert("turnId".into(), json!(self.turn_id));
+        object.insert("step".into(), json!(self.step));
+        let write = (|| -> std::io::Result<()> {
+            let _guard = WRITES
+                .lock()
+                .map_err(|_| std::io::Error::other("pilot trace lock poisoned"))?;
+            let mut file = OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(&self.path)?;
+            let mut bytes = serde_json::to_vec(&event)?;
+            bytes.push(b'\n');
+            file.write_all(&bytes)
+        })();
+        if write.is_err() {
+            tracing::warn!("pilot scalar evidence write failed; dispatch proof is incomplete");
+        }
+    }
+
+    pub(crate) fn enable_jev_input_evidence(&self) {
+        self.jev_input_evidence.store(true, Ordering::Release);
+    }
+
+    pub(crate) fn request(
+        self: &Arc<Self>,
+        model: &str,
+        baseline_effort: Option<String>,
+        input: &[ResponseItem],
+        previous_response_id: Option<&str>,
+        transport: &'static str,
+    ) -> Arc<PilotAttempt> {
+        let configuration_updates = input
+            .iter()
+            .enumerate()
+            .filter_map(|(index, item)| match item {
+                ResponseItem::ConfigurationUpdate { reasoning } => {
+                    Some(json!({"index":index,"effort":reasoning.effort.to_string()}))
+                }
+                _ => None,
+            })
+            .collect::<Vec<_>>();
+        let attempt = Arc::new(PilotAttempt {
+            generation: Arc::clone(self),
+            request_id: Uuid::new_v4().to_string(),
+            ordinal: self.attempts.fetch_add(1, Ordering::Relaxed) + 1,
+            transport,
+            started: Instant::now(),
+            latest_http_status: Mutex::new(None),
+            terminal: AtomicBool::new(false),
+        });
+        let mut event = json!({"type":"request_prepared","transport":transport,"model":model,
+            "baselineEffort":baseline_effort,"configurationUpdates":configuration_updates,"previousResponseId":previous_response_id});
+        if self.jev_input_evidence.load(Ordering::Acquire) {
+            // A correlation digest of the transmitted input array, not a security seal
+            // or a hash of the full request. Retain the existing hashing dependency.
+            let input_hash = serde_json::to_vec(input)
+                .ok()
+                .map(|bytes| format!("{:x}", Sha1::digest(bytes)));
+            let has_review = input.iter().any(|item| {
+                matches!(item, ResponseItem::Message { role, content, .. }
+                if role == "user" && content.iter().any(|part| {
+                    matches!(part, ContentItem::InputText { text }
+                        if text.contains("<jev_main_review>"))
+                }))
+            });
+            event["requestInputSha1"] = json!(input_hash);
+            event["reviewNoticeInRequestInput"] = json!(has_review);
+        }
+        attempt.emit(event);
+        attempt
+    }
+}
+
+#[derive(Debug)]
+pub(crate) struct PilotAttempt {
+    generation: Arc<PilotGeneration>,
+    request_id: String,
+    ordinal: u64,
+    transport: &'static str,
+    started: Instant,
+    latest_http_status: Mutex<Option<u16>>,
+    terminal: AtomicBool,
+}
+
+impl PilotAttempt {
+    pub(crate) fn emit(&self, mut event: Value) {
+        let object = event.as_object_mut().expect("pilot events are objects");
+        object.insert("requestId".into(), json!(self.request_id));
+        object.insert("requestOrdinal".into(), json!(self.ordinal));
+        self.generation.emit(event);
+    }
+    pub(crate) fn failed(
+        &self,
+        error: &ApiError,
+        stage: &'static str,
+        upstream_request_id: Option<&str>,
+    ) {
+        let (error_class, http_status) = api_error_diagnostic(error);
+        // A final status-less transport failure must not inherit an earlier retry's status.
+        if matches!(error, ApiError::Transport(error) if !matches!(error, TransportError::Http { .. } | TransportError::RetryLimit))
+        {
+            self.observe_http_status(None);
+        }
+        let mut event = json!({
+            "type": "response_failed",
+            "stage": stage,
+            "upstreamRequestId": upstream_request_id,
+            "errorClass": error_class,
+        });
+        if let Some(status) = http_status {
+            event["httpStatus"] = json!(status);
+        }
+        self.terminal(event);
+    }
+
+    fn observe_http_status(&self, status: Option<StatusCode>) {
+        *self
+            .latest_http_status
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner) =
+            status.map(|status| status.as_u16());
+    }
+
+    pub(crate) fn dispatch_guard(self: &Arc<Self>, stage: &'static str) -> PilotDispatchGuard {
+        PilotDispatchGuard {
+            pilot: Some(Arc::clone(self)),
+            stage,
+        }
+    }
+
+    pub(crate) fn terminal(&self, mut event: Value) {
+        let object = event.as_object_mut().expect("pilot events are objects");
+        let error_class = match object.get("type").and_then(Value::as_str) {
+            Some("response_completed") => Value::Null,
+            Some("response_cancelled") => json!("cancelled"),
+            Some("response_incomplete") => json!("stream_eof"),
+            Some("request_abandoned") => json!("request_abandoned"),
+            _ => json!("unknown"),
+        };
+        object.entry("errorClass").or_insert(error_class);
+        object.entry("httpStatus").or_insert_with(|| {
+            json!(
+                *self
+                    .latest_http_status
+                    .lock()
+                    .unwrap_or_else(std::sync::PoisonError::into_inner)
+            )
+        });
+        object.insert("transport".into(), json!(self.transport));
+        object.insert(
+            "elapsedMs".into(),
+            json!(self.started.elapsed().as_millis()),
+        );
+        if !self.terminal.swap(true, Ordering::AcqRel) {
+            self.emit(event);
+        }
+    }
+}
+impl Drop for PilotAttempt {
+    fn drop(&mut self) {
+        self.terminal(json!({"type":"request_abandoned"}));
+    }
+}
+
+/// Only owns the pending dispatch await; stream/result ownership takes over on disarm.
+pub(crate) struct PilotDispatchGuard {
+    pilot: Option<Arc<PilotAttempt>>,
+    stage: &'static str,
+}
+
+impl PilotDispatchGuard {
+    pub(crate) fn disarm(&mut self) {
+        self.pilot = None;
+    }
+}
+
+impl Drop for PilotDispatchGuard {
+    fn drop(&mut self) {
+        if let Some(pilot) = &self.pilot {
+            pilot.terminal(json!({
+                "type": "response_cancelled",
+                "stage": self.stage,
+                "errorClass": "dispatch_future_dropped",
+            }));
+        }
+    }
+}
+
+/// Match variants only: error messages, response bodies and headers never enter the trace.
+fn api_error_diagnostic(error: &ApiError) -> (&'static str, Option<u16>) {
+    let class = match error {
+        ApiError::Transport(TransportError::Http { status, .. }) => {
+            return ("transport_http", Some(status.as_u16()));
+        }
+        ApiError::Transport(TransportError::Policy(_)) => "transport_policy",
+        ApiError::Transport(TransportError::RetryLimit) => "transport_retry_limit",
+        ApiError::Transport(TransportError::Timeout) => "transport_timeout",
+        ApiError::Transport(TransportError::Connection(_)) => "transport_connection",
+        ApiError::Transport(TransportError::Network(_)) => "transport_network",
+        ApiError::Transport(TransportError::Build(_)) => "transport_build",
+        ApiError::Transport(TransportError::ResponseTooLarge { .. }) => {
+            "transport_response_too_large"
+        }
+        ApiError::Api { status, .. } => return ("api", Some(status.as_u16())),
+        ApiError::Stream(_) => "stream",
+        ApiError::ContentFilter => "content_filter",
+        ApiError::ResponseIncomplete(_) => "response_incomplete",
+        ApiError::ContextWindowExceeded => "context_window_exceeded",
+        ApiError::QuotaExceeded => "quota_exceeded",
+        ApiError::UsageNotIncluded => "usage_not_included",
+        ApiError::Retryable { .. } => "retryable",
+        ApiError::RateLimitExceeded { .. } => "rate_limit_exceeded",
+        ApiError::RateLimit(_) => "rate_limit",
+        ApiError::InvalidRequest { .. } => "invalid_request",
+        ApiError::ModelNotFound { status, .. } => {
+            return ("model_not_found", status.map(|status| status.as_u16()));
+        }
+        ApiError::InvalidPrompt { .. } => "invalid_prompt",
+        ApiError::InvalidAudioInput { .. } => "invalid_audio_input",
+        ApiError::CyberPolicy { .. } => "cyber_policy",
+        ApiError::BioPolicy { .. } => "bio_policy",
+        ApiError::MisalignmentPolicyViolation { .. } => "misalignment_policy_violation",
+        ApiError::FlexUnavailable => "flex_unavailable",
+        ApiError::PolicyCapacityUnavailable { .. } => "policy_capacity_unavailable",
+        ApiError::ServerOverloaded { .. } => "server_overloaded",
+    };
+    (class, None)
+}
+
+pub(crate) struct PilotHttpTelemetry {
+    pub(crate) inner: Arc<dyn RequestTelemetry>,
+    pub(crate) pilot: Arc<PilotAttempt>,
+}
+impl RequestTelemetry for PilotHttpTelemetry {
+    fn on_request(
+        &self,
+        attempt: u64,
+        status: Option<StatusCode>,
+        error: Option<&TransportError>,
+        duration: Duration,
+    ) {
+        self.pilot.observe_http_status(status);
+        // An HTTP response status confirms transport dispatch. A status-less failure does not.
+        self.pilot.emit(json!({"type":"http_attempt_completed","httpAttempt":attempt,
+            "status":status.map(|s|s.as_u16()),"dispatchConfirmed":status.map(|_|true),"failed":error.is_some()}));
+        self.inner.on_request(attempt, status, error, duration);
+    }
+}
