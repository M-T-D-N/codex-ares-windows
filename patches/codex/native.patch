+    async fn partial_publication_boundary(cancel: bool) {
+        use wiremock::Mock;
+        use wiremock::MockServer;
+        use wiremock::ResponseTemplate;
+        use wiremock::matchers::method;
+        let server = MockServer::start().await;
+        Mock::given(method("POST"))
+            .respond_with(ResponseTemplate::new(200).set_delay(Duration::from_secs(120)))
+            .mount(&server)
+            .await;
+        let url = server.uri();
+        let (session, turn, _events) =
+            crate::session::tests::make_session_and_context_with_auth_and_config_and_rx(
+                codex_login::CodexAuth::from_api_key("synthetic-reconnect-fixture"),
+                Vec::new(),
+                move |config| {
+                    config
+                        .mcp_servers
+                        .set(
+                            serde_json::from_value(json!({
+                                "pending": {"url": url, "startup_timeout_sec": 120.0}
+                            }))
+                            .unwrap(),
+                        )
+                        .unwrap();
+                },
+            )
+            .await;
+        let cancellation = CancellationToken::new();
+        let invocation =
+            boundary_invocation(Arc::clone(&session), turn, cancellation.clone()).await;
+        let before = session
+            .services
+            .mcp_runtime
+            .current_binding()
+            .await
+            .unwrap();
+        let operation = tokio::spawn(async move { McpRestartHandler.handle(invocation).await });
+        tokio::time::timeout(Duration::from_secs(10), async {
+            loop {
+                let published = session
+                    .services
+                    .mcp_runtime
+                    .current_binding()
+                    .await
+                    .unwrap();
+                if !Arc::ptr_eq(&before, &published) {
+                    break;
+                }
+                assert!(
+                    !operation.is_finished(),
+                    "restart must wait on the delayed fixture startup"
+                );
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .unwrap();
+        if cancel {
+            cancellation.cancel();
+        } else {
+            tokio::time::pause();
+            tokio::time::advance(Duration::from_secs(61)).await;
+        }
+        let result = operation.await.unwrap();
+        let error = result
+            .err()
+            .expect("partial publication must not be reported as successful reconnect");
+        assert!(error.to_string().contains(if cancel {
+            "interrupted"
+        } else {
+            "exceeded 60 seconds"
+        }));
+        let retained_partial = session
+            .services
+            .mcp_runtime
+            .current_binding()
+            .await
+            .unwrap();
+        assert!(
+            !Arc::ptr_eq(&before, &retained_partial),
+            "partial publication remains observable; no rollback is claimed"
+        );
+    }
