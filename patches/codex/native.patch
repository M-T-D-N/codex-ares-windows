+#[tokio::test]
+async fn ares_rpc_supported_websocket_steps_dispatch_high_xhigh_high() -> Result<()> {
+    let websocket = responses::start_websocket_server(vec![vec![
+        vec![
+            responses::ev_response_created("warmup"),
+            responses::ev_completed("warmup"),
+        ],
+        assistant_step("high-first", false),
+        assistant_step("xhigh", false),
+        assistant_step("high-last", true),
+    ]])
+    .await;
+    let provider = create_mock_responses_server_repeating_assistant("HTTP fallback unused").await;
+    let websocket_url = format!("{}/v1", websocket.uri());
+    let mut f = Fixture::with_provider(
+        "Sol 6.1-Ares",
+        "gpt-6.1-sol",
+        provider,
+        ProviderMode::SupportedWebsocket(&websocket_url),
+    )
+    .await?;
+    let warmup = timeout(WAIT, websocket.wait_for_request(0, 0))
+        .await?
+        .body_json();
+    assert_eq!(warmup["generate"], false);
+    assert_eq!(warmup["reasoning"]["effort"], "medium");
+
+    let turn = f.start().await?;
+    let (mut stream, mut cp) = checkpoint(&f.listener).await?;
+    let epoch = cp["connectionEpoch"].clone();
+    for (index, (from, to)) in [("medium", "high"), ("high", "xhigh"), ("xhigh", "high")]
+        .into_iter()
+        .enumerate()
+    {
+        let step = index as u64 + 1;
+        assert_step_checkpoint(&cp, &f, &turn, step, from, &epoch);
+        write_frame(&mut stream, &decision(&cp, to)).await?;
+        confirm(&mut stream, &cp, to).await?;
+        assert_effort_notification(&mut f, &turn, step, from, to).await?;
+        if index < 2 {
+            cp = next_checkpoint(&mut stream).await?;
+        }
+    }
+    f.completed(&turn, TurnStatus::Completed).await?;
+    assert!(f.shutdown().await?.is_empty());
+    assert!(
+        f.requests().await?.is_empty(),
+        "WS must not fall back to HTTP"
+    );
+
+    let requests = websocket.single_connection();
+    assert_eq!(requests.len(), 4, "one prewarm and three generations");
+    let bodies = requests[1..]
+        .iter()
+        .map(|request| request.body_json())
+        .collect::<Vec<_>>();
+    let mut effective = warmup["reasoning"]["effort"].clone();
+    for (index, expected) in ["high", "xhigh", "high"].into_iter().enumerate() {
+        let body = &bodies[index];
+        assert_eq!(body["model"], "gpt-6.1-sol");
+        assert_eq!(body["reasoning"]["effort"], "medium");
+        assert_ne!(body["generate"], false);
+        if index > 0 {
+            assert_eq!(
+                body["previous_response_id"],
+                ["high-first", "xhigh"][index - 1]
+            );
+        }
+        let updates = configuration_efforts(body);
+        assert_eq!(updates, vec![json!(expected)]);
+        // Delta requests inherit the preceding response's accepted configuration.
+        for update in updates {
+            effective = update;
+        }
+        assert_eq!(effective, expected);
+    }
+    websocket.shutdown().await;
+    Ok(())
+}
