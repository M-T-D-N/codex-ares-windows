+                    })).unwrap()).unwrap();
+                },
+            )
+        };
+        let (session, turn, _events) = create().await;
+        let (other, other_turn, _other_events) = create().await;
+        let old = session
+            .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let other_step = other
+            .capture_step_context(Arc::clone(&other_turn), &CancellationToken::new())
+            .await
+            .unwrap();
+        let before = session
