+impl StepController {
+    fn selected_base_model(&self, selection: &str) -> Option<&'static str> {
+        if self.luna_continuous_mode {
+            return self
+                .ares_selection
+                .filter(|selected| selected.alias == selection)
+                .map(|selected| selected.base_model);
+        }
+        if let Some(base) = JEV_MODELS
+            .iter()
+            .find_map(|(alias, base, _)| (*alias == selection).then_some(*base))
+        {
+            return Some(base);
+        }
+        #[cfg(windows)]
+        {
+            let marker = std::env::var("CODEX_STEP_CONTROLLER_PILOT_MARKER").ok()?;
+            if selection == ASTRA_JEV_BASE_MODEL
+                && !marker.is_empty()
+                && marker.len() <= 128
+                && marker.bytes().all(|byte| (b'!'..=b'~').contains(&byte))
+                && self.original_prompt.lines().next() == Some(marker.as_str())
+            {
+                return Some(ASTRA_JEV_BASE_MODEL);
+            }
+        }
+        None
+    }
+
+    pub(super) fn confirmed_sequence(&self) -> Option<u64> {
+        if self.luna_continuous_mode {
+            return self.trace_sequence;
+        }
+        (self.connection.is_some() && self.last_effort.is_some()).then_some(self.sequence)
+    }
+
+    pub(super) fn take_capture_fresh(&mut self) -> bool {
+        std::mem::take(&mut self.capture_fresh)
+    }
+
+    pub(super) fn new(turn: &TurnContext, input: &[UserInput]) -> Self {
+        let advice_mode = std::env::var("CODEX_STEP_CONTROLLER_ADVICE_MODE").ok();
+        let jev_control = turn.extension_data.get::<super::jev_main::JevMainControl>();
+        let ares_selection =
+            ares_selection(turn.initial_settings.selected_collaboration_mode().model());
+        let mut controller = Self {
+            connection: None,
+            connection_epoch: None,
+            sequence: 0,
+            trace_sequence: None,
+            failures: turn.extension_data.get_or_init(ToolFailureCounter::default),
+            original_prompt: String::new(),
+            latest_prompt: String::new(),
+            input_revision: 0,
+            last_effort: None,
+            owner_id: jev_control
+                .as_ref()
+                .map_or_else(uuid::Uuid::now_v7, |control| control.owner_id),
+            critic_advice_mode: advice_mode.as_deref() == Some("critic-assisted-1"),
+            luna_continuous_mode: advice_mode.as_deref() == Some("luna-continuous-1"),
+            jev_main_mode: jev_control.is_some(),
+            ares_selection,
+            last_review_episode: None,
+            failure_streak: 0,
+            retry_after: None,
+            exchange_timeout: Duration::from_secs(40),
+            capture_fresh: false,
+            admitted_input: AdmittedInput {
+                source: "none",
+                text: String::new(),
+                truncated: false,
+            },
+        };
+        controller.accept_user_input(input);
+        controller
+            .original_prompt
+            .clone_from(&controller.latest_prompt);
+        controller
+    }
+
+    pub(super) fn accept_user_input(&mut self, input: &[UserInput]) {
+        if !input.is_empty() {
+            self.input_revision += 1;
+            self.latest_prompt = input
+                .iter()
+                .filter_map(|item| match item {
+                    UserInput::Text { text, .. } => Some(text.as_str()),
+                    _ => None,
+                })
+                .collect::<Vec<_>>()
+                .join("\n");
+            if self.luna_continuous_mode && !self.latest_prompt.is_empty() {
+                let mut characters = self.latest_prompt.chars();
+                let preview = characters.by_ref().take(16_000).collect::<String>();
+                self.admitted_input = AdmittedInput {
+                    source: "user_text",
+                    text: preview,
+                    truncated: characters.next().is_some(),
+                };
+            }
+        }
+    }
+
+    async fn exchange(&mut self, message: &impl Serialize) -> Result<Reply> {
+        let data = serde_json::to_vec(message).map_err(|error| failure(error.to_string()))?;
+        if data.len() > 2_000_000 {
+            return Err(failure(
+                "context exceeds the 2 MB transport limit; no text was silently truncated",
+            ));
+        }
+        let connection = self
+            .connection
+            .as_mut()
+            .ok_or_else(|| failure("bridge is disconnected"))?;
+        let exchange = async {
+            connection.write_u32(data.len() as u32).await?;
+            connection.write_all(&data).await?;
+            let length = connection.read_u32().await? as usize;
+            if length == 0 || length > 4_096 {
+                return Err(std::io::Error::other("invalid evaluator reply length"));
+            }
+            let mut bytes = vec![0; length];
+            connection.read_exact(&mut bytes).await?;
+            Ok::<_, std::io::Error>(bytes)
+        };
+        let bytes = tokio::time::timeout(self.exchange_timeout, exchange)
+            .await
+            .map_err(|_| failure("decision timeout"))?
+            .map_err(|error| failure(error.to_string()))?;
+        let reply: Reply =
+            serde_json::from_slice(&bytes).map_err(|_| failure("invalid evaluator reply"))?;
+        if let Reply::Error { message } = reply {
+            return Err(failure(message));
+        }
+        Ok(reply)
+    }
+
+    #[cfg(windows)]
+    async fn connect_windows() -> Result<TcpStream> {
+        let endpoint = std::env::var("CODEX_STEP_CONTROLLER_TCP")
+            .map_err(|_| failure("Windows bridge endpoint is missing"))?;
+        let address = endpoint
+            .parse::<std::net::SocketAddrV4>()
+            .map_err(|_| failure("Windows bridge endpoint must be IPv4 loopback with a port"))?;
+        if *address.ip() != std::net::Ipv4Addr::LOCALHOST || address.port() == 0 {
+            return Err(failure(
+                "Windows bridge endpoint must be IPv4 loopback with a port",
+            ));
+        }
+        let token = std::env::var("CODEX_STEP_CONTROLLER_TOKEN")
+            .map_err(|_| failure("Windows bridge authentication token is missing"))?;
+        if !(32..=256).contains(&token.len())
+            || !token
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_')
+        {
+            return Err(failure("Windows bridge authentication token is invalid"));
+        }
+        let mut stream = tokio::time::timeout(
+            Duration::from_secs(5),
+            TcpStream::connect(std::net::SocketAddr::V4(address)),
+        )
+        .await
+        .map_err(|_| failure("Windows bridge connection timeout"))?
+        .map_err(|_| failure("Windows bridge connection failed"))?;
+        let authentication = serde_json::json!({"type": "authenticate", "token": token});
+        let data = serde_json::to_vec(&authentication)
+            .map_err(|_| failure("Windows bridge authentication failed"))?;
+        let reply = tokio::time::timeout(Duration::from_secs(5), async {
+            stream.write_u32(data.len() as u32).await?;
+            stream.write_all(&data).await?;
+            let length = stream.read_u32().await? as usize;
+            if length == 0 || length > 4_096 {
+                return Err(std::io::Error::other("invalid authentication reply length"));
+            }
+            let mut bytes = vec![0; length];
+            stream.read_exact(&mut bytes).await?;
+            Ok::<_, std::io::Error>(bytes)
+        })
+        .await
+        .map_err(|_| failure("Windows bridge authentication timeout"))?
+        .map_err(|_| failure("Windows bridge authentication failed"))?;
+        let acknowledgement: serde_json::Value = serde_json::from_slice(&reply)
+            .map_err(|_| failure("Windows bridge authentication failed"))?;
+        if acknowledgement != serde_json::json!({"type": "authenticated"}) {
+            return Err(failure("Windows bridge authentication failed"));
+        }
+        Ok(stream)
+    }
+
+    pub(super) async fn before_sampling(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+    ) -> Result<Option<AppliedSettings>> {
+        if self.luna_continuous_mode {
+            return self.before_sampling_luna(session, turn).await;
+        }
+        let initial = turn.current_settings.load_full();
+        let selection = initial.selected_collaboration_mode().model();
+        if self.selected_base_model(selection).is_none() {
+            self.connection = None;
+            self.sequence = 0;
+            self.last_effort = None;
+            return Ok(None);
+        };
+        if !session.enabled(Feature::StepModelSwitching)
+            || !session.enabled(Feature::ReasoningEffortOverride)
+        {
+            return Err(failure(
+                "Jev requires native step_model_switching and reasoning_effort_override",
+            ));
+        }
+        let snapshot = session
+            .snapshot_step_decision(turn, &self.original_prompt, &self.latest_prompt)
+            .await
+            .ok_or_else(|| failure("active turn changed before evaluation"))?;
+        // External publication relinquishes this opt-in turn to its manual owner,
+        // including same-value edits and clearing the effort to its native default.
+        if self.critic_advice_mode && snapshot.guard.external_settings_revision != 0 {
+            self.connection = None;
+            self.last_effort = None;
+            return Ok(None);
+        }
+        let current = Arc::clone(&snapshot.guard.settings);
+        let selection = current.selected_collaboration_mode().model();
+        let base_model = self
+            .selected_base_model(selection)
+            .ok_or_else(|| failure("model changed before evaluation"))?;
+        let model = &current.model_info;
+        if model.slug != base_model
+            || model.used_fallback_model_metadata
+            || !model.use_responses_lite
+            || model.supported_reasoning_levels.is_empty()
+        {
+            return Err(failure(format!(
+                "{selection} requires available native {base_model} metadata with adaptive effort support; received {}.",
+                model.slug
+            )));
+        }
+        if self.connection.is_none() {
+            #[cfg(unix)]
+            let connection = {
+                let socket = std::env::var_os("CODEX_STEP_CONTROLLER_SOCKET")
+                    .ok_or_else(|| failure("Jev requires its bridge. Launch astra-ares."))?;
+                tokio::time::timeout(Duration::from_secs(5), UnixStream::connect(socket))
+                    .await
+                    .map_err(|_| failure("connection timeout"))?
+                    .map_err(|error| failure(error.to_string()))?
+            };
+            #[cfg(windows)]
+            let connection = Self::connect_windows().await?;
+            self.connection = Some(connection);
+        }
+        self.sequence += 1;
+        let context = snapshot.context;
+        let supported_efforts = model
+            .supported_reasoning_levels
+            .iter()
+            .map(|preset| preset.effort.clone())
+            .collect::<Vec<_>>();
+        let checkpoint = Checkpoint {
+            protocol: 3,
+            r#type: "checkpoint",
+            thread_id: session.thread_id().to_string(),
+            turn_id: turn.sub_id.clone(),
+            step: self.sequence,
+            model: model.slug.clone(),
+            selection_alias: None,
+            route: None,
+            supported_efforts: supported_efforts.clone(),
+            current_effort: current.reasoning_effort().cloned(),
+            input_revision: self.input_revision,
+            failed_tool_count: self.failures.0.load(Ordering::Acquire),
+            advice_basis: AdviceBasis {
+                owner_id: self.owner_id,
+                accepted_input_revision: snapshot.guard.accepted_input_revision,
+                settings_revision: snapshot.guard.external_settings_revision,
+                first_window_id: snapshot.guard.window_ids.first_window_id,
+                previous_window_id: snapshot.guard.window_ids.previous_window_id,
+                window_id: snapshot.guard.window_ids.window_id,
+            },
+            context,
+            connection_epoch: None,
+            project: None,
+            admitted_input: None,
+        };
+        let Reply::Decision {
+            protocol,
+            thread_id,
+            turn_id,
+            step,
+            effort,
+            lease_steps,
+            evaluator_ms,
+            connection_epoch,
+        } = self.exchange(&checkpoint).await?
+        else {
+            return Err(failure("expected an evaluator decision"));
+        };
+        if protocol != 3
+            || thread_id != checkpoint.thread_id
+            || turn_id != checkpoint.turn_id
+            || step != checkpoint.step
+            || !supported_efforts.contains(&effort)
+            || connection_epoch.is_some()
+            || ![1, 2, 5, 10].contains(&lease_steps)
+            || (selection == ASTRA_JEV_BASE_MODEL && lease_steps != 1)
+        {
+            return Err(failure(
+                "decision does not match the active step or model capabilities",
+            ));
+        }
+        crate::pilot_trace::PilotGeneration::record_stage(
+            checkpoint.thread_id.clone(),
+            checkpoint.turn_id.clone(),
+            self.sequence,
+            Some(effort.to_string()),
+            "native_selected",
+        );
+        match session
+            .apply_step_decision(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    effort: Some(Some(effort.clone())),
+                    ..Default::default()
+                },
+                snapshot.guard,
+            )
+            .await
+        {
+            TurnSettingsUpdateOutcome::Applied => {}
+            TurnSettingsUpdateOutcome::Rejected { reason } => return Err(failure(reason)),
+            TurnSettingsUpdateOutcome::TargetUnavailable => {
+                return Err(failure(
+                    "stale evaluator decision; active turn settings, input, or window changed",
+                ));
+            }
+        }
+        crate::pilot_trace::PilotGeneration::record_stage(
+            checkpoint.thread_id.clone(),
+            checkpoint.turn_id.clone(),
+            self.sequence,
+            Some(effort.to_string()),
+            "native_published",
+        );
+        Ok(Some(AppliedSettings {
+            model: model.slug.clone(),
+            previous_effort: current.reasoning_effort().cloned(),
+            effort,
+            lease_steps,
+            evaluator_ms,
+            from_bridge: true,
+            main_request_call_id: None,
+        }))
+    }
+
+    pub(super) async fn confirm(
+        &mut self,
+        session: &Session,
+        turn: &TurnContext,
+        step: &StepContext,
+        applied: AppliedSettings,
+    ) -> Result<()> {
+        if self.luna_continuous_mode {
+            return self.confirm_luna(session, turn, step, applied).await;
+        }
+        if step.settings.reasoning_effort() != Some(&applied.effort)
+            || step.settings.model_info.slug != applied.model
+            || self.selected_base_model(step.settings.selected_collaboration_mode().model())
+                != Some(applied.model.as_str())
+        {
+            return Err(failure(
+                "selected settings were not captured by the sampling step",
+            ));
+        }
+        let event = ReasoningEffortUpdatedEvent {
+            from_effort: applied
+                .previous_effort
+                .as_ref()
+                .filter(|effort| *effort != &applied.effort)
+                .map(ToString::to_string),
+            to_effort: applied.effort.to_string(),
+            step: self.sequence,
+            lease_steps: applied.lease_steps,
+            evaluator_ms: applied.evaluator_ms,
+        };
+        let receipt = serde_json::json!({
+            "protocol": 3, "type": "applied", "threadId": session.thread_id().to_string(),
+            "turnId": turn.sub_id, "step": self.sequence, "effort": applied.effort,
+            "confirmation": "native_step_context_captured"
+        });
+        match self.exchange(&receipt).await? {
+            Reply::Recorded {
+                protocol: 3,
+                step,
+                thread_id: None,
+                turn_id: None,
+                connection_epoch: None,
+            } if step == self.sequence => {}
+            _ => return Err(failure("bridge did not record the native confirmation")),
+        }
+        if self.last_effort.is_none() || applied.previous_effort.as_ref() != Some(&applied.effort) {
+            session
+                .send_event(turn, EventMsg::ReasoningEffortUpdated(event))
+                .await;
+        }
+        self.last_effort = Some(applied.effort);
+        Ok(())
+    }
+}
