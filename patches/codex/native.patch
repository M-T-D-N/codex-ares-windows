+#[test]
+fn storage_roots_contract_rejects_default_fallback_before_database_startup() -> Result<()> {
+    for config in ["log_dir = \"different-log\"\n", "log_dir = [\n"] {
+        let home = TempDir::new()?;
+        let baseline = codex_command(home.path())?
+            .env("CODEX_SQLITE_HOME", home.path())
+            .env_remove("CODEX_ARES_EXPECTED_STORAGE_ROOTS")
+            .args([
+                "app-server",
+                "--print-startup-config",
+                "--include-storage-roots",
+            ])
+            .output()?;
+        assert!(baseline.status.success());
+        let baseline: serde_json::Value = serde_json::from_slice(&baseline.stdout)?;
+        std::fs::write(home.path().join("config.toml"), config)?;
+        // Exercise the real non-strict server startup, including its recovery
+        // path, not just the one-shot config query or error classifier.
+        codex_command(home.path())?
+            .env("CODEX_SQLITE_HOME", home.path())
+            .env(
+                "CODEX_ARES_EXPECTED_STORAGE_ROOTS",
+                baseline["storageRoots"].to_string(),
+            )
+            .args(["app-server", "--listen", "off"])
+            .assert()
+            .failure()
+            .stderr(contains(
+                "Ares storage root contract forbids default configuration fallback",
+            ));
+        for database in [
+            "state_5.sqlite",
+            "logs_2.sqlite",
+            "goals_1.sqlite",
+            "memories_1.sqlite",
+            "queue_1.sqlite",
+        ] {
+            assert!(!home.path().join(database).exists(), "{database}");
+        }
+    }
+    // Keep ordinary upstream config-repair behavior when no roots were pinned.
+    let home = TempDir::new()?;
+    std::fs::write(home.path().join("config.toml"), "log_dir = [\n")?;
+    codex_command(home.path())?
+        .env("CODEX_SQLITE_HOME", home.path())
+        .env_remove("CODEX_ARES_EXPECTED_STORAGE_ROOTS")
+        .args(["app-server", "--listen", "off"])
+        .assert()
+        .failure()
+        .stderr(contains("no transport configured"));
+    assert!(home.path().join("state_5.sqlite").exists());
+    Ok(())
+}
