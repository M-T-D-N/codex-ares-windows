+#[tokio::test]
+async fn pre_tool_use_without_matching_hooks_does_not_materialize_transcript() {
+    for matcher in [None, Some("^Bash$")] {
+        let (mut session, turn_context) = make_session_and_context().await;
+        if let Some(matcher) = matcher {
+            configure_tool_use_test_hook(&mut session, "PreToolUse", matcher).await;
+        }
+        let rollout_path = open_thread_persistence(&mut session).await;
+        assert!(!rollout_path.exists());
+        let session = Arc::new(session);
+        let step_context = StepContext::for_test(Arc::new(turn_context));
+        let tool_name =
+            crate::tools::hook_names::HookToolName::new("mcp__agentmemory__memory_smart_search");
+        let outcome = crate::hook_runtime::run_pre_tool_use_hooks(
+            &session,
+            &step_context,
+            "test-call".to_string(),
+            &tool_name,
+            &json!({"query": "test"}),
+            None,
+            &[],
+        )
+        .await;
+        assert!(matches!(
+            outcome,
+            crate::hook_runtime::PreToolUseHookResult::Continue {
+                updated_input: None
+            }
+        ));
+        assert!(
+            !rollout_path.exists(),
+            "unmatched pre hooks must not persist a transcript"
+        );
+    }
+}
