+        "responses_http",
+    );
+    let second = generation.request(
+        "gpt-6-astra",
+        Some("high".into()),
+        &reviewed,
+        None,
+        "responses_websocket",
+    );
+    let rows = std::fs::read_to_string(&path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str::<Value>(line).unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[0]["reviewNoticeInRequestInput"], false);
+    assert_eq!(rows[1]["reviewNoticeInRequestInput"], true);
+    assert_ne!(rows[0]["requestInputSha1"], rows[1]["requestInputSha1"]);
+    assert_eq!(
+        rows[1]["requestInputSha1"],
+        format!("{:x}", Sha1::digest(serde_json::to_vec(&reviewed).unwrap()))
+    );
+    assert!(rows.iter().all(|row| row.get("input").is_none()));
+    assert!(
+        !std::fs::read_to_string(&path)
+            .unwrap()
+            .contains("Continue the current task")
+    );
+    drop((first, second));
+}
+
+fn scalar_attempt(path: PathBuf, transport: &'static str) -> Arc<PilotAttempt> {
+    Arc::new(PilotGeneration {
+        path,
+        thread_id: "thread".into(),
+        turn_id: "turn".into(),
+        step: 1,
+        attempts: AtomicU64::new(0),
+        jev_input_evidence: AtomicBool::new(false),
+    })
+    .request("gpt-6-astra", None, &[], None, transport)
+}
+
+fn scalar_rows(path: &std::path::Path) -> Vec<Value> {
+    std::fs::read_to_string(path)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect()
+}
+
+#[test]
+fn scalar_stream_failure_records_static_class_status_transport_and_elapsed_without_secrets() {
+    const SECRET: &str = "SENTINEL_SECRET_MUST_NOT_ENTER_PILOT_TRACE";
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let mut headers = http::HeaderMap::new();
+    headers.insert(
+        http::header::AUTHORIZATION,
+        http::HeaderValue::from_static(SECRET),
+    );
+    let cases = [
+        (
+            ApiError::Api {
+                status: StatusCode::BAD_REQUEST,
+                message: SECRET.into(),
+            },
+            "api",
+            Some(400),
+        ),
+        (
+            ApiError::Transport(TransportError::Http {
+                status: StatusCode::SERVICE_UNAVAILABLE,
+                url: Some(SECRET.into()),
+                headers: Some(headers),
+                body: Some(SECRET.into()),
+                retry_after: None,
+            }),
+            "transport_http",
+            Some(503),
+        ),
+        (ApiError::Stream(SECRET.into()), "stream", None),
+        (
+            ApiError::Transport(TransportError::Network(SECRET.into())),
+            "transport_network",
+            None,
+        ),
+        (
+            ApiError::Retryable {
+                message: SECRET.into(),
+                retry_after: None,
+            },
+            "retryable",
+            None,
+        ),
+        (
+            ApiError::Transport(TransportError::Timeout),
+            "transport_timeout",
+            None,
+        ),
+    ];
+    for (error, expected_class, expected_status) in cases {
+        for transport in ["responses_http", "responses_websocket"] {
+            let attempt = scalar_attempt(path.clone(), transport);
+            attempt.failed(&error, "stream", None);
+            drop(attempt);
+            let rows = scalar_rows(&path);
+            let failure = rows.last().unwrap();
+            assert_eq!(failure["type"], "response_failed");
+            assert_eq!(failure["stage"], "stream");
+            assert_eq!(failure["errorClass"], expected_class);
+            assert_eq!(failure["httpStatus"], json!(expected_status));
+            assert_eq!(failure["transport"], transport);
+            assert!(failure["elapsedMs"].is_u64());
+        }
+    }
+    assert_eq!(scalar_rows(&path).len(), 24);
+    let contents = std::fs::read_to_string(&path).unwrap();
+    assert!(!contents.contains(SECRET));
+    assert!(!contents.contains("authorization"));
+    assert!(!contents.contains("request_abandoned"));
+}
+
+#[test]
+fn scalar_failure_and_cancellation_keep_the_first_terminal_through_drop() {
+    let dir = tempfile::tempdir().unwrap();
+    for failure_first in [true, false] {
+        let path = dir.path().join(format!("trace-{failure_first}.jsonl"));
+        let attempt = scalar_attempt(path.clone(), "responses_http");
+        let other_owner = Arc::clone(&attempt);
+        if failure_first {
+            attempt.failed(&ApiError::ContentFilter, "stream", None);
+        }
+        attempt.terminal(json!({"type": "response_cancelled"}));
+        attempt.failed(&ApiError::QuotaExceeded, "stream", None);
+        drop(attempt);
+        drop(other_owner);
+        let rows = scalar_rows(&path);
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[0]["type"], "request_prepared");
+        assert_eq!(rows[0]["requestId"], rows[1]["requestId"]);
+        if failure_first {
+            assert_eq!(rows[1]["type"], "response_failed");
+            assert_eq!(rows[1]["errorClass"], "content_filter");
+        } else {
+            assert_eq!(rows[1]["type"], "response_cancelled");
+        }
+    }
+}
+
+#[test]
+fn scalar_attempt_drop_records_one_abandonment_after_the_last_owner() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let attempt = scalar_attempt(path.clone(), "responses_websocket");
+    let other_owner = Arc::clone(&attempt);
+    drop(attempt);
+    assert_eq!(scalar_rows(&path).len(), 1);
+    drop(other_owner);
+    let rows = scalar_rows(&path);
+    assert_eq!(rows.len(), 2);
+    assert_eq!(rows[1]["type"], "request_abandoned");
+    assert_eq!(rows[0]["requestId"], rows[1]["requestId"]);
+}
+
+#[test]
+fn scalar_statusless_attempt_clears_prior_status_and_explicit_error_status_wins() {
+    let dir = tempfile::tempdir().unwrap();
+    let path = dir.path().join("trace.jsonl");
+    let first = scalar_attempt(path.clone(), "responses_http");
+    first.observe_http_status(Some(StatusCode::TOO_MANY_REQUESTS));
+    first.observe_http_status(None);
+    first.failed(
+        &ApiError::Transport(TransportError::Network("private".into())),
+        "http_before_stream",
+        None,
+    );
+    let second = scalar_attempt(path.clone(), "responses_http");
+    second.observe_http_status(Some(StatusCode::TOO_MANY_REQUESTS));
+    second.failed(
+        &ApiError::Api {
+            status: StatusCode::BAD_GATEWAY,
+            message: "private".into(),
+        },
+        "http_before_stream",
+        None,
+    );
+    drop((first, second));
+    let rows = scalar_rows(&path);
+    assert_eq!(rows[1]["httpStatus"], Value::Null);
+    assert_eq!(rows[1]["errorClass"], "transport_network");
+    assert_eq!(rows[3]["httpStatus"], 502);
+    assert_eq!(rows[3]["errorClass"], "api");
+    assert!(
+        rows.iter()
+            .all(|row| row.to_string().find("private").is_none())
+    );
+}
+
+#[test]
+fn scalar_terminal_common_fields_cover_cancel_eof_drop_and_dispatch_guard() {
+    let dir = tempfile::tempdir().unwrap();
+    for (kind, expected_class) in [
+        ("response_cancelled", "cancelled"),
+        ("response_incomplete", "stream_eof"),
+        ("request_abandoned", "request_abandoned"),
+        ("dispatch", "dispatch_future_dropped"),
+    ] {
+        let path = dir.path().join(format!("{kind}.jsonl"));
+        let attempt = scalar_attempt(path.clone(), "responses_websocket");
+        if kind == "dispatch" {
+            let guard = attempt.dispatch_guard("websocket_before_stream");
+            drop(guard);
+        } else if kind != "request_abandoned" {
+            attempt.terminal(json!({"type":kind}));
+        }
+        drop(attempt);
+        let rows = scalar_rows(&path);
+        assert_eq!(rows.len(), 2);
+        assert_eq!(rows[1]["errorClass"], expected_class);
+        assert_eq!(rows[1]["transport"], "responses_websocket");
+        assert_eq!(rows[1]["httpStatus"], Value::Null);
+        assert!(rows[1]["elapsedMs"].is_u64());
+    }
+}
