+    assert_eq!(read(&child_handle).unwrap(), child_before);
+    // The child's legacy SYSTEM mask is deliberately preserved, not repaired.
+    let (mut child_acl, child_control) = read(&child_handle).unwrap();
+    assert!(upgrade(&mut child_acl, child_control).unwrap());
