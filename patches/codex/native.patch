+    /// Retains buffered and final protocol messages through EOF for negative assertions.
+    /// Unlike shutdown_gracefully, this does not discard notifications from teardown.
+    pub async fn shutdown_collect_messages(
+        &mut self,
+    ) -> anyhow::Result<(ExitStatus, Vec<JSONRPCMessage>)> {
+        drop(self.stdin.take());
+        let mut messages: Vec<_> = self.pending_messages.drain(..).collect();
+        loop {
+            let mut line = String::new();
+            if self.stdout.read_line(&mut line).await? == 0 {
+                break;
+            }
+            messages.push(serde_json::from_str(&line).context("invalid JSON-RPC during shutdown")?);
+        }
+        let status = self.process.wait().await?;
+        Ok((status, messages))
+    }
