+fn pilot_completed_sse() -> ResponseTemplate {
+    ResponseTemplate::new(200)
+        .insert_header("content-type", "text/event-stream")
+        .set_body_string(concat!(
+            "data: {\"type\":\"response.created\",\"response\":{\"id\":\"pilot-response\"}}\n\n",
+            "data: {\"type\":\"response.completed\",\"response\":{\"id\":\"pilot-response\"}}\n\n",
+        ))
+}
