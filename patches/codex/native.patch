+    let (release_tx, release_rx) = oneshot::channel();
+    let decision_session = Arc::clone(&session);
+    let turn_id = turn.sub_id.clone();
+    let decision = tokio::spawn(async move {
+        ready_tx.send(()).expect("announce evaluator await");
+        release_rx.await.expect("evaluator reply");
+        decision_session
