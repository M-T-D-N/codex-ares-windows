+    ready_rx.await.expect("evaluator is waiting");
+    let expected = match change {
+        EvaluatorChangeWhileAwaiting::QueuedSteer => {
+            let turn_state = session
+                .input_queue
+                .turn_state_for_sub_id(&session.active_turn, &turn.sub_id)
