+    let file = fs::File::open(&path).expect("keep an existing read handle");
+    let pool = store.thread_history_db().await.expect("history database");
+    let before = projection_state(pool, thread_id).await;
+    let identity = Command::new("whoami.exe")
+        .args(["/user", "/fo", "csv", "/nh"])
+        .output()
+        .expect("query the test user's SID");
+    assert!(identity.status.success());
+    let identity = String::from_utf8(identity.stdout).expect("ASCII SID in CSV output");
+    let sid = identity
+        .split(',')
+        .next_back()
+        .expect("SID column")
+        .trim()
+        .trim_matches('"');
+    assert!(sid.starts_with("S-1-"));
+    let denied = Command::new("icacls.exe")
+        .arg(&path)
+        .args(["/deny", &format!("*{sid}:(RD)")])
+        .output()
+        .expect("deny new data reads on this test fixture only");
+    assert!(denied.status.success(), "{denied:?}");
+    let reopen = fs::File::open(&path);
+    let append = store
+        .append_items(AppendThreadItemsParams {
+            thread_id,
+            items: vec![turn_started("turn-2")],
+        })
+        .await;
+    let projected = projection_state(pool, thread_id).await;
+    let durable_length = i64::try_from(file.metadata().expect("existing handle metadata").len())
+        .expect("durable length");
+    let restored = Command::new("icacls.exe")
+        .arg(&path)
+        .args(["/remove:d", &format!("*{sid}")])
+        .output()
+        .expect("restore fixture access before assertions and cleanup");
+    drop(file);
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("close writer");
+    assert!(restored.status.success(), "{restored:?}");
+    assert_eq!(
+        reopen.expect_err("new reader must be denied").kind(),
+        std::io::ErrorKind::PermissionDenied
+    );
+    append.expect("existing append handle must remain usable");
+    assert_eq!(projected, (durable_length, before.1 + 1));
+}
