+
+#[tokio::test]
+async fn clock_cleanup_does_not_block_on_callback_lock() {
+    let (outgoing, _rx) = sender(1);
+    let pending = outgoing
+        .send_current_time_request(
+            ConnectionId(7),
+            ThreadId::new(),
+            Instant::now() + Duration::from_secs(1),
+        )
+        .await
+        .unwrap();
+    let callbacks = outgoing.request_id_to_callback.lock().await;
+    drop(pending);
+    assert_eq!(callbacks.len(), 1);
+    drop(callbacks);
+    timeout(Duration::from_secs(1), async {
