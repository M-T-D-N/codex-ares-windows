@@ -35,6 +35,58 @@ use crate::ThreadStoreResult;
 use crate::UpdateThreadMetadataParams;
 use crate::local::read_thread;
 
+pub(super) async fn record_thread_metadata(
+    store: &LocalThreadStore,
+    params: UpdateThreadMetadataParams,
+) -> ThreadStoreResult<()> {
+    if try_record_live_timestamp(store, &params).await {
+        return Ok(());
+    }
+    update_thread_metadata(store, params).await.map(|_| ())
+}
+
+async fn try_record_live_timestamp(
+    store: &LocalThreadStore,
+    params: &UpdateThreadMetadataParams,
+) -> bool {
+    let Some(updated_at) = params.patch.updated_at else {
+        return false;
+    };
+    if !params.patch.is_empty_except_updated_at() {
+        return false;
+    }
+    // Preserve staged facts and the existing repair/compatibility path. Hold any pending
+    // entry until this write finishes, just as update_thread_metadata does.
+    let pending = store.pending_thread_metadata.lock(params.thread_id).await;
+    if pending.is_some() {
+        return false;
+    }
+    let Ok(live_path) = live_writer::rollout_path(store, params.thread_id).await else {
+        return false;
+    };
+    let Some(state_db) = store.state_db().await else {
+        return false;
+    };
+    let Ok(Some(metadata)) = state_db.get_thread(params.thread_id).await else {
+        return false;
+    };
+    if metadata.rollout_path != live_path
+        || (!params.include_archived
+            && (metadata.archived_at.is_some() || rollout_path_is_archived(store, &live_path)))
+    {
+        return false;
+    }
+    // The live writer already validated canonical identity. This API returns no thread,
+    // so timestamp-only recording must not reopen its header to hydrate a discarded value.
+    // SQLite is still awaited; failures keep the existing error/repair behavior.
+    matches!(
+        state_db
+            .touch_thread_updated_at(params.thread_id, updated_at)
+            .await,
+        Ok(true)
+    )
+}
