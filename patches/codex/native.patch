+#[tokio::test]
+async fn live_projection_advances_when_the_immutable_header_is_locked() {
+    use std::io::BufRead;
+    use std::os::windows::io::AsRawHandle;
+
+    #[link(name = "kernel32")]
+    unsafe extern "system" {
+        fn LockFile(
+            file: *mut std::ffi::c_void,
+            offset_low: u32,
+            offset_high: u32,
+            length_low: u32,
+            length_high: u32,
+        ) -> i32;
+    }
+
+    let home = TempDir::new().expect("temp dir");
+    let store = projection_store(home.path()).await;
+    let thread_id = ThreadId::new();
+    create_paginated_thread(&store, thread_id).await;
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id,
+            items: vec![turn_started("turn-1")],
+        })
+        .await
+        .expect("write and project the first turn");
+    let path = store
+        .live_rollout_path(thread_id)
+        .await
+        .expect("rollout path");
+    let pool = store.thread_history_db().await.expect("history database");
+    let before = projection_state(pool, thread_id).await;
+    let file = fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(&path)
+        .expect("open the header lock handle");
+    let mut header = Vec::new();
+    std::io::BufReader::new(&file)
+        .read_until(b'\n', &mut header)
+        .expect("read the immutable header before locking it");
+    let header_length = u32::try_from(header.len()).expect("header length");
+    // Windows enforces this range lock for reads by other handles. Appended history
+    // remains readable, so this distinguishes a repeated header read from a tail read.
+    let locked = unsafe {
+        LockFile(
+            file.as_raw_handle(),
+            /*offset_low*/ 0,
+            /*offset_high*/ 0,
+            header_length,
+            /*length_high*/ 0,
+        )
+    };
+    assert_eq!(
+        locked,
+        1,
+        "lock only the header: {}",
+        std::io::Error::last_os_error()
+    );
+    store
+        .append_items(AppendThreadItemsParams {
+            thread_id,
+            items: vec![turn_started("turn-2")],
+        })
+        .await
+        .expect("append canonical history beyond the locked header");
+    let durable_length =
+        i64::try_from(file.metadata().expect("rollout metadata").len()).expect("durable length");
+    let projected = projection_state(pool, thread_id).await;
+    drop(file);
+    store
+        .shutdown_thread(thread_id)
+        .await
+        .expect("close writer");
+    assert_eq!(projected, (durable_length, before.1 + 1));
+}
