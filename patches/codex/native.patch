@@ -0,0 +1,544 @@
+//! Synthetic stdio RPC -> native controller -> loopback HTTP/WS coverage; no live provider.
+use anyhow::Result;
+use app_test_support::{
+    MockResponsesConfig, TestAppServer, create_mock_responses_server_repeating_assistant,
+    create_mock_responses_server_sequence, write_models_cache_with_models,
+};
+use codex_app_server_protocol::{
+    ClientRequest, JSONRPCMessage, ReasoningEffortUpdatedNotification, ThreadStartParams,
+    TurnCompletedNotification, TurnInterruptParams, TurnSettingsUpdateParams,
+    TurnSettingsUpdateResponse, TurnSettingsUpdateStatus, TurnStartParams, TurnStartResponse,
+    TurnStatus, UserInput,
+};
+use codex_models_manager::model_info::model_info_from_slug;
+use codex_protocol::openai_models::{ReasoningEffort, ReasoningEffortPreset};
+use core_test_support::responses;
+use serde_json::{Value, json};
+use std::time::Duration;
+use tempfile::TempDir;
+use test_case::test_case;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::time::timeout;
+use wiremock::MockServer;
+
+const WAIT: Duration = Duration::from_secs(30);
+const TOKEN: &str = "synthetic-ares-rpc-token-not-an-authentication-credential";
+const METHOD: &str = "turn/reasoningEffort/updated";
+
+async fn read_frame(stream: &mut TcpStream) -> Result<Value> {
+    let size = timeout(WAIT, stream.read_u32()).await?? as usize;
+    anyhow::ensure!(size <= 1024 * 1024, "oversized synthetic frame");
+    let mut bytes = vec![0; size];
+    timeout(WAIT, stream.read_exact(&mut bytes)).await??;
+    Ok(serde_json::from_slice(&bytes)?)
+}
+async fn write_frame(stream: &mut TcpStream, value: &Value) -> Result<()> {
+    let bytes = serde_json::to_vec(value)?;
+    timeout(WAIT, stream.write_u32(bytes.len() as u32)).await??;
+    timeout(WAIT, stream.write_all(&bytes)).await??;
+    Ok(())
+}
+async fn checkpoint(listener: &TcpListener) -> Result<(TcpStream, Value)> {
+    let (mut stream, _) = timeout(WAIT, listener.accept()).await??;
+    assert_eq!(
+        read_frame(&mut stream).await?,
+        json!({"type":"authenticate","token":TOKEN})
+    );
+    write_frame(&mut stream, &json!({"type":"authenticated"})).await?;
+    let value = next_checkpoint(&mut stream).await?;
+    Ok((stream, value))
+}
+async fn next_checkpoint(stream: &mut TcpStream) -> Result<Value> {
+    let value = read_frame(stream).await?;
+    assert_eq!(value["type"], "checkpoint");
+    assert_eq!(value["protocol"], 4);
+    Ok(value)
+}
+fn decision(cp: &Value, effort: &str) -> Value {
+    json!({"protocol":4,"type":"decision","threadId":cp["threadId"],"turnId":cp["turnId"],
+        "step":cp["step"],"connectionEpoch":cp["connectionEpoch"],"effort":effort,
+        "leaseSteps":1,"evaluatorMs":3})
+}
+async fn confirm(stream: &mut TcpStream, cp: &Value, effort: &str) -> Result<()> {
+    let applied = read_frame(stream).await?;
+    assert_eq!(applied["type"], "applied");
+    assert_eq!(applied["protocol"], 4);
+    assert_eq!(applied["threadId"], cp["threadId"]);
+    assert_eq!(applied["turnId"], cp["turnId"]);
+    assert_eq!(applied["step"], cp["step"]);
+    assert_eq!(applied["connectionEpoch"], cp["connectionEpoch"]);
+    assert_eq!(applied["effort"], effort);
+    assert_eq!(applied["confirmation"], "native_step_context_captured");
+    write_frame(
+        stream,
+        &json!({"protocol":4,"type":"recorded","threadId":cp["threadId"],
+        "turnId":cp["turnId"],"step":cp["step"],"connectionEpoch":cp["connectionEpoch"]}),
+    )
+    .await
+}
+enum ProviderMode<'a> {
+    UnsupportedHttp,
+    SupportedHttp,
+    SupportedWebsocket(&'a str),
+}
+struct Fixture {
+    app: TestAppServer,
+    _home: TempDir,
+    provider: MockServer,
+    listener: TcpListener,
+    thread: String,
+}
+impl Fixture {
+    async fn new(alias: &str, base: &str) -> Result<Self> {
+        let provider =
+            create_mock_responses_server_repeating_assistant("Synthetic RPC complete").await;
+        Self::with_provider(alias, base, provider, ProviderMode::UnsupportedHttp).await
+    }
+    async fn with_provider(
+        alias: &str,
+        base: &str,
+        provider: MockServer,
+        mode: ProviderMode<'_>,
+    ) -> Result<Self> {
+        let home = TempDir::new()?;
+        let config = MockResponsesConfig::new(&provider.uri())
+            .with_model(alias)
+            // Use the Ares launch default and upstream effort-update default, not fixture flags.
+            .with_root_config("model_reasoning_effort = \"medium\"");
+        let supported_updates = !matches!(mode, ProviderMode::UnsupportedHttp);
+        let config = match mode {
+            ProviderMode::UnsupportedHttp => config,
+            ProviderMode::SupportedHttp => config
+                .with_provider_name("OpenAI")
+                .with_provider_config("supports_websockets = false"),
+            ProviderMode::SupportedWebsocket(url) => config
+                .with_provider_name("OpenAI")
+                .with_provider_base_url(url)
+                .with_provider_config("supports_websockets = true"),
+        };
+        config.write(home.path())?;
+        let mut model = model_info_from_slug(base);
+        model.used_fallback_model_metadata = false;
+        model.use_responses_lite = true;
+        model.supports_reasoning_effort_updates = supported_updates;
+        model.context_window = Some(272_000);
+        model.effective_context_window_percent = 95;
+        model.supported_reasoning_levels = [
+            ReasoningEffort::Medium,
+            ReasoningEffort::High,
+            ReasoningEffort::XHigh,
+            ReasoningEffort::Max,
+        ]
+        .into_iter()
+        .map(|effort| ReasoningEffortPreset {
+            effort,
+            description: "Synthetic supported effort".to_string(),
+        })
+        .collect();
+        write_models_cache_with_models(home.path(), vec![model]).await?;
+        let listener = TcpListener::bind("127.0.0.1:0").await?;
+        let address = listener.local_addr()?.to_string();
+        let mut app = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .with_env_overrides(&[
+                (
+                    "CODEX_STEP_CONTROLLER_ADVICE_MODE",
+                    Some("luna-continuous-1"),
+                ),
+                ("CODEX_STEP_CONTROLLER_TCP", Some(&address)),
+                ("CODEX_STEP_CONTROLLER_TOKEN", Some(TOKEN)),
+            ])
+            .build_initialized()
+            .await?;
+        let started = app
+            .start_thread(ThreadStartParams {
+                model: Some(alias.to_string()),
+                ..Default::default()
+            })
+            .await?;
+        assert_eq!(started.model, alias);
+        assert_eq!(started.model_context_window, Some(258_400));
+        Ok(Self {
+            app,
+            _home: home,
+            provider,
+            listener,
+            thread: started.thread.id,
+        })
+    }
+    async fn start(&mut self) -> Result<String> {
+        let response: TurnStartResponse = self
+            .app
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id: self.thread.clone(),
+                    input: vec![UserInput::Text {
+                        text: "Reply with one short synthetic answer.".to_string(),
+                        text_elements: vec![],
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        Ok(response.turn.id)
+    }
+    async fn completed(&mut self, turn: &str, status: TurnStatus) -> Result<()> {
+        let event: TurnCompletedNotification =
+            timeout(WAIT, self.app.read_notification("turn/completed")).await??;
+        assert_eq!(event.thread_id, self.thread);
+        assert_eq!(event.turn.id, turn);
+        assert_eq!(event.turn.status, status);
+        Ok(())
+    }
+    async fn requests(&self) -> Result<Vec<Value>> {
+        self.provider
+            .received_requests()
+            .await
+            .unwrap_or_default()
+            .iter()
+            .filter(|r| r.url.path().ends_with("/responses"))
+            .map(|r| Ok(r.body_json()?))
+            .collect()
+    }
+    async fn shutdown(&mut self) -> Result<Vec<ReasoningEffortUpdatedNotification>> {
+        let (status, messages) = timeout(WAIT, self.app.shutdown_collect_messages()).await??;
+        assert!(status.success());
+        messages
+            .into_iter()
+            .filter_map(|message| match message {
+                JSONRPCMessage::Notification(event) if event.method == METHOD => Some(event),
+                _ => None,
+            })
+            .map(|event| {
+                Ok(serde_json::from_value(event.params.ok_or_else(|| {
+                    anyhow::anyhow!("missing notification params")
+                })?)?)
+            })
+            .collect()
+    }
+}
+
+fn assistant_step(id: &str, end_turn: bool) -> Vec<Value> {
+    let mut completed = responses::ev_completed(id);
+    completed["response"]["end_turn"] = json!(end_turn);
+    vec![
+        responses::ev_response_created(id),
+        responses::ev_assistant_message(&format!("message-{id}"), "Synthetic continuation"),
+        completed,
+    ]
+}
+
+fn configuration_efforts(body: &Value) -> Vec<Value> {
+    body["input"]
+        .as_array()
+        .expect("request input")
+        .iter()
+        .filter(|item| item["type"] == "configuration_update")
+        .map(|item| item["reasoning"]["effort"].clone())
+        .collect()
+}
+
+fn assert_step_checkpoint(
+    cp: &Value,
+    fixture: &Fixture,
+    turn: &str,
+    step: u64,
+    current_effort: &str,
+    epoch: &Value,
+) {
+    assert_eq!(cp["protocol"], 4);
+    assert_eq!(cp["threadId"], fixture.thread);
+    assert_eq!(cp["turnId"], turn);
+    assert_eq!(cp["model"], "gpt-6.1-sol");
+    assert_eq!(cp["selectionAlias"], "Sol 6.1-Ares");
+    assert_eq!(cp["step"], step);
+    assert_eq!(cp["currentEffort"], current_effort);
+    assert!(epoch.as_str().is_some_and(|epoch| !epoch.is_empty()));
+    assert_eq!(&cp["connectionEpoch"], epoch);
+}
+
+async fn assert_effort_notification(
+    fixture: &mut Fixture,
+    turn: &str,
+    step: u64,
+    from: &str,
+    to: &str,
+) -> Result<()> {
+    let event: ReasoningEffortUpdatedNotification =
+        timeout(WAIT, fixture.app.read_notification(METHOD)).await??;
+    assert_eq!(event.thread_id, fixture.thread);
+    assert_eq!(event.turn_id, turn);
+    assert_eq!(event.step, step);
+    assert_eq!(event.from_effort.as_deref(), Some(from));
+    assert_eq!(event.to_effort, to);
+    Ok(())
+}
+
+#[tokio::test]
+async fn ares_rpc_supported_websocket_steps_dispatch_high_xhigh_high() -> Result<()> {
+    let websocket = responses::start_websocket_server(vec![vec![
+        vec![
+            responses::ev_response_created("warmup"),
+            responses::ev_completed("warmup"),
+        ],
+        assistant_step("high-first", false),
+        assistant_step("xhigh", false),
+        assistant_step("high-last", true),
+    ]])
+    .await;
+    let provider = create_mock_responses_server_repeating_assistant("HTTP fallback unused").await;
+    let websocket_url = format!("{}/v1", websocket.uri());
+    let mut f = Fixture::with_provider(
+        "Sol 6.1-Ares",
+        "gpt-6.1-sol",
+        provider,
+        ProviderMode::SupportedWebsocket(&websocket_url),
+    )
+    .await?;
+    let warmup = timeout(WAIT, websocket.wait_for_request(0, 0))
+        .await?
+        .body_json();
+    assert_eq!(warmup["generate"], false);
+    assert_eq!(warmup["reasoning"]["effort"], "medium");
+
+    let turn = f.start().await?;
+    let (mut stream, mut cp) = checkpoint(&f.listener).await?;
+    let epoch = cp["connectionEpoch"].clone();
+    for (index, (from, to)) in [("medium", "high"), ("high", "xhigh"), ("xhigh", "high")]
+        .into_iter()
+        .enumerate()
+    {
+        let step = index as u64 + 1;
+        assert_step_checkpoint(&cp, &f, &turn, step, from, &epoch);
+        write_frame(&mut stream, &decision(&cp, to)).await?;
+        confirm(&mut stream, &cp, to).await?;
+        assert_effort_notification(&mut f, &turn, step, from, to).await?;
+        if index < 2 {
+            cp = next_checkpoint(&mut stream).await?;
+        }
+    }
+    f.completed(&turn, TurnStatus::Completed).await?;
+    assert!(f.shutdown().await?.is_empty());
+    assert!(
+        f.requests().await?.is_empty(),
+        "WS must not fall back to HTTP"
+    );
+
+    let requests = websocket.single_connection();
+    assert_eq!(requests.len(), 4, "one prewarm and three generations");
+    let bodies = requests[1..]
+        .iter()
+        .map(|request| request.body_json())
+        .collect::<Vec<_>>();
+    let mut effective = warmup["reasoning"]["effort"].clone();
+    for (index, expected) in ["high", "xhigh", "high"].into_iter().enumerate() {
+        let body = &bodies[index];
+        assert_eq!(body["model"], "gpt-6.1-sol");
+        assert_eq!(body["reasoning"]["effort"], "medium");
+        assert_ne!(body["generate"], false);
+        if index > 0 {
+            assert_eq!(
+                body["previous_response_id"],
+                ["high-first", "xhigh"][index - 1]
+            );
+        }
+        let updates = configuration_efforts(body);
+        assert_eq!(updates, vec![json!(expected)]);
+        // Delta requests inherit the preceding response's accepted configuration.
+        for update in updates {
+            effective = update;
+        }
+        assert_eq!(effective, expected);
+    }
+    websocket.shutdown().await;
+    Ok(())
+}
+
+#[tokio::test]
+async fn ares_rpc_supported_manual_effort_preserves_effective_user_setting() -> Result<()> {
+    let provider = create_mock_responses_server_sequence(vec![
+        responses::sse(assistant_step("before-manual", false)),
+        responses::sse(assistant_step("after-manual", true)),
+    ])
+    .await;
+    let mut f = Fixture::with_provider(
+        "Sol 6.1-Ares",
+        "gpt-6.1-sol",
+        provider,
+        ProviderMode::SupportedHttp,
+    )
+    .await?;
+    let turn = f.start().await?;
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    let epoch = cp["connectionEpoch"].clone();
+    assert_step_checkpoint(&cp, &f, &turn, 1, "medium", &epoch);
+    write_frame(&mut stream, &decision(&cp, "high")).await?;
+    confirm(&mut stream, &cp, "high").await?;
+    assert_effort_notification(&mut f, &turn, 1, "medium", "high").await?;
+    let pending = next_checkpoint(&mut stream).await?;
+    assert_step_checkpoint(&pending, &f, &turn, 2, "high", &epoch);
+    let response: TurnSettingsUpdateResponse = f
+        .app
+        .request(|request_id| ClientRequest::TurnSettingsUpdate {
+            request_id,
+            params: TurnSettingsUpdateParams {
+                thread_id: f.thread.clone(),
+                turn_id: turn.clone(),
+                effort: Some(ReasoningEffort::Medium),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(response.status, TurnSettingsUpdateStatus::Applied);
+    write_frame(&mut stream, &decision(&pending, "xhigh")).await?;
+    f.completed(&turn, TurnStatus::Completed).await?;
+    assert!(
+        f.shutdown().await?.is_empty(),
+        "late bridge decision must not publish another effort notification"
+    );
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 2);
+    for request in &requests {
+        assert_eq!(request["model"], "gpt-6.1-sol");
+        assert_eq!(request["reasoning"]["effort"], "high");
+    }
+    assert_eq!(configuration_efforts(&requests[0]), vec![json!("high")]);
+    assert_eq!(
+        configuration_efforts(&requests[1]),
+        vec![json!("high"), json!("medium")]
+    );
+    assert_eq!(
+        configuration_efforts(&requests[1]).last(),
+        Some(&json!("medium")),
+        "effective effort follows the user despite the pinned High baseline"
+    );
+    Ok(())
+}
