+    );
+    assert_eq!(human.original_prompt, "original human task");
+    assert_eq!(human.latest_prompt, "current human correction");
+    assert_eq!(human.original_task_source, "native_user_input");
+    assert_eq!(human.admitted_input.source, "user_text");
+    let goal = "<codex_internal_context source=\"goal\">current objective</codex_internal_context>";
+    let pending = serde_json::from_value::<TurnInput>(serde_json::json!({
+        "ResponseItem": {"type":"message","role":"user","content":[{"type":"input_text","text":goal}]}
+    })).unwrap();
+    let mut controller = StepController::new(&turn, &[]);
+    controller.luna_continuous_mode = true;
+    controller.record_initial_turn_input(&[pending], &turn.sub_id);
+    controller.record_initial_turn_input(
