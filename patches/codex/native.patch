+#[tokio::test]
+async fn authoritative_catalog_resolves_known_aliases_to_each_exact_base_model() {
+    let models = ["gpt-6-astra", "gpt-6-sol", "gpt-6.1-sol", "gpt-6-luna"]
+        .into_iter()
+        .map(|slug| {
+            let mut model = remote_model(slug, &format!("Provider {slug}"), /*priority*/ 0);
+            model.use_responses_lite = true;
+            model.supports_image_detail_original = true;
+            model
+        })
+        .collect::<Vec<_>>();
+    let endpoint = TestModelsEndpoint::with_command_auth(vec![Ok(models.clone())]);
+    let manager = OpenAiModelsManager::new_without_cache(endpoint, /*auth_manager*/ None)
+        .with_provider_catalog();
+    assert_eq!(
+        manager
+            .raw_model_catalog(RefreshStrategy::Online, DEFAULT_HTTP_CLIENT_FACTORY)
+            .await
+            .models,
+        models
+    );
+    let config = ModelsManagerConfig {
+        model_context_window: Some(123_000),
+        ..Default::default()
+    };
+
+    for (alias, base_model) in [
+        ("Astra-Jev", "gpt-6-astra"),
+        ("Sol-Jev", "gpt-6-sol"),
+        ("Sol 6.1-Ares", "gpt-6.1-sol"),
+        ("Sol61-Ares", "gpt-6.1-sol"),
+        ("Astra-Jev-Main", "gpt-6-astra"),
+        ("Sol-Jev-Main", "gpt-6-sol"),
+        ("Luna-Jev", "gpt-6-luna"),
+    ] {
+        let expected = manager.get_model_info(base_model, &config).await;
+        assert_eq!(expected.slug, base_model);
+        assert_eq!(expected.display_name, format!("Provider {base_model}"));
+        assert_eq!(expected.context_window, Some(123_000));
+        assert!(!expected.used_fallback_model_metadata);
+        assert_eq!(manager.get_model_info(alias, &config).await, expected);
+    }
+
+    let luna = models
+        .into_iter()
+        .find(|model| model.slug == "gpt-6-luna")
+        .expect("provider Luna model");
+    assert_eq!(
+        manager
+            .get_model_info("gpt-6-luna", &ModelsManagerConfig::default())
+            .await,
+        luna
+    );
+}
