+        json!(sqlite.path().join("logs_2.sqlite"))
+    );
+    let expected = roots.to_string();
+    let accepted = codex_command(home.path())?
+        .env("CODEX_SQLITE_HOME", sqlite.path())
+        .env("CODEX_ARES_EXPECTED_STORAGE_ROOTS", &expected)
+        .args([
+            "app-server",
+            "--print-startup-config",
+            "--include-storage-roots",
+        ])
+        .output()?;
+    assert!(accepted.status.success());
+    let other = TempDir::new()?;
