+use super::ClientRequestResult;
+use super::ConnectionId;
+use super::OutgoingEnvelope;
+use super::OutgoingMessage;
+use super::OutgoingMessageSender;
+use super::PENDING_SERVER_REQUESTS;
+use super::PendingCallbackEntry;
+use super::now_unix_timestamp_ms;
+
+pub(crate) struct PendingClockRequest {
+    id: RequestId,
+    outgoing: Arc<OutgoingMessageSender>,
+    runtime: Handle,
+    pub(crate) response: oneshot::Receiver<ClientRequestResult>,
+}
+
+impl Drop for PendingClockRequest {
+    fn drop(&mut self) {
+        if let Ok(mut callbacks) = self.outgoing.request_id_to_callback.try_lock() {
+            if callbacks.remove(&self.id).is_some() {
+                self.outgoing
+                    .analytics_events_client
+                    .track_server_request_aborted(now_unix_timestamp_ms(), self.id.clone());
+            }
+        } else {
+            // Drop cannot extend the deadline or hold up turn cancellation.
+            let outgoing = self.outgoing.clone();
+            let id = self.id.clone();
+            self.runtime.spawn(async move {
+                outgoing.cancel_request(&id).await;
+                tracing::debug!(request_id = ?id, "current-time callback cleanup completed");
+            });
+        }
+    }
+}
+
+impl OutgoingMessageSender {
+    pub(crate) async fn send_current_time_request(
+        self: &Arc<Self>,
+        connection_id: ConnectionId,
+        thread_id: ThreadId,
+        deadline: Instant,
+    ) -> Result<PendingClockRequest> {
+        ensure!(
+            Instant::now() < deadline,
+            "current-time send deadline expired"
+        );
+        // Reserve before registration so cancellation behind a full queue
+        // cannot orphan a callback.
+        let permit = timeout_at(deadline, self.sender.reserve())
+            .await
+            .context("current-time request timed out waiting for the outgoing queue")?
+            .context("current-time outgoing queue is closed")?;
+        let mut callbacks = timeout_at(deadline, self.request_id_to_callback.lock())
+            .await
+            .context("current-time request timed out waiting for callback registration")?;
+        ensure!(
+            Instant::now() < deadline,
+            "current-time send deadline expired"
+        );
+        let id = self.next_request_id();
+        let request = ServerRequestPayload::CurrentTimeRead(CurrentTimeReadParams {
+            thread_id: thread_id.to_string(),
+        })
+        .request_with_id(id.clone());
+        let (callback, response) = oneshot::channel();
+        let pending = PendingClockRequest {
+            id: id.clone(),
+            outgoing: self.clone(),
+            runtime: Handle::current(),
+            response,
+        };
+        callbacks.insert(
+            id,
+            PendingCallbackEntry {
+                verification_owner: None,
+                verification_auth_revision: None,
+                verification_identity: None,
+                callback,
+                thread_id: None,
+                request: request.clone(),
+                _diagnostics_guard: PENDING_SERVER_REQUESTS.track(),
+            },
+        );
+        drop(callbacks);
+        // No await separates registration, enqueue and returning its owner.
+        permit.send(OutgoingEnvelope::ToConnection {
+            connection_id,
+            message: OutgoingMessage::Request(request.clone()),
+            write_complete_tx: None,
+        });
+        self.analytics_events_client
+            .track_server_request(connection_id.0, request);
+        Ok(pending)
+    }
+}
