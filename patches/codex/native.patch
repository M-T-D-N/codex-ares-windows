+fn composer_prediction_classification_uses_only_native_source_and_trigger() {
+    let temp = TempDir::new().unwrap();
+    let cases = [
+        (
+            Some(ThreadSource::Feature("composer_predictions".into())),
+            None,
+            true,
+        ),
+        (
+            Some(ThreadSource::Feature("composer_predictions".into())),
+            Some("user"),
+            true,
+        ),
+        (Some(ThreadSource::User), Some("composer_predictions"), true),
+        (None, Some("composer_predictions"), true),
+        (Some(ThreadSource::User), Some("user"), false),
+        (Some(ThreadSource::User), Some("goal"), false),
+        (
+            Some(ThreadSource::Feature("other_feature".into())),
+            None,
+            false,
+        ),
+        (None, None, false),
+    ];
+    for (source, trigger, expected) in cases {
+        let state = TurnMetadataState::new(
+            "session".into(),
+            "thread".into(),
+            None,
+            None,
+            &SessionSource::VSCode,
