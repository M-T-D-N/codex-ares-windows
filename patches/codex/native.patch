+pub fn ares_selection(selection: &str) -> Option<AresSelection> {
+    // Preserve saved selections while exposing a readable ID to Desktop onboarding.
+    let selection = match selection {
+        "Sol61-Ares" => "Sol 6.1-Ares",
+        other => other,
+    };
