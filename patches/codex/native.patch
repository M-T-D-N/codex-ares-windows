--- a/codex-rs/windows-sandbox-rs/src/setup_mutex.rs
+++ b/codex-rs/windows-sandbox-rs/src/setup_mutex.rs
@@ -81,3 +81,32 @@ pub fn acquire_sandbox_setup_lock(timeout_ms: u32) -> Result<SandboxSetupLock> {
         _ => Err(io::Error::last_os_error()).context("wait for sandbox setup mutex"),
     }
 }
+
+/// Legacy owner-side bin maintenance uses the same name and original DACL.
+/// CreateMutex requests ALL_ACCESS when that object already exists; an
+/// unelevated caller may therefore receive AccessDenied while another setup
+/// owns the object, even though it can create it once all handles close.
+/// Wait only for that normal lifecycle, with a finite shared deadline. Never
+/// alter/open with weaker security, close another handle, or bypass the lock.
+pub(crate) fn acquire_legacy_bin_setup_lock(timeout_ms: u32) -> Result<SandboxSetupLock> {
+    let timeout = std::time::Duration::from_millis(u64::from(timeout_ms));
+    let started = std::time::Instant::now();
+    loop {
+        let remaining = timeout.saturating_sub(started.elapsed());
+        match acquire_sandbox_setup_lock(remaining.as_millis() as u32) {
+            Ok(guard) => return Ok(guard),
+            Err(error)
+                if error.downcast_ref::<io::Error>().is_some_and(|error| {
+                    error.raw_os_error()
+                        == Some(windows_sys::Win32::Foundation::ERROR_ACCESS_DENIED as i32)
+                }) && started.elapsed() < timeout =>
+            {
+                std::thread::sleep(
+                    std::time::Duration::from_millis(10)
+                        .min(timeout.saturating_sub(started.elapsed())),
+                );
+            }
+            Err(error) => return Err(error),
+        }
+    }
+}
