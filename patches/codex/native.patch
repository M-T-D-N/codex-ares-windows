+        &input,
+        Some("prior-response"),
+        "responses_websocket",
+    );
+    second.emit(json!({"type":"websocket_send_completed","localSendSucceeded":true}));
+    second.terminal(json!({"type":"response_completed","responseId":"response-2"}));
+    second.terminal(json!({"type":"response_failed"}));
