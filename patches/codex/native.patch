+async fn pilot_http_dispatch(
+    client: &ModelClient,
+    generation: Arc<crate::pilot_trace::PilotGeneration>,
+) -> codex_protocol::error::Result<super::ResponseStream> {
+    let metadata = test_responses_metadata_for_client(
+        client,
+        None,
+        "window".into(),
+        None,
+        TestCodexResponsesRequestKind::Turn,
+    );
+    super::ResponsesHttpExecutor::new(client)
+        .with_pilot_generation(Some(generation))
+        .stream_responses_http(
+            &Arc::new(std::sync::OnceLock::new()),
+            None,
+            None,
+            &Prompt::default(),
+            &test_model_info(),
+            &test_session_telemetry(),
+            None,
+            codex_protocol::config_types::ReasoningSummary::None,
+            None,
+            &metadata,
+            &InferenceTraceContext::disabled(),
+        )
+        .await
+}
