+        Err(err) => {
+            error!("request failed: {err:?}");
+            ReviewDecision::denied("approval request failed")
+        }
+    };
+
+    if let Err(err) = codex
+        .submit(Op::PatchApproval {
+            id: item_id,
+            decision,
