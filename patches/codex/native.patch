+#[tokio::test(flavor = "current_thread")]
+async fn pilot_mapper_cancel_ready_precedes_ready_completion() -> anyhow::Result<()> {
+    let dir = TempDir::new()?;
+    let path = dir.path().join("pilot.jsonl");
+    let generation = crate::pilot_trace::PilotGeneration::for_test(path.clone());
+    let pilot = generation.request("gpt-test", None, &[], None, "responses_http");
+    let completion_polls = Arc::new(AtomicUsize::new(0));
+    let observed_polls = Arc::clone(&completion_polls);
+    let (source_lifetime, source_dropped) = tokio::sync::oneshot::channel::<()>();
+    let api_stream = futures::stream::iter([Ok(ResponseEvent::Completed {
+        response_id: "ready-completion".into(),
+        token_usage: None,
+        usage_metadata: None,
+        end_turn: None,
+    })])
+    .map(move |event| {
+        // Retain the sender until the mapper drops its source, even when never polled.
+        let _ = &source_lifetime;
+        observed_polls.fetch_add(1, Ordering::SeqCst);
+        event
+    });
+    let (stream, _) = super::map_response_events(
+        None,
+        api_stream,
+        test_session_telemetry(),
+        InferenceTraceAttempt::disabled(),
+        test_model_provider(),
+        Some(pilot),
+    );
+    // No await has allowed the spawned mapper to run on this current-thread runtime.
+    // Completed is already ready; dropping the consumer makes cancellation ready too.
+    drop(stream);
+    tokio::time::timeout(Duration::from_secs(5), source_dropped)
+        .await?
+        .expect_err("source lifetime sender is dropped without sending");
+    assert_eq!(completion_polls.load(Ordering::SeqCst), 0);
+    assert_one_pilot_http_terminal(&path, "response_cancelled", Some("cancelled"), None);
+    Ok(())
+}
