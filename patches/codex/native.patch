+//! Synthetic stdio RPC -> native controller -> loopback HTTP coverage; no live provider.
+use anyhow::Result;
+use app_test_support::{
+    MockResponsesConfig, TestAppServer, create_mock_responses_server_repeating_assistant,
+    write_models_cache_with_models,
+};
+use codex_app_server_protocol::{
+    ClientRequest, JSONRPCMessage, ReasoningEffortUpdatedNotification, ThreadStartParams,
+    TurnCompletedNotification, TurnInterruptParams, TurnSettingsUpdateParams,
+    TurnSettingsUpdateResponse, TurnSettingsUpdateStatus, TurnStartParams, TurnStartResponse,
+    TurnStatus, UserInput,
+};
+use codex_features::Feature;
+use codex_models_manager::model_info::model_info_from_slug;
+use codex_protocol::openai_models::{ReasoningEffort, ReasoningEffortPreset};
+use serde_json::{Value, json};
+use std::time::Duration;
+use tempfile::TempDir;
+use test_case::test_case;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use tokio::net::{TcpListener, TcpStream};
+use tokio::time::timeout;
+use wiremock::MockServer;
+
+const WAIT: Duration = Duration::from_secs(30);
+const TOKEN: &str = "synthetic-ares-rpc-token-not-an-authentication-credential";
+const METHOD: &str = "turn/reasoningEffort/updated";
+
+async fn read_frame(stream: &mut TcpStream) -> Result<Value> {
+    let size = timeout(WAIT, stream.read_u32()).await?? as usize;
+    anyhow::ensure!(size <= 1024 * 1024, "oversized synthetic frame");
+    let mut bytes = vec![0; size];
+    timeout(WAIT, stream.read_exact(&mut bytes)).await??;
+    Ok(serde_json::from_slice(&bytes)?)
+}
+async fn write_frame(stream: &mut TcpStream, value: &Value) -> Result<()> {
+    let bytes = serde_json::to_vec(value)?;
+    timeout(WAIT, stream.write_u32(bytes.len() as u32)).await??;
+    timeout(WAIT, stream.write_all(&bytes)).await??;
+    Ok(())
+}
+async fn checkpoint(listener: &TcpListener) -> Result<(TcpStream, Value)> {
+    let (mut stream, _) = timeout(WAIT, listener.accept()).await??;
+    assert_eq!(
+        read_frame(&mut stream).await?,
+        json!({"type":"authenticate","token":TOKEN})
+    );
+    write_frame(&mut stream, &json!({"type":"authenticated"})).await?;
+    let value = read_frame(&mut stream).await?;
+    assert_eq!(value["type"], "checkpoint");
+    assert_eq!(value["protocol"], 4);
+    Ok((stream, value))
+}
+fn decision(cp: &Value, effort: &str) -> Value {
+    json!({"protocol":4,"type":"decision","threadId":cp["threadId"],"turnId":cp["turnId"],
+        "step":cp["step"],"connectionEpoch":cp["connectionEpoch"],"effort":effort,
+        "leaseSteps":1,"evaluatorMs":3})
+}
+async fn confirm(stream: &mut TcpStream, cp: &Value, effort: &str) -> Result<()> {
+    let applied = read_frame(stream).await?;
+    assert_eq!(applied["type"], "applied");
+    assert_eq!(applied["threadId"], cp["threadId"]);
+    assert_eq!(applied["turnId"], cp["turnId"]);
+    assert_eq!(applied["connectionEpoch"], cp["connectionEpoch"]);
+    assert_eq!(applied["effort"], effort);
+    assert_eq!(applied["confirmation"], "native_step_context_captured");
+    write_frame(
+        stream,
+        &json!({"protocol":4,"type":"recorded","threadId":cp["threadId"],
+        "turnId":cp["turnId"],"step":cp["step"],"connectionEpoch":cp["connectionEpoch"]}),
+    )
+    .await
+}
+struct Fixture {
+    app: TestAppServer,
+    _home: TempDir,
+    provider: MockServer,
+    listener: TcpListener,
+    thread: String,
+}
+impl Fixture {
+    async fn new(alias: &str, base: &str) -> Result<Self> {
+        let provider =
+            create_mock_responses_server_repeating_assistant("Synthetic RPC complete").await;
+        let home = TempDir::new()?;
+        MockResponsesConfig::new(&provider.uri())
+            .with_model(alias)
+            .with_root_config("model_reasoning_effort = \"medium\"")
+            .enable_feature(Feature::StepModelSwitching)
+            .enable_feature(Feature::ReasoningEffortOverride)
+            .write(home.path())?;
+        let mut model = model_info_from_slug(base);
+        model.used_fallback_model_metadata = false;
+        model.use_responses_lite = true;
+        model.context_window = Some(272_000);
+        model.effective_context_window_percent = 95;
+        model.supported_reasoning_levels = [
+            ReasoningEffort::Medium,
+            ReasoningEffort::High,
+            ReasoningEffort::XHigh,
+            ReasoningEffort::Max,
+        ]
+        .into_iter()
+        .map(|effort| ReasoningEffortPreset {
+            effort,
+            description: "Synthetic supported effort".to_string(),
+        })
+        .collect();
+        write_models_cache_with_models(home.path(), vec![model]).await?;
+        let listener = TcpListener::bind("127.0.0.1:0").await?;
+        let address = listener.local_addr()?.to_string();
+        let mut app = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .with_env_overrides(&[
+                (
+                    "CODEX_STEP_CONTROLLER_ADVICE_MODE",
+                    Some("luna-continuous-1"),
+                ),
+                ("CODEX_STEP_CONTROLLER_TCP", Some(&address)),
+                ("CODEX_STEP_CONTROLLER_TOKEN", Some(TOKEN)),
+            ])
+            .build_initialized()
+            .await?;
+        let started = app
+            .start_thread(ThreadStartParams {
+                model: Some(alias.to_string()),
+                ..Default::default()
+            })
+            .await?;
+        assert_eq!(started.model, alias);
+        assert_eq!(started.model_context_window, Some(258_400));
+        Ok(Self {
+            app,
+            _home: home,
+            provider,
+            listener,
+            thread: started.thread.id,
+        })
+    }
+    async fn start(&mut self) -> Result<String> {
+        let response: TurnStartResponse = self
+            .app
+            .request(|request_id| ClientRequest::TurnStart {
+                request_id,
+                params: TurnStartParams {
+                    thread_id: self.thread.clone(),
+                    input: vec![UserInput::Text {
+                        text: "Reply with one short synthetic answer.".to_string(),
+                        text_elements: vec![],
+                    }],
+                    ..Default::default()
+                },
+            })
+            .await?;
+        Ok(response.turn.id)
+    }
+    async fn completed(&mut self, turn: &str, status: TurnStatus) -> Result<()> {
+        let event: TurnCompletedNotification =
+            timeout(WAIT, self.app.read_notification("turn/completed")).await??;
+        assert_eq!(event.thread_id, self.thread);
+        assert_eq!(event.turn.id, turn);
+        assert_eq!(event.turn.status, status);
+        Ok(())
+    }
+    async fn requests(&self) -> Result<Vec<Value>> {
+        self.provider
+            .received_requests()
+            .await
+            .unwrap_or_default()
+            .iter()
+            .filter(|r| r.url.path().ends_with("/responses"))
+            .map(|r| Ok(r.body_json()?))
+            .collect()
+    }
+    async fn shutdown(&mut self) -> Result<Vec<ReasoningEffortUpdatedNotification>> {
+        let (status, messages) = timeout(WAIT, self.app.shutdown_collect_messages()).await??;
+        assert!(status.success());
+        messages
+            .into_iter()
+            .filter_map(|message| match message {
+                JSONRPCMessage::Notification(event) if event.method == METHOD => Some(event),
+                _ => None,
+            })
+            .map(|event| {
+                Ok(serde_json::from_value(event.params.ok_or_else(|| {
+                    anyhow::anyhow!("missing notification params")
+                })?)?)
+            })
+            .collect()
+    }
+}
+
+#[test_case("Sol 6.1-Ares", "gpt-6.1-sol"; "Sol selected catalog")]
+#[test_case("Astra-Jev", "gpt-6-astra"; "Astra selected catalog")]
+#[tokio::test]
+async fn ares_rpc_model_selection_and_effort_notification(alias: &str, base: &str) -> Result<()> {
+    let mut f = Fixture::new(alias, base).await?;
+    let turn = f.start().await?;
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    assert_eq!(cp["threadId"], f.thread);
+    assert_eq!(cp["turnId"], turn);
+    assert_eq!(cp["model"], base);
+    assert_eq!(cp["selectionAlias"], alias);
+    write_frame(&mut stream, &decision(&cp, "high")).await?;
+    confirm(&mut stream, &cp, "high").await?;
+    let event: ReasoningEffortUpdatedNotification =
+        timeout(WAIT, f.app.read_notification(METHOD)).await??;
+    assert_eq!(event.thread_id, f.thread);
+    assert_eq!(event.turn_id, turn);
+    assert_eq!(event.from_effort.as_deref(), Some("medium"));
+    assert_eq!(event.to_effort, "high");
+    assert_eq!(event.step, cp["step"].as_u64().unwrap());
+    f.completed(&turn, TurnStatus::Completed).await?;
+    let remaining = f.shutdown().await?;
+    assert!(
+        remaining.is_empty(),
+        "unexpected late effort notification: {remaining:?}"
+    );
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0]["model"], base);
+    assert_eq!(requests[0]["reasoning"]["effort"], "high");
+    Ok(())
+}
+
+#[tokio::test]
+async fn ares_rpc_manual_effort_rejects_late_bridge_decision() -> Result<()> {
+    let mut f = Fixture::new("Sol 6.1-Ares", "gpt-6.1-sol").await?;
+    let turn = f.start().await?;
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    let response: TurnSettingsUpdateResponse = f
+        .app
+        .request(|request_id| ClientRequest::TurnSettingsUpdate {
+            request_id,
+            params: TurnSettingsUpdateParams {
+                thread_id: f.thread.clone(),
+                turn_id: turn.clone(),
+                effort: Some(ReasoningEffort::High),
+                ..Default::default()
+            },
+        })
+        .await?;
+    assert_eq!(response.status, TurnSettingsUpdateStatus::Applied);
+    write_frame(&mut stream, &decision(&cp, "max")).await?;
+    // Guard rejection preserves the user's current High; no stale Max publication.
+    f.completed(&turn, TurnStatus::Completed).await?;
+    let remaining = f.shutdown().await?;
+    assert!(
+        remaining.is_empty(),
+        "unexpected late effort notification: {remaining:?}"
+    );
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0]["reasoning"]["effort"], "high");
+    Ok(())
+}
