+    ] {
+        for (source, trigger) in [
+            (
+                Some(ThreadSource::Feature("composer_predictions".into())),
+                None,
+            ),
+            (Some(ThreadSource::User), Some("composer_predictions")),
+        ] {
+            let (session, turn, mut controller) =
+                luna_fixture_with_model_and_source(alias, base_model, source).await;
+            if let Some(trigger) = trigger {
+                turn.turn_metadata_state.set_turn_trigger(trigger.into());
+            }
+            assert!(turn.turn_metadata_state.is_composer_prediction());
+            let initial = turn.next_step_settings.load_full();
+            let mut server = attached_bridge(&mut controller).await;
+            let bridge = tokio::spawn(async move {
+                // The exclusion drops the connection before sending even the frame header.
+                let read = tokio::time::timeout(Duration::from_secs(2), server.read_u32())
+                    .await
+                    .expect("native connection closed");
+                assert!(
+                    read.is_err(),
+                    "internal prediction allocated evaluator work"
+                );
+            });
+            assert!(
+                controller
+                    .before_sampling_luna(&session, &turn)
+                    .await
+                    .unwrap()
+                    .is_none()
+            );
+            bridge.await.unwrap();
+            assert!(controller.connection.is_none());
+            assert_eq!(controller.sequence, 0);
+            assert!(!controller.take_capture_fresh());
+            assert!(Arc::ptr_eq(&initial, &turn.next_step_settings.load_full()));
+            assert_eq!(turn.next_step_settings.load().model_info.slug, base_model);
