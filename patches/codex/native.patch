+#[tokio::test]
+async fn jev_main_request_discarded_after_compaction_window_change() {
+    let (session, turn, mut controller) = jev_main_fixture().await;
+    session
+        .queue_jev_main_effort(
+            &turn,
+            ReasoningEffort::Max,
+            "Check window".to_string(),
+            "stale-window".to_string(),
+        )
+        .await
+        .expect("queue");
+    let old_window = session
+        .state
+        .lock()
+        .await
+        .auto_compact_window_ids()
+        .window_id;
+    let (_, new_window_ids) = session.advance_auto_compact_window().await;
+    assert_ne!(old_window, new_window_ids.window_id);
+    let mut server = attached_bridge(&mut controller).await;
+    let bridge = tokio::spawn(async move {
+        let checkpoint = read_bridge_frame(&mut server).await;
+        assert_eq!(checkpoint["type"], "checkpoint");
+        assert_eq!(
+            checkpoint["adviceBasis"]["windowId"],
+            new_window_ids.window_id.to_string()
+        );
+        write_bridge_frame(
+            &mut server,
+            decision_for(&checkpoint, ReasoningEffort::Medium),
+        )
+        .await;
+    });
+    let fresh = controller
+        .before_sampling_luna(&session, &turn)
+        .await
+        .expect("new window invalidates queue")
+        .expect("fresh evaluator decision");
+    assert!(fresh.from_bridge);
+    assert_eq!(fresh.effort, ReasoningEffort::Medium);
+    bridge.await.expect("bridge exchange");
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
