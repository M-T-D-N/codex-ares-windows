+        Some(ReasoningEffort::Medium),
+        codex_protocol::config_types::ReasoningSummary::None,
+        None,
+        &metadata,
+        true,
+    )?;
+    assert_eq!(client.state.reasoning_effort_override_enabled, enabled);
+    assert_eq!(model.supports_reasoning_effort_updates, supported);
+    assert_eq!(
