+        &turn,
+        &[UserInput::Text {
+            text: "original human task".to_owned(),
+            text_elements: vec![],
+        }],
+    );
+    human.luna_continuous_mode = true;
+    // A later accepted host delivery refines latest without replacing the human original.
+    human.record_initial_turn_input(
+        &[host_task_delivery(
+            &turn.sub_id,
+            "codex_app",
+            "send_message_to_thread",
+            "later delivery",
