+#[tokio::test]
+async fn ares_rpc_cancel_rejects_late_reply_and_new_turn_recovers() -> Result<()> {
+    let mut f = Fixture::new("Sol 6.1-Ares", "gpt-6.1-sol").await?;
+    let old = f.start().await?;
+    let (mut old_stream, old_cp) = checkpoint(&f.listener).await?;
+    let id = f
+        .app
+        .send_turn_interrupt_request(TurnInterruptParams {
+            thread_id: f.thread.clone(),
+            turn_id: old.clone(),
+        })
+        .await?;
+    let _: Value = timeout(WAIT, f.app.read_response(id)).await??;
+    f.completed(&old, TurnStatus::Interrupted).await?;
+    // A closed connection is also the correct cancellation result.
+    let _ = write_frame(&mut old_stream, &decision(&old_cp, "max")).await;
+    assert!(f.requests().await?.is_empty());
+    let new = f.start().await?;
+    assert_ne!(new, old);
+    let (mut stream, cp) = checkpoint(&f.listener).await?;
+    assert_eq!(cp["turnId"], new);
+    assert_ne!(cp["connectionEpoch"], old_cp["connectionEpoch"]);
+    write_frame(&mut stream, &decision(&cp, "high")).await?;
+    confirm(&mut stream, &cp, "high").await?;
+    let event: ReasoningEffortUpdatedNotification =
+        timeout(WAIT, f.app.read_notification(METHOD)).await??;
+    assert_eq!(event.turn_id, new);
+    assert_eq!(event.to_effort, "high");
+    f.completed(&new, TurnStatus::Completed).await?;
+    let remaining = f.shutdown().await?;
+    assert!(
+        remaining.is_empty(),
+        "unexpected late effort notification: {remaining:?}"
+    );
+    let requests = f.requests().await?;
+    assert_eq!(requests.len(), 1);
+    assert_eq!(requests[0]["reasoning"]["effort"], "high");
+    Ok(())
+}
